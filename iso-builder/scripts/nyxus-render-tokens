#!/usr/bin/env python3
"""nyxus-render-tokens — Sprint K-E rev r16 (2026-05-14)

Single-source-of-truth renderer for every NYXUS brand value.

Reads `iso-builder/tokens/nyxus.tokens.json` and emits per-consumer
brand files in their native format:

  · Firefox userChrome.css        — :root block of CSS custom properties
  · Chromium initial_preferences  — theme.colors RGB-tuple block (JSON)
  · Web artifact src/index.css    — :root block of HSL component vars
  · (Phase 2 will add: hyprland, hyprlock, dunst, gtk, eww, userContent)

Because most consumers don't read SCSS / a single shared file (Hyprland
uses `.conf` with literal hex; Chromium reads JSON; INIs have no
imports), we use a *renderer*, not an *importer*. This is the same
pattern Style Dictionary, Material Design tokens, and IBM Carbon use.

Two emission mechanisms:
  · text-marker  → replace content between `START <name>` and
                   `END <name>` comment markers (CSS / .conf / SCSS)
  · json-key     → load JSON, set specific keys, write back

Usage:
  nyxus-render-tokens --render        write outputs to disk
  nyxus-render-tokens --check         exit 1 if any output drifted from
                                      the canonical render (CI guard)
  nyxus-render-tokens --list          list all targets and tokens
  nyxus-render-tokens --tokens PATH   override tokens.json path

A target's contract:
  · `path`        — file to rewrite
  · `kind`        — "marker" | "json"
  · `marker`      — for marker kind: name between START/END (e.g. "palette")
  · `comment`     — for marker kind: comment style ("css"|"hash"|"slash")
  · `generator`   — for marker kind: Callable[tokens] -> str
  · `json_path`   — for json kind: dotted path to the key to set
                    (e.g. "browser.theme.colors")
  · `json_value`  — for json kind: Callable[tokens] -> any

Adding a new consumer = ~10 lines: append to TARGETS, add a generator
function, add the marker pair to the consumer file. No other code
changes required.

Exit codes:
  0  — success (rendered, or --check passed with zero drift)
  1  — drift detected in --check, or render failed
  2  — invalid CLI args, missing tokens.json, or marker not found
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from collections import OrderedDict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable, Dict, List, Optional, Tuple

# ── Paths ────────────────────────────────────────────────────────────
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT  = SCRIPT_DIR.parent.parent  # iso-builder/scripts/.. = iso-builder/.. = repo root
DEFAULT_TOKENS = REPO_ROOT / "iso-builder" / "tokens" / "nyxus.tokens.json"

# ── Marker convention ────────────────────────────────────────────────
# Markers are line-anchored. Renderer replaces everything between START
# and END (exclusive of the marker lines themselves) with the generated
# content. The exact marker strings per comment style are:
#
#   css   →  /* NYXUS-TOKENS-START <name> */    /* NYXUS-TOKENS-END <name> */
#   hash  →  # NYXUS-TOKENS-START <name>        # NYXUS-TOKENS-END <name>
#   slash →  // NYXUS-TOKENS-START <name>       // NYXUS-TOKENS-END <name>
#
# Adding a new consumer that uses a new comment syntax = add a tuple
# below. The renderer never guesses comment style from extension —
# always explicit per target.
COMMENT_STYLES: Dict[str, Tuple[str, str]] = {
    "css":   ("/* NYXUS-TOKENS-START {name} */", "/* NYXUS-TOKENS-END {name} */"),
    "hash":  ("# NYXUS-TOKENS-START {name}",      "# NYXUS-TOKENS-END {name}"),
    "slash": ("// NYXUS-TOKENS-START {name}",     "// NYXUS-TOKENS-END {name}"),
}


# ── Format helpers ────────────────────────────────────────────────────

def _hypr_rgba(hex_color: str, alpha_hex: str) -> str:
    """Hyprland's idiosyncratic `rgba(<hex><alphahex>)` format — no '#',
    alpha appended as 2 hex digits. e.g. _hypr_rgba('#b8865a', 'ff')
    → 'rgba(b8865aff)'."""
    return f"rgba({hex_color.lstrip('#')}{alpha_hex})"


def _css_rgba(rgb: list, alpha: float) -> str:
    """Standard CSS rgba(R, G, B, A). Used by hyprlock + GTK surfaces."""
    return f"rgba({rgb[0]}, {rgb[1]}, {rgb[2]}, {alpha})"


# ── Generators (one per consumer block) ──────────────────────────────
# Each generator takes the loaded tokens dict and returns the exact
# string that should sit between the START / END markers. Trailing
# newline is included so the output is line-aligned with the marker
# the renderer leaves on disk. Indentation is part of the contract:
# match the surrounding file.

def gen_firefox_root(t: dict) -> str:
    """:root block for Firefox userChrome.css.

    Defines the seven --nyx-* vars that the rest of userChrome.css
    references via CSS custom properties. Everything else in
    userChrome.css (lwt-* mappings, selectors, etc.) is hand-authored
    and stays OUTSIDE the markers.
    """
    p = t["palette"]
    r = t["radius"]
    return (
        f"  --nyx-bg:        {p['ink_black']['hex']} !important;\n"
        f"  --nyx-bg-alt:    {p['surface_raised']['hex']} !important;\n"
        f"  --nyx-cream:     {p['cream']['hex']} !important;\n"
        f"  --nyx-cream-dim: {p['cream_dim']['hex']} !important;\n"
        f"  --nyx-copper:    {p['copper']['hex']} !important;\n"
        f"  --nyx-hairline:  {p['hairline_rgba']['css']} !important;\n"
        f"  --nyx-glass:     {p['surface_glass_rgba']['css']} !important;\n"
        f"  --nyx-radius:    {r['small']} !important;\n"
    )


def gen_web_artifact_root_hsl(t: dict) -> str:
    """:root block for web artifact src/index.css (palette only).

    Tailwind / shadcn-style HSL-component vars. Per-artifact concerns
    (--app-font-*, --radius which Notepad sets to 0.25rem and Sysmon
    might want crisper) live OUTSIDE the markers in each artifact's
    own :root block, so the palette can be re-rendered without
    stomping artifact-specific tuning.
    """
    p = t["palette"]
    return (
        f"  --background: {p['ink_black']['hsl']};\n"
        f"  --foreground: {p['cream']['hsl']};\n"
        f"  --border: {p['border_hairline_hsl']['hsl']};\n"
        f"  --card: {p['surface_raised']['hsl']};\n"
        f"  --card-foreground: {p['cream']['hsl']};\n"
        f"  --card-border: {p['border_card_hsl']['hsl']};\n"
        f"  --sidebar: {p['surface_raised']['hsl']};\n"
        f"  --sidebar-foreground: {p['cream']['hsl']};\n"
        f"  --sidebar-border: {p['border_card_hsl']['hsl']};\n"
        f"  --sidebar-primary: {p['cream']['hsl']};\n"
        f"  --sidebar-primary-foreground: {p['ink_black']['hsl']};\n"
        f"  --sidebar-accent: {p['copper']['hsl']};\n"
        f"  --sidebar-accent-foreground: {p['ink_black']['hsl']};\n"
        f"  --sidebar-ring: {p['cream']['hsl']};\n"
        f"  --popover: {p['surface_raised']['hsl']};\n"
        f"  --popover-foreground: {p['cream']['hsl']};\n"
        f"  --popover-border: {p['border_card_hsl']['hsl']};\n"
        f"  --primary: {p['cream']['hsl']};\n"
        f"  --primary-foreground: {p['ink_black']['hsl']};\n"
        f"  --secondary: {p['copper']['hsl']};\n"
        f"  --secondary-foreground: {p['ink_black']['hsl']};\n"
        f"  --muted: 0 0% 8%;\n"
        f"  --muted-foreground: {p['cream_mute']['hsl']};\n"
        f"  --accent: {p['copper']['hsl']};\n"
        f"  --accent-foreground: {p['ink_black']['hsl']};\n"
        f"  --destructive: {p['copper']['hsl']};\n"
        f"  --destructive-foreground: {p['ink_black']['hsl']};\n"
        f"  --input: 0 0% 8%;\n"
        f"  --ring: {p['cream']['hsl']};\n"
    )


def gen_hyprland_borders(t: dict) -> str:
    """Hyprland col.active_border + col.inactive_border lines.

    Both use Hyprland's `rgba(<hex><alpha>)` non-standard format. The
    leading 4-space indent matches the surrounding `general {}` block.
    The active border is a 5-stop gradient: copper → cream → copper-deep
    → ink → pure-black so the focused window reads as a warm-metal
    halo. Inactive is a faded 3-stop cream-to-black so unfocused
    windows recede into the wallpaper.
    """
    p = t["palette"]
    return (
        f"    col.active_border   = "
        f"{_hypr_rgba(p['copper']['hex'], 'ff')} "
        f"{_hypr_rgba(p['cream']['hex'], 'ee')} "
        f"{_hypr_rgba(p['copper_deep']['hex'], 'cc')} "
        f"{_hypr_rgba(p['ink_black']['hex'], '99')} "
        f"{_hypr_rgba(p['pure_black']['hex'], 'ff')} 135deg\n"
        f"    col.inactive_border = "
        f"{_hypr_rgba(p['cream_inactive']['hex'], '22')} "
        f"{_hypr_rgba(p['cream_mute']['hex'], '11')} "
        f"{_hypr_rgba(p['pure_black']['hex'], '44')} 135deg\n"
    )


def gen_hyprlock_indicator(t: dict) -> str:
    """Hyprlock PIN-entry indicator outer/inner/font colors."""
    p = t["palette"]
    return (
        f"    outer_color = {_css_rgba(p['copper']['rgb'], 0.55)}\n"
        f"    inner_color = {_css_rgba(p['ink_void']['rgb'], 0.78)}\n"
        f"    font_color  = {_css_rgba(p['cream']['rgb'], 1.0)}\n"
    )


def gen_dunst_critical_frame(t: dict) -> str:
    """dunstrc [urgency_critical] frame_color line.

    Conservative scope: only the brand-distinguishing copper frame is
    rendered. Background/foreground stay as the user's existing
    high-legibility tuning (#0a0a0a / #fff8e0) — those slightly-off
    variants exist for notification readability and aren't a brand-
    drift concern. Adding them later is a one-line addition.
    """
    return f"    frame_color   = \"{t['palette']['copper']['hex']}\"\n"


def gen_gtk_accent_block(t: dict) -> str:
    """NYXUS-Dark gtk-4.0/gtk.css top @define-color block.

    These are libadwaita's named accent slots — every Adwaita-aware app
    (Files, Calendar, Calculator, etc.) reads these names. Binding them
    to the rev r16 palette guarantees the entire GTK4 ecosystem
    inherits the brand without per-app theming.
    """
    p = t["palette"]
    cream    = p['cream']['hex']
    ink_void = p['ink_void']['hex']
    return (
        f"@define-color accent_color           {cream};\n"
        f"@define-color accent_bg_color        {cream};\n"
        f"@define-color accent_fg_color        {ink_void};\n"
        f"/* Sprint K-A rev r16: accent_blue is the libadwaita \"alternative accent\"\n"
        f"   slot used by some apps for secondary highlights — bind it to copper\n"
        f"   so those surfaces pick up the second accent without further work. */\n"
        f"@define-color accent_blue            {p['copper']['hex']};\n"
        f"@define-color nyxus_copper           {p['copper']['hex']};\n"
        f"\n"
        f"@define-color window_bg_color        {ink_void};\n"
        f"@define-color window_fg_color        {cream};\n"
        f"@define-color view_bg_color          {ink_void};\n"
        f"@define-color view_fg_color          {cream};\n"
        f"@define-color headerbar_bg_color     {p['ink_black']['hex']};\n"
        f"@define-color headerbar_fg_color     {cream};\n"
        f"@define-color headerbar_border_color alpha({cream}, 0.10);\n"
        f"@define-color card_bg_color          {p['ink_black']['hex']};\n"
        f"@define-color card_fg_color          {cream};\n"
        f"@define-color popover_bg_color       alpha({ink_void}, 0.92);\n"
        f"@define-color popover_fg_color       {cream};\n"
    )


def gen_firefox_userContent_palette(t: dict) -> str:
    """userContent.css `:root` block — defines --nyx-* vars for Firefox's
    own chrome-rendered pages (about:newtab, about:preferences, etc.).

    Wrapped in an @-moz-document covering all chrome URL patterns at
    the top of userContent.css; the 3 existing scoped blocks below
    consume these via var() refs. CSS custom properties cascade into
    nested :root selectors of the same document, so this single wrapper
    feeds every NYXUS-skinned chrome surface without polluting web
    content.
    """
    p = t["palette"]
    cream = p['cream']
    return (
        f"  :root {{\n"
        f"    --nyx-bg:        {p['ink_black']['hex']};\n"
        f"    --nyx-bg-raised: {p['surface_raised']['hex']};\n"
        f"    --nyx-cream:     {cream['hex']};\n"
        f"    --nyx-cream-dim: {p['cream_dim']['hex']};\n"
        f"    --nyx-copper:    {p['copper']['hex']};\n"
        f"    --nyx-hairline:  rgba({cream['rgb'][0]}, {cream['rgb'][1]}, {cream['rgb'][2]}, 0.10);\n"
        f"  }}\n"
    )


def gen_eww_accent(t: dict) -> str:
    """Build-time default for eww's _nyxus_accent.scss partial.

    Overridden at runtime by /usr/local/bin/nyxus-apply-accent when the
    user picks an accent preset. This default is what eww sees on
    first boot before the user has chosen anything — the canonical
    rev r16 copper-on-cream pairing.
    """
    p = t["palette"]
    return (
        f"$nyxus-accent-primary:   {p['copper']['hex']};\n"
        f"$nyxus-accent-secondary: {p['cream']['hex']};\n"
        f"$nyxus-accent-warn:      {p['cream_dim']['hex']};\n"
        f"$nyxus-accent-ok:        {p['copper']['hex']};\n"
    )


# ── JSON-key emitters ────────────────────────────────────────────────

def gen_chromium_theme_colors(t: dict) -> dict:
    """Chromium initial_preferences `browser.theme.colors` block.

    Chromium expects [R, G, B] integer arrays. The first-profile bring-up
    populates these into the user's Preferences file, after which the
    user's chosen Chromium theme can override — but a freshly-spawned
    profile sees the NYXUS palette out of the box.
    """
    p = t["palette"]
    return OrderedDict([
        ("frame",               p["ink_black"]["rgb"]),
        ("frame_inactive",      p["ink_black"]["rgb"]),
        ("frame_incognito",     p["ink_black"]["rgb"]),
        ("toolbar",             p["ink_black"]["rgb"]),
        ("tab_text",            p["cream"]["rgb"]),
        ("tab_background_text", p["cream_dim"]["rgb"]),
        ("bookmark_text",       p["cream"]["rgb"]),
        ("ntp_background",      p["ink_black"]["rgb"]),
        ("ntp_text",            p["cream"]["rgb"]),
        ("ntp_link",            p["copper"]["rgb"]),
        ("control_background",  p["surface_raised"]["rgb"]),
        ("button_background",   p["copper"]["rgb"]),
        ("omnibox_background",  p["surface_raised"]["rgb"]),
        ("omnibox_text",        p["cream"]["rgb"]),
    ])


def gen_chromium_brand_palette_doc(t: dict) -> dict:
    """Self-documenting hex reference shipped alongside theme.colors.

    Chromium itself ignores unknown top-level keys, so this is a pure
    documentation block. It also satisfies the §15ai(e) palette-presence
    guard which greps every browser file for the cream + copper hex
    literals — without this, the file carries the palette only as RGB
    tuples and the guard can't see it.
    """
    p = t["palette"]
    return OrderedDict([
        ("_note",            "auto-rendered by nyxus-render-tokens — DO NOT HAND-EDIT. "
                              "Edit iso-builder/tokens/nyxus.tokens.json then `nyxus-render-tokens --render`."),
        ("brand_revision",   t.get("$brand_revision", "")),
        ("ink_black",        p["ink_black"]["hex"]),
        ("surface_raised",   p["surface_raised"]["hex"]),
        ("cream",            p["cream"]["hex"]),
        ("cream_dim",        p["cream_dim"]["hex"]),
        ("copper",           p["copper"]["hex"]),
    ])


# ── Target table ─────────────────────────────────────────────────────

@dataclass
class Target:
    path: Path
    kind: str                        # "marker" | "json"
    description: str
    # marker mode:
    marker:    str              = ""
    comment:   str              = "css"
    generator: Optional[Callable[[dict], str]] = None
    # json mode:
    json_path:    Tuple[str, ...]                = ()
    json_value:   Optional[Callable[[dict], Any]] = None
    json_indent:  int                            = 2


def _build_targets(tokens_path: Path) -> List[Target]:
    """All consumer files the renderer owns. Phase 1 = 3 targets;
    Phase 2 will expand to the full ~12 consumers without changing
    the renderer engine.
    """
    A = REPO_ROOT / "iso-builder" / "nyx-profile" / "airootfs"
    W = REPO_ROOT / "artifacts"

    return [
        Target(
            path=A / "etc/skel/.mozilla/firefox/nyxus.default/chrome/userChrome.css",
            kind="marker",
            description="Firefox userChrome.css :root palette block",
            marker="palette", comment="css", generator=gen_firefox_root,
        ),
        Target(
            path=A / "etc/skel/.mozilla/firefox/nyxus.default/chrome/userContent.css",
            kind="marker",
            description="Firefox userContent.css chrome-pages :root vars",
            marker="palette", comment="css", generator=gen_firefox_userContent_palette,
        ),
        Target(
            path=A / "etc/chromium/initial_preferences",
            kind="json",
            description="Chromium initial_preferences theme.colors block",
            json_path=("browser", "theme", "colors"),
            json_value=gen_chromium_theme_colors,
            json_indent=2,
        ),
        Target(
            path=A / "etc/chromium/initial_preferences",
            kind="json",
            description="Chromium initial_preferences _brand_palette doc (hex literals)",
            json_path=("_brand_palette",),
            json_value=gen_chromium_brand_palette_doc,
            json_indent=2,
        ),
        Target(
            path=W / "nyxus-notepad/src/index.css",
            kind="marker",
            description="nyxus-notepad index.css :root HSL block",
            marker="palette", comment="css", generator=gen_web_artifact_root_hsl,
        ),
        Target(
            path=W / "nyxus-stickies/src/index.css",
            kind="marker",
            description="nyxus-stickies index.css :root HSL block",
            marker="palette", comment="css", generator=gen_web_artifact_root_hsl,
        ),
        Target(
            path=W / "nyxus-sysmon/src/index.css",
            kind="marker",
            description="nyxus-sysmon index.css :root HSL block",
            marker="palette", comment="css", generator=gen_web_artifact_root_hsl,
        ),
        Target(
            path=W / "nyxus-widgets/src/index.css",
            kind="marker",
            description="nyxus-widgets index.css :root HSL block",
            marker="palette", comment="css", generator=gen_web_artifact_root_hsl,
        ),
        Target(
            path=W / "nyxus-web/src/index.css",
            kind="marker",
            description="nyxus-web index.css :root HSL block",
            marker="palette", comment="css", generator=gen_web_artifact_root_hsl,
        ),
        Target(
            path=A / "etc/skel/.config/hypr/hyprland.conf",
            kind="marker",
            description="Hyprland col.active_border + col.inactive_border",
            marker="borders", comment="hash", generator=gen_hyprland_borders,
        ),
        Target(
            path=A / "etc/skel/.config/hypr/hyprlock.conf",
            kind="marker",
            description="Hyprlock PIN indicator outer/inner/font colors",
            marker="indicator", comment="hash", generator=gen_hyprlock_indicator,
        ),
        Target(
            path=A / "etc/skel/.config/dunst/dunstrc",
            kind="marker",
            description="dunst [urgency_critical] frame_color (copper)",
            marker="critical-frame", comment="hash", generator=gen_dunst_critical_frame,
        ),
        Target(
            path=A / "usr/share/themes/NYXUS-Dark/gtk-4.0/gtk.css",
            kind="marker",
            description="NYXUS-Dark gtk-4 @define-color accent block",
            marker="accent", comment="css", generator=gen_gtk_accent_block,
        ),
        Target(
            path=A / "etc/skel/.config/eww/_nyxus_accent.scss",
            kind="marker",
            description="eww build-time accent default (overridden by nyxus-apply-accent)",
            marker="accent", comment="slash", generator=gen_eww_accent,
        ),
    ]


# ── Engine ───────────────────────────────────────────────────────────

def _marker_pair(comment: str, name: str) -> Tuple[str, str]:
    if comment not in COMMENT_STYLES:
        raise ValueError(f"unknown comment style: {comment!r}")
    s, e = COMMENT_STYLES[comment]
    return s.format(name=name), e.format(name=name)


def _render_marker(path: Path, marker: str, comment: str, content: str) -> str:
    """Return the new file contents with the marker block rewritten.
    Raises if the file doesn't carry both START and END marker lines."""
    if not path.is_file():
        raise FileNotFoundError(f"target file missing: {path}")
    text = path.read_text()
    start_line, end_line = _marker_pair(comment, marker)
    pat = re.compile(
        re.escape(start_line) + r"\n.*?" + re.escape(end_line),
        flags=re.DOTALL,
    )
    if not pat.search(text):
        raise RuntimeError(
            f"markers '{marker}' ({comment}) not found in {path}\n"
            f"  expected lines:\n    {start_line}\n    ...content...\n    {end_line}"
        )
    return pat.sub(start_line + "\n" + content + end_line, text)


def _render_json(path: Path, json_path: Tuple[str, ...],
                 value: Any, indent: int) -> str:
    """Return the new file contents with the dotted json_path set to
    `value`. Preserves all other keys and ordering at unchanged
    levels."""
    if not path.is_file():
        raise FileNotFoundError(f"target file missing: {path}")
    data = json.loads(path.read_text(), object_pairs_hook=OrderedDict)
    cursor = data
    for k in json_path[:-1]:
        if k not in cursor:
            cursor[k] = OrderedDict()
        cursor = cursor[k]
    cursor[json_path[-1]] = value
    return json.dumps(data, indent=indent) + "\n"


def render(tokens_path: Path, check: bool) -> int:
    if not tokens_path.is_file():
        print(f"error: tokens file missing: {tokens_path}", file=sys.stderr)
        return 2
    tokens = json.loads(tokens_path.read_text())
    targets = _build_targets(tokens_path)
    drift: List[Tuple[Target, str]] = []  # (target, reason)
    rendered: List[Target] = []

    for t in targets:
        try:
            if t.kind == "marker":
                content = t.generator(tokens)
                new_text = _render_marker(t.path, t.marker, t.comment, content)
            elif t.kind == "json":
                value = t.json_value(tokens)
                new_text = _render_json(t.path, t.json_path, value, t.json_indent)
            else:
                drift.append((t, f"unknown kind {t.kind!r}"))
                continue
        except Exception as e:
            drift.append((t, f"render failure: {e}"))
            continue

        on_disk = t.path.read_text()
        if on_disk == new_text:
            rendered.append(t)
            continue
        if check:
            drift.append((t, "drift — on-disk content does not match canonical render"))
        else:
            t.path.write_text(new_text)
            rendered.append(t)

    if check:
        if drift:
            print(f"✗ nyxus-render-tokens --check: {len(drift)} drift", file=sys.stderr)
            for t, why in drift:
                print(f"  · {t.path.relative_to(REPO_ROOT)}: {why}", file=sys.stderr)
            return 1
        print(f"✓ nyxus-render-tokens --check: all {len(rendered)} targets in sync")
        return 0

    if drift:
        print(f"✗ nyxus-render-tokens --render: {len(drift)} failures", file=sys.stderr)
        for t, why in drift:
            print(f"  · {t.path.relative_to(REPO_ROOT)}: {why}", file=sys.stderr)
        return 1
    print(f"✓ nyxus-render-tokens --render: rewrote {len(rendered)} targets")
    for t in rendered:
        print(f"  · {t.path.relative_to(REPO_ROOT)}  ({t.description})")
    return 0


def list_targets(tokens_path: Path) -> int:
    if not tokens_path.is_file():
        print(f"error: tokens file missing: {tokens_path}", file=sys.stderr)
        return 2
    tokens = json.loads(tokens_path.read_text())
    targets = _build_targets(tokens_path)
    print(f"nyxus design tokens — brand_revision = {tokens.get('$brand_revision')}")
    print(f"  source: {tokens_path.relative_to(REPO_ROOT)}")
    print(f"\npalette:")
    for k, v in tokens["palette"].items():
        forms = ", ".join(f"{f}={v[f]}" for f in ("hex", "hsl", "css") if f in v)
        print(f"  {k:24s} {forms}")
    print(f"\ntargets ({len(targets)}):")
    for t in targets:
        print(f"  [{t.kind:6s}] {t.path.relative_to(REPO_ROOT)}")
        print(f"           {t.description}")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(
        prog="nyxus-render-tokens",
        description="Render NYXUS brand tokens to per-consumer files.",
    )
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--render", action="store_true",
                   help="rewrite consumer files with canonical render")
    g.add_argument("--check",  action="store_true",
                   help="exit 1 if any consumer file drifted (CI guard)")
    g.add_argument("--list",   action="store_true",
                   help="show tokens + targets + exit")
    p.add_argument("--tokens", type=Path, default=DEFAULT_TOKENS,
                   help=f"path to tokens.json (default: {DEFAULT_TOKENS.relative_to(REPO_ROOT)})")
    args = p.parse_args(argv)

    if args.list:
        return list_targets(args.tokens)
    return render(args.tokens, check=args.check)


if __name__ == "__main__":
    raise SystemExit(main())
