# ---------------------------------------------------------------------------
# RedForge — local self-hosting environment (copy to `.env` and adjust)
# ---------------------------------------------------------------------------
# Real, local, single-operator defensive-skills trainer. LOCAL USE ONLY.

# --- Database (required) ---------------------------------------------------
# Postgres connection string used by the API server and `db push`.
DATABASE_URL=postgres://redforge:redforge@localhost:5432/redforge

# --- API server ------------------------------------------------------------
# Port the Express API listens on. The Vite dev proxy defaults to this.
PORT=5000

# --- Frontend (Vite) -------------------------------------------------------
# These are only needed for the redforge (Vite) package. When unset, the dev
# server falls back to PORT=5173 and BASE_PATH=/.
#   PORT=5173
#   BASE_PATH=/
# Where the Vite dev server proxies `/api` requests (the API server above).
API_PROXY_TARGET=http://localhost:5000

# --- AI tutor --------------------------------------------------------------
# The Anthropic integration client currently requires these at startup.
# For a local run without AI, set placeholders (tutor/debrief calls will error
# only when used); for real AI, point them at the Anthropic API.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-placeholder

# --- Network scan (defensive asset inventory of YOUR OWN lab) --------------
# Discovery tool: auto (nmap + ARP-table enrichment) | nmap | arp-scan.
REDFORGE_SCAN_TOOL=auto
# Comma-separated allow-listed CIDRs. MUST be RFC1918 private ranges.
# Defaults to the host-only lab subnet when unset.
REDFORGE_SCAN_ALLOWED_SUBNETS=192.168.56.0/24
# Also allow scanning this machine's own directly-attached private subnets.
REDFORGE_SCAN_ALLOW_LOCAL_LAN=true
# Hard timeout for a scan invocation, in milliseconds.
REDFORGE_SCAN_TIMEOUT_MS=120000
