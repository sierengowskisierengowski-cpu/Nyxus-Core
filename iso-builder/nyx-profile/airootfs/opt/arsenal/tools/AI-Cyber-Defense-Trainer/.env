# ============================================================================
# AI Cyber Defense Trainer (GowskiNet REDFORGE) — example environment
# Copy to `.env` and adjust. `.env` is git-ignored.
# ============================================================================

# --- Core (required) --------------------------------------------------------
# PostgreSQL connection string used by the API server, seed and scan scripts.
# Local socket (peer auth) example:
DATABASE_URL=postgresql:///redforge_trainer?host=/run/postgresql
# TCP example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/redforge_trainer

# JWT signing secret. CHANGE THIS — do not ship the dev default to anything
# beyond a local lab.
SESSION_SECRET=3368475ef4457bec2ed20d25635a5536a81bf58933a4cb2dbc919bd7dc3d63e1

# API server port (the SPA dev server proxies /api and /ws here).
PORT=8080

# --- Admin seed (scripts/seed.ts) -------------------------------------------
# The seed hashes this with scrypt; nothing is stored in plaintext and no
# default password is committed. Required to create the first operator.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=0afcb67c63454d4bb923389b
# SEED_FORCE=1   # reset the password if the operator already exists

# --- Live log WebSocket sources (api-server) --------------------------------
# Directory of honeypot event records to tail (read-only).
HONEYPOT_LOG_DIR=/home/cosmic/CommandVault/honeypots
# systemd journal units to follow (comma-separated).
JOURNAL_UNITS=jett-daemon,bifrost-guardian
# auditd log path — only used if readable by the server user (usually root).
AUDITD_LOG_PATH=/var/log/audit/audit.log

# --- MITRE ATT&CK dataset ---------------------------------------------------
# Optional override for the shipped distilled dataset.
# MITRE_DATASET_PATH=/absolute/path/to/mitre-attack-enterprise.json
# Source STIX bundle used by `build-mitre` to regenerate the dataset.
MITRE_STIX_PATH=/home/cosmic/Projects/jeTT/knowledge_base/mitre_attack/enterprise-attack.json

# --- Network scan (scripts/scan-network.ts) ---------------------------------
# Only allowlisted subnets may be scanned. The built-in allowlist is the
# VirtualBox host-only lab 192.168.56.0/24. Add extra CIDRs here to opt in.
SCAN_SUBNETS=192.168.56.0/24
# SCAN_ALLOWLIST=
# SCAN_PORTS=1               # also run a bounded nmap top-50 port scan
# SCAN_TARGETS=192.168.56.10 # flag these IPs as high-value targets

# --- Frontend dev server (redforge/vite.config.ts) --------------------------
# API_PROXY_TARGET=http://localhost:8080
# ANTHROPIC_API_KEY=         # optional: enables Claude/Hybrid attack generation
