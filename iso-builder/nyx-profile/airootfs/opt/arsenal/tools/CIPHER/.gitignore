# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# local env + secrets (never commit real credentials)
.env
.env.*
!.env.example

# CIPHER app-owned working dir (hash files, wordlists, runs, potfiles, auth secret)
.cipher-work/
.cipher/
