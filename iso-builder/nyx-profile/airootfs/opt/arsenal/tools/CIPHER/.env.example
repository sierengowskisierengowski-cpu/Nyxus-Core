# ============================================================================
# CIPHER environment configuration (copy to .env and edit; export before run)
# ============================================================================

# --- Required: Postgres connection string for the API server + migrations ---
DATABASE_URL=postgresql://cosmic@localhost:5432/cipher

# --- Required for tool-running features: the owner password ------------------
# Either provide a plaintext password (hashed at startup, convenient for a
# local lab) OR a pre-computed scrypt hash (preferred; generate with:
#   pnpm --filter @workspace/scripts run hash-password 'your-password')
CIPHER_PASSWORD=change-me-to-a-strong-password
# CIPHER_PASSWORD_HASH=scrypt$16384$8$1$<saltHex>$<hashHex>

# --- Optional: HMAC secret for session tokens -------------------------------
# If unset, a random secret is generated and persisted to CIPHER_WORK_DIR.
# CIPHER_AUTH_SECRET=

# --- Optional: app-owned working directory for hash files / wordlists / runs -
# All tool inputs/outputs are confined here. Defaults to ~/.cipher/work
# CIPHER_WORK_DIR=/home/cosmic/.cipher/work

# --- API server port (Express). Defaults to 8080 ----------------------------
# PORT=8080

# --- Frontend (Vite) only: set when running the SPA dev server ---------------
# PORT=23051            # dev server port (defaults to 23051)
# BASE_PATH=/           # base path (defaults to /)
# API_PROXY_TARGET=http://localhost:8080   # where /api is proxied in dev
