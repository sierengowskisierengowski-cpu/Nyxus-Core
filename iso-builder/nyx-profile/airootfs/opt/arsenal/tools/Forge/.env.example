# GowskiNet FORGE — example environment (local, self-hosted, non-Replit).
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Create a local role + database, e.g.:
#   createdb forge && psql -c "CREATE ROLE forge LOGIN PASSWORD 'forge_local_dev'" \
#     && psql -c "ALTER DATABASE forge OWNER TO forge"
DATABASE_URL=postgres://forge:forge_local_dev@127.0.0.1:5432/forge

# ─── Server / SPA ─────────────────────────────────────────────────────────────
# Single process: Express serves both /api and the built React SPA on this port.
PORT=20000
# Base path the SPA is mounted at (keep "/" for a root deployment).
BASE_PATH=/

# ─── Local AI (Ollama) ────────────────────────────────────────────────────────
# FORGE's AI (threat generation / analysis / chat) runs fully local via Ollama —
# no cloud vendor, no API key, no outbound network calls. Install Ollama and
# pull/create the model, then point these at it (defaults shown).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=forge-sec

# ─── Authentication ───────────────────────────────────────────────────────────
# Login username (default: admin).
FORGE_AUTH_USERNAME=admin
# Set ONE of the following:
#   FORGE_AUTH_PASSWORD       plaintext password (hashed in memory at startup)
#   FORGE_AUTH_PASSWORD_HASH  a scrypt hash from `pnpm --filter @workspace/scripts run hash-password`
# If neither is set, a random temporary password is generated and printed at startup.
FORGE_AUTH_PASSWORD=
# FORGE_AUTH_PASSWORD_HASH=
# HMAC key used to sign session cookies. Generate with: openssl rand -hex 32
# If unset, an ephemeral secret is used (logins reset on restart).
SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days).
# FORGE_SESSION_TTL_HOURS=168
# Set to 1 only when serving over HTTPS (adds the Secure flag to the cookie).
# FORGE_COOKIE_SECURE=0

# ─── CORS (locked down by default) ────────────────────────────────────────────
# App is same-origin by default (no CORS). Only set this if the API is fronted
# from a different origin (comma-separated list); credentials are then allowed.
# FORGE_ALLOWED_ORIGINS=

# ─── Meli honeypot feed (real Cowrie ledger, read-only) ───────────────────────
# Directory holding the honeypot event ledger. FORGE reads cowrie logs from here
# (and _audit/cowrie.log) read-only to populate the Meli feed. Never written to.
FORGE_HONEYPOT_LOG_DIR=/home/cosmic/CommandVault/honeypots
# How often (ms) to re-scan the ledger for new commands (0 disables the timer).
# FORGE_HONEYPOT_POLL_MS=60000

# ─── REDFORGE handoff export ──────────────────────────────────────────────────
# Where "Export to REDFORGE" writes portable deployment packages.
# Default: <repo>/exports/redforge
# FORGE_REDFORGE_EXPORT_DIR=
