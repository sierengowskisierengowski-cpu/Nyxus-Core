# GowskiNet FORGE — local (self-hosted, fully offline AI) runtime config.
# This file is gitignored; never commit real secrets here.

# ── Database (local Postgres: role+db "forge") ────────────────────────────────
DATABASE_URL=postgres://forge:forge_local_dev@127.0.0.1:5432/forge

# ── Server (single process: Express serves /api AND the built React SPA) ──────
PORT=20000
BASE_PATH=/

# ── Local AI — Ollama, no cloud, no API key ───────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=forge-sec

# ── Auth (login gate; bound to 127.0.0.1 only) ────────────────────────────────
# Change FORGE_AUTH_PASSWORD to whatever you like, then re-run `forge`.
FORGE_AUTH_USERNAME=admin
FORGE_AUTH_PASSWORD=forge
# Stable session signing key so logins survive restarts (generated once):
SESSION_SECRET=79d97a608c03ce615a783c1fa9c7c754beb655c23ec1e27e7ddfb0d08a692fd9
FORGE_SESSION_TTL_HOURS=168
