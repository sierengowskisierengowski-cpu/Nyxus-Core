# GSL backend configuration — copy to `.env` and edit. NEVER commit `.env`.
# Scoped to local / isolated-lab use only.

# ── Authentication (required to protect the command / WebSocket endpoints) ────
GSL_AUTH_USERNAME=admin

# Preferred: a PBKDF2 hash. Generate one with:
#     cd gsl-backend && python3 hash_password.py
# then paste the printed GSL_AUTH_PASSWORD_HASH=... line here.
GSL_AUTH_PASSWORD_HASH=

# Fallback (less safe): a plaintext password, hashed in memory at startup.
# Use ONLY if you can't run hash_password.py. Leave blank if using the hash.
# GSL_AUTH_PASSWORD=

# If BOTH of the above are blank, the backend generates a strong one-time
# password at startup and prints it to the console (changes every restart).

# Session lifetime in hours (default 12).
# GSL_SESSION_TTL_HOURS=12

# ── Networking ────────────────────────────────────────────────────────────────
# Backend bind host/port (start.sh reads these).
# GSL_HOST=0.0.0.0
# GSL_BACKEND_PORT=8000

# Extra CORS origins (comma-separated). Only needed if the Vite dev server talks
# to the backend as a *separate* origin instead of through the dev proxy.
# GSL_CORS_ORIGINS=http://localhost:19670,http://127.0.0.1:19670

# ── Static SPA serving (single-port production mode) ──────────────────────────
# Defaults to artifacts/gsl/dist/public if that build exists. Override to serve
# a build from elsewhere, or point it at a non-existent path to disable.
# GSL_STATIC_DIR=/absolute/path/to/artifacts/gsl/dist/public
