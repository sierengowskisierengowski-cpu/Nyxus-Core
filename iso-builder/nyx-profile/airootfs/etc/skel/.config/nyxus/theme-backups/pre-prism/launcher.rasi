/* APEX RIG Rofi — Deep Hunt (shark / ocean) */

* {
    bg:         #070d12;
    bar-bg:     #0a1219;
    widget-bg:  #0f1c28;
    active:     #5eb3cc;
    inactive:   #2a4558;
    highlight:  #3d8cba;
    text:       #a8c8dc;
    sep:        #1a2d3d;
    selected-bg:#14202e;

    font:                   "JetBrainsMono Nerd Font 12";
    background-color:       transparent;
    text-color:             @text;
}

window {
    background-color:       @bar-bg;
    border:                 1px;
    border-color:           @sep;
    border-radius:          10px;
    width:                  520px;
    padding:                16px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       @widget-bg;
    border-radius:          6px;
    border:                 1px;
    border-color:           @sep;
    padding:                10px 14px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @highlight;
    font:                   "JetBrainsMono Nerd Font 13";
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @text;
    placeholder-color:      @inactive;
    placeholder:            "search apps...";
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    background-color:       transparent;
    columns:                1;
    lines:                  8;
    spacing:                2px;
    scrollbar:              true;
    border:                 0;
    cycle:                  false;
    dynamic:                true;
    layout:                 vertical;
}

element {
    background-color:       transparent;
    text-color:             @text;
    border-radius:          6px;
    padding:                8px 12px;
    cursor:                 pointer;
    orientation:            horizontal;
    spacing:                10px;
}

element-icon {
    background-color:       transparent;
    size:                   22px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @text;
}

element selected.normal {
    background-color:       @selected-bg;
    text-color:             @active;
    border:                 1px;
    border-color:           @sep;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @text;
}

scrollbar {
    background-color:       @widget-bg;
    handle-color:           @highlight;
    handle-width:           3px;
    border-radius:          2px;
    padding:                2px;
}
