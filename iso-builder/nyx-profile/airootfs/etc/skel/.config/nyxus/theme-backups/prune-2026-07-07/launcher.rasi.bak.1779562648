/* ============================================================
   GowskiNet Rofi App Launcher Theme
   Palette: Sun-faded vintage
   File: ~/.config/rofi/launcher.rasi
   ============================================================ */

* {
    bg:         #1a1a18;
    bar-bg:     #1e1c19;
    widget-bg:  #252420;
    active:     #c8c0a8;
    inactive:   #6b6558;
    highlight:  #b8a888;
    text:       #d4ccb8;
    sep:        #3a3830;
    selected-bg:#2e2c28;

    font:                   "JetBrainsMono Nerd Font 12";
    background-color:       transparent;
    text-color:             @text;
}

window {
    background-color:       @bar-bg;
    border:                 1px;
    border-color:           @sep;
    border-radius:          10px;
    width:                  520px;
    padding:                16px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       @widget-bg;
    border-radius:          6px;
    border:                 1px;
    border-color:           @sep;
    padding:                10px 14px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @highlight;
    font:                   "JetBrainsMono Nerd Font 13";
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @text;
    placeholder-color:      @inactive;
    placeholder:            "search apps...";
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    background-color:       transparent;
    columns:                1;
    lines:                  8;
    spacing:                2px;
    scrollbar:              true;
    border:                 0;
    cycle:                  false;
    dynamic:                true;
    layout:                 vertical;
}

element {
    background-color:       transparent;
    text-color:             @text;
    border-radius:          6px;
    padding:                8px 12px;
    cursor:                 pointer;
    orientation:            horizontal;
    spacing:                10px;
}

element-icon {
    background-color:       transparent;
    size:                   22px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @text;
}

element selected.normal {
    background-color:       @selected-bg;
    text-color:             @active;
    border:                 1px;
    border-color:           @sep;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @text;
}

scrollbar {
    background-color:       @widget-bg;
    handle-color:           @highlight;
    handle-width:           3px;
    border-radius:          2px;
    padding:                2px;
}
