/* ============================================================
   GowskiNet Rofi Power Menu Theme
   Palette: Sun-faded vintage
   File: ~/.config/rofi/power.rasi
   ============================================================ */

* {
    bg:         #1a1a18;
    bar-bg:     #1e1c19;
    widget-bg:  #252420;
    active:     #c8c0a8;
    inactive:   #6b6558;
    highlight:  #b8a888;
    text:       #d4ccb8;
    clock:      #e8dcc8;
    urgent:     #c87a5a;
    sep:        #3a3830;
    selected-bg:#2e2c28;

    font:                   "JetBrainsMono Nerd Font 13";
    background-color:       transparent;
    text-color:             @text;
}

window {
    background-color:       @bar-bg;
    border:                 1px;
    border-color:           @sep;
    border-radius:          10px;
    width:                  220px;
    padding:                12px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                8px;
    padding:                4px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       transparent;
    children:               [ prompt ];
    spacing:                0;
    padding:                0 0 8px 0;
}

prompt {
    background-color:       transparent;
    text-color:             @highlight;
    font:                   "JetBrainsMono Nerd Font Bold 11";
    horizontal-align:       0.5;
    padding:                4px 0;
}

listview {
    background-color:       transparent;
    columns:                1;
    lines:                  4;
    spacing:                4px;
    scrollbar:              false;
    border:                 0;
}

element {
    background-color:       transparent;
    text-color:             @text;
    border-radius:          6px;
    padding:                10px 16px;
    cursor:                 pointer;
    orientation:            horizontal;
    spacing:                12px;
}

element-icon {
    background-color:       transparent;
    size:                   18px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @text;
}

element selected.normal {
    background-color:       @selected-bg;
    text-color:             @active;
    border:                 1px;
    border-color:           @sep;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @text;
}

element normal.urgent {
    background-color:       transparent;
    text-color:             @urgent;
}

element selected.urgent {
    background-color:       @selected-bg;
    text-color:             @urgent;
    border:                 1px;
    border-color:           @urgent;
}

scrollbar {
    background-color:       @widget-bg;
    handle-color:           @highlight;
    handle-width:           4px;
    border-radius:          2px;
}
