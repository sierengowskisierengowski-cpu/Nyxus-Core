/* NYXUS · Obsidian Prism — window switcher (Super+Tab)
 * Palette: #ff3cac · #2bd2ff · #784bff · #ffb84d */

* {
    bg:         #05060a;
    bar-bg:     rgba(5, 6, 10, 0.90);
    widget-bg:  rgba(10, 13, 20, 0.85);
    active:     #2bd2ff;
    inactive:   rgba(238, 242, 250, 0.35);
    highlight:  #ff3cac;
    violet:     #784bff;
    gold:       #ffb84d;
    text:       #eef2fa;
    sep:        rgba(120, 75, 255, 0.35);
    selected-bg:rgba(255, 60, 172, 0.18);
    glass-line: rgba(43, 210, 255, 0.35);

    font:                   "JetBrainsMono Nerd Font 12";
    background-color:       transparent;
    text-color:             @text;
}

window {
    width:                  560px;
    background-color:       @bar-bg;
    border:                 2px;
    border-color:           @glass-line;
    border-radius:          16px;
    padding:                16px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       @widget-bg;
    border-radius:          10px;
    border:                 1px;
    border-color:           @glass-line;
    padding:                10px 14px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @gold;
    font:                   "JetBrainsMono Nerd Font Bold 12";
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @text;
    placeholder:            "switch to...";
    placeholder-color:      @inactive;
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    background-color:       transparent;
    padding:                2px;
    spacing:                2px;
    lines:                  10;
    columns:                1;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;
}

element {
    background-color:       transparent;
    text-color:             @text;
    padding:                9px 12px;
    spacing:                10px;
    border-radius:          10px;
    cursor:                 pointer;
}

element selected.normal,
element selected.alternate.normal,
element selected.active,
element selected.urgent {
    background-color:       @selected-bg;
    text-color:             @active;
    border:                 1px;
    border-color:           @sep;
    border-radius:          10px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    font:                   "JetBrainsMono Nerd Font 11";
    vertical-align:         0.5;
}

element-icon {
    background-color:       transparent;
    size:                   22px;
}
