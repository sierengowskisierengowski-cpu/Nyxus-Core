/* NYXUS · STARFALL — power menu (rev 2026-07-11)
 * Moonstone glass over the baked wallpaper slab; hover = ember fire,
 * destructive rows read hot red. Matches launcher.rasi. */

* {
    ink:        rgba(7, 3, 16, 0.92);
    vessel:     rgba(16, 8, 32, 0.72);
    moonline:   rgba(214, 205, 255, 0.42);
    moontext:   #f2f0ff;
    dim:        rgba(214, 205, 255, 0.45);
    violet:     #a882ff;
    ember:      #ffb050;
    ember-hot:  #ffd9a0;
    ember-bg:   rgba(255, 140, 40, 0.16);
    ember-line: rgba(255, 176, 80, 0.55);
    urgent:     #ff5470;

    font:                   "JetBrainsMono Nerd Font 13";
    background-color:       transparent;
    text-color:             @moontext;
}

window {
    background-image:       url("~/.config/nyxus/backdrops/starfall-backdrop-card.png", both);
    background-color:       @ink;
    border:                 1px;
    border-color:           @moonline;
    border-radius:          16px;
    width:                  220px;
    padding:                12px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                8px;
    padding:                4px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       transparent;
    children:               [ prompt ];
    spacing:                0;
    padding:                0 0 8px 0;
}

prompt {
    background-color:       transparent;
    text-color:             @ember;
    font:                   "JetBrainsMono Nerd Font Bold 11";
    horizontal-align:       0.5;
    padding:                4px 0;
}

listview {
    background-color:       transparent;
    columns:                1;
    lines:                  4;
    spacing:                4px;
    scrollbar:              false;
    border:                 0;
}

element {
    background-color:       transparent;
    text-color:             @moontext;
    border-radius:          10px;
    padding:                10px 16px;
    cursor:                 pointer;
    orientation:            horizontal;
    spacing:                12px;
}

element-icon {
    background-color:       transparent;
    size:                   18px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @moontext;
}

element selected.normal {
    background-color:       @ember-bg;
    text-color:             @ember-hot;
    border:                 1px;
    border-color:           @ember-line;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @moontext;
}

element normal.urgent {
    background-color:       transparent;
    text-color:             @urgent;
}

element selected.urgent {
    background-color:       rgba(255, 84, 112, 0.16);
    text-color:             @urgent;
    border:                 1px;
    border-color:           @urgent;
}

scrollbar {
    background-color:       @vessel;
    handle-color:           @violet;
    handle-width:           4px;
    border-radius:          2px;
}
