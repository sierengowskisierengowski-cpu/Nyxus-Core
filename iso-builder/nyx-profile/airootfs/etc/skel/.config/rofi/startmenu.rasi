/* NYXUS · STARFALL — start menu (rev 2026-07-11)
 * Moonstone night-sky glass over the baked wallpaper slab; keeps the
 * Permanent Marker / Caveat brand hand, selection burns ember. */
* {
    bg-deep:   #070310;
    bg-card:   rgba(16, 8, 32, 0.72);
    text-hi:   #f2f0ff;
    text-lo:   rgba(214, 205, 255, 0.55);
    hairline:  rgba(214, 205, 255, 0.32);
    accent:    #ffb050;
    accent2:   #a882ff;
    glass-bg:  rgba(7, 3, 16, 0.92);
    glass-line: rgba(214, 205, 255, 0.42);

    background-color: transparent;
    text-color: @text-hi;
}

window {
    width: 720px;
    background-image: url("~/.config/nyxus/backdrops/starfall-backdrop-card.png", both);
    background-color: @glass-bg;
    border: 1px;
    border-color: @glass-line;
    border-radius: 16px;
    padding: 0;
    location: center;
    anchor: center;
    y-offset: 60px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    background-color: transparent;
    border: 0 0 1px 0;
    border-color: @hairline;
    padding: 14px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "Permanent Marker 13";
}

entry {
    text-color: @text-hi;
    placeholder: "Search apps, files, settings...";
    placeholder-color: @text-lo;
    font: "Caveat 15";
}

listview {
    background-color: transparent;
    padding: 12px;
    spacing: 4px;
    lines: 4;
    columns: 4;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
}

element {
    background-color: @bg-card;
    text-color: @text-hi;
    border: 1px;
    border-color: @hairline;
    padding: 10px 6px;
    spacing: 5px;
    border-radius: 10px;
    orientation: vertical;
}

element selected.normal,
element selected.alternate.normal,
element selected.urgent,
element selected.active {
    background-color: rgba(255, 140, 40, 0.18);
    text-color: #ffd9a0;
    border: 1px;
    border-color: rgba(255, 176, 80, 0.60);
    border-radius: 10px;
}

element-icon {
    size: 38px;
    horizontal-align: 0.5;
}

element-text {
    text-color: inherit;
    horizontal-align: 0.5;
    font: "JetBrains Mono Nerd Font 9";
}

mode-switcher {
    background-color: transparent;
    border: 1px 0 0 0;
    border-color: @hairline;
    border-radius: 0 0 16px 16px;
    padding: 8px 12px;
    spacing: 6px;
}

button {
    background-color: @bg-card;
    text-color: @text-lo;
    border: 1px;
    border-color: @hairline;
    border-radius: 10px;
    padding: 6px 14px;
    font: "Permanent Marker 10";
}

button selected {
    background-color: rgba(255, 140, 40, 0.18);
    text-color: #ffd9a0;
    border-color: rgba(255, 176, 80, 0.60);
    border-radius: 10px;
}
