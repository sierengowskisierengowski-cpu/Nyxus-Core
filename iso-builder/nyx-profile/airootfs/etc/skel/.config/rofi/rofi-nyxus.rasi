/* NYXUS · Obsidian Prism — window switcher (Super+Tab)
 * Palette: #7d3dff · #ff2d55 · #39ff14 · #ff8a1e */

* {
    bg:         #05060a;
    bar-bg:     rgba(5, 6, 10, 0.90);
    widget-bg:  rgba(10, 13, 20, 0.85);
    active:     #ff2d55;
    inactive:   rgba(238, 242, 250, 0.35);
    highlight:  #7d3dff;
    violet:     #39ff14;
    gold:       #ff8a1e;
    text:       #eef2fa;
    sep:        rgba(57, 255, 20, 0.35);
    selected-bg:rgba(125, 61, 255, 0.18);
    glass-line: rgba(255, 45, 85, 0.35);

    font:                   "Inter 12";
    background-color:       transparent;
    text-color:             @text;
}

window {
    width:                  580px;
    background-color:       @bar-bg;
    border:                 1px;
    border-color:           @glass-line;
    border-radius:          16px;
    padding:                20px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       @widget-bg;
    border-radius:          10px;
    border:                 1px;
    border-color:           @glass-line;
    padding:                10px 14px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @gold;
    font:                   "JetBrainsMono Nerd Font Bold 12";
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @text;
    placeholder:            "switch to...";
    placeholder-color:      @inactive;
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    background-color:       transparent;
    padding:                2px;
    spacing:                2px;
    lines:                  10;
    columns:                1;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;
}

element {
    background-color:       transparent;
    text-color:             @text;
    padding:                10px 14px;
    spacing:                12px;
    border-radius:          10px;
    cursor:                 pointer;
}

element selected.normal,
element selected.alternate.normal,
element selected.active,
element selected.urgent {
    background-color:       @selected-bg;
    text-color:             @active;
    border:                 1px;
    border-color:           @sep;
    border-radius:          10px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    font:                   "Inter 12";
    vertical-align:         0.5;
}

element-icon {
    background-color:       transparent;
    size:                   24px;
}
