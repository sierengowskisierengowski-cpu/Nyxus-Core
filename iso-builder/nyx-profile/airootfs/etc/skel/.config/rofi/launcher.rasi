/* NYXUS · STARFALL — app launcher (rev 2026-07-11)
 * Moonstone night-sky glass: baked wallpaper slab behind violet-silver
 * crystal; selection burns ember like the perimeter fireball.
 * Matches the eww bars/flyouts. Backdrop: nyxus-gen-backdrop. */

* {
    ink:        rgba(7, 3, 16, 0.92);
    vessel:     rgba(16, 8, 32, 0.72);
    moonline:   rgba(214, 205, 255, 0.42);
    moontext:   #f2f0ff;
    dim:        rgba(214, 205, 255, 0.45);
    violet:     #a882ff;
    ember:      #ffb050;
    ember-hot:  #ffd9a0;
    ember-bg:   rgba(255, 140, 40, 0.16);
    ember-line: rgba(255, 176, 80, 0.55);

    font:                   "JetBrainsMono Nerd Font 12";
    background-color:       transparent;
    text-color:             @moontext;
}

window {
    background-image:       url("~/.config/nyxus/backdrops/starfall-backdrop-card.png", both);
    background-color:       @ink;
    border:                 1px;
    border-color:           @moonline;
    border-radius:          16px;
    width:                  520px;
    padding:                16px;
    location:               center;
    anchor:                 center;
}

mainbox {
    background-color:       transparent;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       @vessel;
    border-radius:          10px;
    border:                 1px;
    border-color:           @moonline;
    padding:                10px 14px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @ember;
    font:                   "JetBrainsMono Nerd Font 13";
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @moontext;
    placeholder-color:      @dim;
    placeholder:            "search apps...";
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    background-color:       transparent;
    columns:                1;
    lines:                  8;
    spacing:                2px;
    scrollbar:              true;
    border:                 0;
    cycle:                  false;
    dynamic:                true;
    layout:                 vertical;
}

element {
    background-color:       transparent;
    text-color:             @moontext;
    border-radius:          10px;
    padding:                8px 12px;
    cursor:                 pointer;
    orientation:            horizontal;
    spacing:                10px;
}

element-icon {
    background-color:       transparent;
    size:                   22px;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @moontext;
}

element selected.normal {
    background-color:       @ember-bg;
    text-color:             @ember-hot;
    border:                 1px;
    border-color:           @ember-line;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @moontext;
}

scrollbar {
    background-color:       @vessel;
    handle-color:           @violet;
    handle-width:           3px;
    border-radius:          2px;
    padding:                2px;
}
