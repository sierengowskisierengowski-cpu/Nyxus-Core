# ════════════════════════════════════════════════════════════════════

# Main background (empty = terminal default, keeps frosted glass)
theme[main_bg]=""

# Main text color
theme[main_fg]="#eef2fa"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff3cac"

# Background color of selected item in processes box
theme[selected_bg]="#784bff"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#3a4152"

# Color of text appearing on top of graphs
theme[graph_text]="#c8ccd6"

# Background color of the percentage meters
theme[meter_bg]="#0a0a14"

# Misc colors for processes box (mini-graphs, details)
theme[proc_misc]="#2bd2ff"

# Box outline colors
theme[cpu_box]="#784bff"
theme[mem_box]="#2bd2ff"
theme[net_box]="#ff3cac"
theme[proc_box]="#ffb84d"

# Box divider line and small boxes
theme[div_line]="#3a4152"

# Temperature graph gradient (cool → hot)
theme[temp_start]="#2bd2ff"
theme[temp_mid]="#ffb84d"
theme[temp_end]="#ff5470"

# CPU graph gradient (violet → cyan → magenta)
theme[cpu_start]="#784bff"
theme[cpu_mid]="#2bd2ff"
theme[cpu_end]="#ff3cac"

# Mem/Disk free meter
theme[free_start]="#784bff"
theme[free_mid]="#a06bff"
theme[free_end]="#c084fc"

# Mem/Disk cached meter
theme[cached_start]="#2bd2ff"
theme[cached_mid]="#66efff"
theme[cached_end]="#7dd3fc"

# Mem/Disk available meter
theme[available_start]="#ffb84d"
theme[available_mid]="#ffce85"
theme[available_end]="#ffd166"

# Mem/Disk used meter
theme[used_start]="#ff3cac"
theme[used_mid]="#ff5fc0"
theme[used_end]="#ff7ae5"

# Download graph gradient
theme[download_start]="#2bd2ff"
theme[download_mid]="#66efff"
theme[download_end]="#a0f4ff"

# Upload graph gradient
theme[upload_start]="#ff3cac"
theme[upload_mid]="#ff5fc0"
theme[upload_end]="#ff7ae5"

# Process box gradient (from grey to prism)
theme[process_start]="#784bff"
theme[process_mid]="#2bd2ff"
theme[process_end]="#ff3cac"
