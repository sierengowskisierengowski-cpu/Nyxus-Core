# Main background (empty = terminal default, keeps frosted glass)
theme[main_bg]=""

# Main text color
theme[main_fg]="#eef2fa"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f27531"

# Background color of selected item in processes box
theme[selected_bg]="#7326ff"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#3a4152"

# Color of text appearing on top of graphs
theme[graph_text]="#c8ccd6"

# Background color of the percentage meters
theme[meter_bg]="#0a0a14"

# Misc colors for processes box (mini-graphs, details)
theme[proc_misc]="#26ffe0"

# Box outline colors
theme[cpu_box]="#7326ff"
theme[mem_box]="#26ffe0"
theme[net_box]="#f27531"
theme[proc_box]="#ff7326"

# Box divider line and small boxes
theme[div_line]="#3a4152"

# Temperature graph gradient (cool → hot)
theme[temp_start]="#26ffe0"
theme[temp_mid]="#ff7326"
theme[temp_end]="#ff5470"

# CPU graph gradient (violet → cyan → magenta)
theme[cpu_start]="#7326ff"
theme[cpu_mid]="#26ffe0"
theme[cpu_end]="#f27531"

# Mem/Disk free meter
theme[free_start]="#7326ff"
theme[free_mid]="#a06bff"
theme[free_end]="#c084fc"

# Mem/Disk cached meter
theme[cached_start]="#26ffe0"
theme[cached_mid]="#66efff"
theme[cached_end]="#7dd3fc"

# Mem/Disk available meter
theme[available_start]="#ff7326"
theme[available_mid]="#ffce85"
theme[available_end]="#ffd166"

# Mem/Disk used meter
theme[used_start]="#f27531"
theme[used_mid]="#ff5fc0"
theme[used_end]="#ff7ae5"

# Download graph gradient
theme[download_start]="#26ffe0"
theme[download_mid]="#66efff"
theme[download_end]="#a0f4ff"

# Upload graph gradient
theme[upload_start]="#f27531"
theme[upload_mid]="#ff5fc0"
theme[upload_end]="#ff7ae5"

# Process box gradient (from grey to prism)
theme[process_start]="#7326ff"
theme[process_mid]="#26ffe0"
theme[process_end]="#f27531"
