# Main background (empty = terminal default, keeps frosted glass)
theme[main_bg]=""

# Main text color
theme[main_fg]="#eef2fa"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7d3dff"

# Background color of selected item in processes box
theme[selected_bg]="#39ff14"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#3a4152"

# Color of text appearing on top of graphs
theme[graph_text]="#c8ccd6"

# Background color of the percentage meters
theme[meter_bg]="#05060a"

# Misc colors for processes box (mini-graphs, details)
theme[proc_misc]="#ff2d55"

# Box outline colors
theme[cpu_box]="#39ff14"
theme[mem_box]="#ff2d55"
theme[net_box]="#7d3dff"
theme[proc_box]="#ff8a1e"

# Box divider line and small boxes
theme[div_line]="#3a4152"

# Temperature graph gradient (cool → hot)
theme[temp_start]="#ff2d55"
theme[temp_mid]="#ff8a1e"
theme[temp_end]="#ff5470"

# CPU graph gradient (violet → cyan → magenta)
theme[cpu_start]="#39ff14"
theme[cpu_mid]="#ff2d55"
theme[cpu_end]="#7d3dff"

# Mem/Disk free meter
theme[free_start]="#39ff14"
theme[free_mid]="#7d3dff"
theme[free_end]="#7d3dff"

# Mem/Disk cached meter
theme[cached_start]="#ff2d55"
theme[cached_mid]="#66efff"
theme[cached_end]="#2bd2ff"

# Mem/Disk available meter
theme[available_start]="#ff8a1e"
theme[available_mid]="#ffe600"
theme[available_end]="#ffe600"

# Mem/Disk used meter
theme[used_start]="#7d3dff"
theme[used_mid]="#ff5fc0"
theme[used_end]="#ff7ae5"

# Download graph gradient
theme[download_start]="#ff2d55"
theme[download_mid]="#66efff"
theme[download_end]="#a0f4ff"

# Upload graph gradient
theme[upload_start]="#7d3dff"
theme[upload_mid]="#ff5fc0"
theme[upload_end]="#ff7ae5"

# Process box gradient (from grey to prism)
theme[process_start]="#39ff14"
theme[process_mid]="#ff2d55"
theme[process_end]="#7d3dff"
