// ============================================================================
//  NYXUS · Fastfetch config                          rev 2026-05-14 r1
//
//  Premium terminal greeting — Eclipse ASCII + cream key labels + dim
//  body text + 3-column layout. Replaces the generic "Arch Linux" fetch
//  with a NYXUS-branded one that hides the underlying distro.
//
//  Color slots used (fastfetch palette tokens, not literal hex):
//    keys      = bright cream  → token "yellow"   remapped via terminal
//    title     = bold cream    → token "1;33"
//    separator = dim hairline  → token "2;37"
//
//  © 2026 JOSEPH SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
// ============================================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/nyxus/brand/ascii/eclipse.txt",
        "type":   "file",
        "padding": { "top": 1, "right": 4, "left": 2 },
        "color":  { "1": "yellow", "2": "default" }
    },
    "display": {
        "separator":     "  ",
        "color": {
            "keys":      "1;33",
            "title":     "1;33",
            "output":    "0;37"
        },
        "constants": [
            "─────────────────────────────────"
        ]
    },
    "modules": [
        {
            "type":  "title",
            "color": { "user": "1;33", "at": "0;90", "host": "1;33" },
            "format": "{1}@{2}"
        },
        "$1",
        { "type": "os",       "key": "  os   ", "format": "NYXUS {3}" },
        { "type": "kernel",   "key": "  kern ", "format": "{1} {2}" },
        { "type": "uptime",   "key": "  up   ", "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m" },
        { "type": "packages", "key": "  pkgs ", "format": "{} (pacman)" },
        { "type": "shell",    "key": "  sh   " },
        "$1",
        { "type": "wm",       "key": "  wm   ", "format": "Hyprland" },
        { "type": "terminal", "key": "  term " },
        { "type": "font",     "key": "  font " },
        { "type": "theme",    "key": "  thm  ", "format": "NYXUS-Dark + Kvantum/NYXUS" },
        { "type": "icons",    "key": "  ico  ", "format": "NYXUS-Dark" },
        { "type": "cursor",   "key": "  cur  ", "format": "NYXUS-Aurora" },
        "$1",
        { "type": "cpu",      "key": "  cpu  " },
        { "type": "gpu",      "key": "  gpu  " },
        { "type": "memory",   "key": "  mem  " },
        { "type": "disk",     "key": "  disk ", "folders": "/" },
        "$1",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
