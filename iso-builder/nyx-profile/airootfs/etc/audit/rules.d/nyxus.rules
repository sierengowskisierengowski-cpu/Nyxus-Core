## NYXUS — auditd ruleset for the security-lab loop (rev 2026-07-14)
## Purpose: give jeTT / Bifrost a real syscall-audit feed instead of an idle
## auditd. Tuned for a security workstation that runs untrusted code, Docker
## honeypots, and eBPF EDR. Deployed to /etc/audit/rules.d/ (augenrules
## compiles these into /etc/audit/audit.rules).
##
## Conservative by design: watches high-signal events, avoids the firehose
## (no blanket syscall auditing) so it won't drown the disk on a busy lab.

## Reset + basics
-D
-b 8192
-f 1
--backlog_wait_time 60000

## Identity / privilege changes
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group  -p wa -k identity
-w /etc/sudoers -p wa -k priv
-w /etc/sudoers.d/ -p wa -k priv

## Auth / access surface
-w /var/log/faillog -p wa -k logins
-w /etc/ssh/sshd_config -p wa -k sshd
-w /root/.ssh/ -p wa -k ssh_keys

## Privilege escalation (setuid/setgid execs) — high EDR signal
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_exec
-a always,exit -F arch=b64 -C uid!=euid -F euid=0 -S execve -k setuid_exec

## Kernel module load/unload (rootkit / sensor tamper watch)
-w /sbin/insmod -p x -k modules
-w /sbin/rmmod -p x -k modules
-w /sbin/modprobe -p x -k modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k module_ops

## eBPF program loads (the sensor stack itself + any hostile bpf)
-a always,exit -F arch=b64 -S bpf -k bpf_ops

## ptrace (process injection / debugging of other procs)
-a always,exit -F arch=b64 -S ptrace -k ptrace

## Time changes (log-tampering indicator)
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change

## Container / honeypot surface — mount + namespace ops
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k mounts

## Make the config immutable until reboot (tamper-resistance). Comment out
## while tuning; re-enable for a hardened lab posture.
# -e 2
