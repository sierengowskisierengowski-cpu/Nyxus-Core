# NYXUS · Calamares branding descriptor             rev 2026-05-14 r3
# Sprint F: rev r15 compliance — old release codename retired,
# cream-only sidebar, premium glass slideshow palette.
---
componentName: nyxus

welcomeStyleCalamares: true
welcomeExpandingLogo:  false
windowExpanding:       normal
windowSize:            960px,600px
windowPlacement:       center

strings:
    productName:         "NYXUS"
    shortProductName:    "NYXUS"
    version:             "2026.05"
    shortVersion:        "2026.05"
    versionedName:       "NYXUS 2026.05"
    shortVersionedName:  "NYXUS 2026.05"
    bootloaderEntryName: "NYXUS"
    productUrl:          "https://nyxus.os"
    supportUrl:          "https://nyxus.os/support"
    knownIssuesUrl:      "https://nyxus.os/issues"
    releaseNotesUrl:     "https://nyxus.os/changelog"
    donateUrl:           ""

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

slideshow:           "show.qml"
slideshowAPI:        2

# Sprint F sidebar — triple-black + cream highlight, matches show.qml.
style:
    sidebarBackground:         "#0a0a0a"
    sidebarText:               "#cfc6b3"
    sidebarTextSelect:         "#0a0a0a"
    sidebarTextHighlight:      "#f4ead5"
    sidebarBackgroundSelected: "#f4ead5"
