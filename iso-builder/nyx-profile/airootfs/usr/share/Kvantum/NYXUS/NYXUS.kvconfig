; NYXUS · Kvantum theme config            rev 2026-05-14 r1 (Sprint F)
; Renders Qt apps in the NYXUS rev r15 brand: triple-black + frosted
; glass + cream #f4ead5 accent + 3px corners + Inter typography.
; Loaded automatically when QT_STYLE_OVERRIDE=kvantum (set in /etc/
; environment) and the user's qt5ct/qt6ct points style → "kvantum".

[General]
author=NYXUS
comment=NYXUS rev r15 — triple-black + cream
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
spread_progressbar=true
composite=true
menu_shadow_depth=10
spread_menuitems=true
tooltip_shadow_depth=8
splitter_width=4
scroll_width=10
scroll_arrows=false
scroll_min_extent=42
slider_width=4
slider_handle_width=14
slider_handle_length=14
center_toolbar_handle=true
check_size=14
textless_progressbar=false
progressbar_thickness=4
menubar_mouse_tracking=true
toolbutton_style=1
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=18
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
no_inactiveness=false
layout_spacing=6
layout_margin=9
submenu_overlap=0
tooltip_delay=-1
transient_scrollbar=true
transient_groove=true
scrollbar_in_view=true
tree_branch_line=true
scrollable_menu=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_menu=false
iconless_pushbutton=false
disabled_icon_opacity=40
lxqtmainmenu_iconsize=22
normal_default_pushbutton=false
single_top_toolbar=true
tint_on_mouseover=0
no_selection_tint=true
transparent_ktitle_label=true
transparent_dialog_title=true
kinetic_scrolling=false
middle_click_scroll=false
no_inline_svg=false
style_vertical_toolbars=false
centered_forms=false
noninteger_translucency=false
