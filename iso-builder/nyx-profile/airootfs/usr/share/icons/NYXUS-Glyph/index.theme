[Icon Theme]
Name=NYXUS-Glyph
Comment=NYXUS Eclipse rev r16 — black puck + thin copper ring + minimal cream glyph. The unified app-icon contract for every shipped NYXUS app.
Inherits=NYXUS-Dark,Papirus-Dark,Adwaita,hicolor
Example=nyxus-settings

Directories=scalable/apps,scalable/places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places
