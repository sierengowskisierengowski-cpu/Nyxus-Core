#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-freeform [on|off|toggle|status] · rev 2026-07-07
#
# Flip between FREEFORM (every window floats — place & size at will,
# sizes remembered per app) and classic dwindle TILING. Rewrites
# ~/.config/hypr/conf.d/nyxus-freeform.conf and hot-reloads Hyprland.
# Existing windows keep their current state; the mode applies to
# windows opened from now on.
# © 2026 Joseph A. Sierengowski · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u

SHARD="${HOME}/.config/hypr/conf.d/nyxus-freeform.conf"

HEADER='# ============================================================
#  NYXUS — Freeform window mode (rev r1 · 2026-07-07)
#  ~/.config/hypr/conf.d/nyxus-freeform.conf
#
#  GENERATED by ~/.local/bin/nyxus-freeform — do not hand-edit.
#  Toggle with SUPER+ALT+T or `nyxus-freeform toggle`.
#
#  FREEFORM ON  → every new window opens floating, centered, at its
#                 natural size; you place and size it yourself and
#                 Hyprland remembers the size per app. No more
#                 half-screen splits or ever-shrinking tiles.
#  FREEFORM OFF → classic dwindle tiling (this file becomes inert).
#
#  Per-app rules in nyxus-hyprland-rules.conf still override these
#  catch-alls (they are sourced BEFORE this shard, and more-specific
#  size/move rules win at map time).
#
#  © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ============================================================'

is_on() { grep -q '^windowrule = float on' "${SHARD}" 2>/dev/null; }

write_on() {
  cat > "${SHARD}" <<EOF
${HEADER}

# ── FREEFORM: ON ────────────────────────────────────────────
windowrule = float on, match:class ^(.*)\$
windowrule = center on, match:class ^(.*)\$
windowrule = persistent_size on, match:class ^(.*)\$

# exceptions: the workspace-0 dashboard always fills its page
windowrule = float off, match:class ^(io\.nyxus\.home)\$
EOF
}

write_off() {
  cat > "${SHARD}" <<EOF
${HEADER}

# ── FREEFORM: OFF (classic dwindle tiling) ──────────────────
# no catch-all float rules active
EOF
}

case "${1:-toggle}" in
  status) is_on && echo freeform || echo tiling; exit 0 ;;
  on)     write_on;  MODE="Freeform" ;;
  off)    write_off; MODE="Tiling" ;;
  toggle) if is_on; then write_off; MODE="Tiling"; else write_on; MODE="Freeform"; fi ;;
  *) echo "usage: nyxus-freeform [on|off|toggle|status]" >&2; exit 1 ;;
esac

command -v hyprctl >/dev/null && timeout 5 hyprctl reload >/dev/null 2>&1 || true
command -v notify-send >/dev/null && \
  notify-send -a "NYXUS" -i preferences-system-windows \
    "Window mode: ${MODE}" \
    "$([ "${MODE}" = Freeform ] && echo 'New windows float — move and size them your way.' || echo 'New windows tile (dwindle).')" || true
echo "window mode: ${MODE}"
