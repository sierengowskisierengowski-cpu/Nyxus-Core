#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-home-deck  ·  rev 2026-07-27c
# Maps STATION -> eww window and keeps exactly the right one on screen.
#
#   HOME  -> home-deck    (scattered desktop widgets)
#   START -> start-panel  (the big Start panel that replaced the GTK app)
#   GHOST -> ghost-deck   (security console: defence, honeypots, exposure)
#   FORGE -> forge-deck   (build station: repo state, dirty/unpushed, PRs)
#   LAB   -> lab-deck     (home lab: VMs, live attackers, lab tools)
#
# eww windows are layer-shell surfaces: they are bound to a MONITOR, not a
# workspace, so they cannot hide themselves. This follows Hyprland's socket2
# event stream and opens/closes them on every workspace change.
#
# Name kept as nyxus-home-deck so the existing exec-once and the
# Super+Shift+Home bind keep working.
#
# TWO CORRECTNESS RULES, both learned from windows overlapping in practice:
#   1. SINGLETON. Two watchers fight each other - one opens what the other
#      just closed. flock makes a second instance exit immediately.
#   2. UNCONDITIONAL sync. The old code did `active-windows | grep -q` before
#      opening/closing. `eww active-windows` lags its own open/close, so a
#      fast station switch read stale state and left BOTH windows mapped.
#      `eww open` on an already-open window is a no-op and `eww close` on a
#      closed one is harmless, so just assert the desired state every time.
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"

# FIXED PATH, not $XDG_RUNTIME_DIR. That variable is set in a login shell but
# NOT in some exec-once/systemd contexts, so two instances resolved two
# DIFFERENT lock files, both acquired, and then fought - one opening the deck
# the other had just closed. That is the recurring "two decks at once" bug.
LOCK="${HOME}/.cache/nyxus-home-deck.lock"
mkdir -p "${HOME}/.cache"
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "another nyxus-home-deck already holds $LOCK - exiting" >&2
  exit 0
fi

HOME_STATION="${NYXUS_HOME_STATION:-HOME}"
START_STATION="${NYXUS_START_STATION:-START}"
GHOST_STATION="${NYXUS_GHOST_STATION:-GHOST}"
FORGE_STATION="${NYXUS_FORGE_STATION:-FORGE}"
LAB_STATION="${NYXUS_LAB_STATION:-LAB}"
# Numbered stations that now have dedicated decks (2026-07-29)
OPS_STATION="${NYXUS_OPS_STATION:-OPS}"
PULSE_STATION="${NYXUS_PULSE_STATION:-PULSE}"
WAVE_STATION="${NYXUS_WAVE_STATION:-WAVE}"
CORE_STATION="${NYXUS_CORE_STATION:-CORE}"
MESH_STATION="${NYXUS_MESH_STATION:-MESH}"
SCRIBE_STATION="${NYXUS_SCRIBE_STATION:-SCRIBE}"
ARSENAL_STATION="${NYXUS_ARSENAL_STATION:-ARSENAL}"

# station -> window. Adding a station means adding ONE line here.
# Declared ONCE at global scope, not rebuilt inside _sync: _sync runs on every
# workspace event, and the map is static.
declare -A MAP=(
  ["$HOME_STATION"]=home-deck
  ["$START_STATION"]=start-panel
  ["$GHOST_STATION"]=ghost-deck
  ["$FORGE_STATION"]=forge-deck
  ["$LAB_STATION"]=lab-deck
  ["$OPS_STATION"]=ops-deck
  ["$PULSE_STATION"]=pulse-deck
  ["$WAVE_STATION"]=wave-deck
  ["$CORE_STATION"]=core-deck
  ["$MESH_STATION"]=mesh-deck
  ["$SCRIBE_STATION"]=scribe-deck
  ["$ARSENAL_STATION"]=arsenal-deck
)

# NUMERIC ALIASES (2026-07-30). The bar's station pills dispatch by NUMBER
# (`hyprctl dispatch workspace 1`, eww.yuck station_pill) while this watcher
# looks the deck up by workspace NAME. That only lines up because
# nyxus-stations.conf carries `defaultName:OPS` on workspace 1 — one dropped or
# unsourced shard and every numbered station reports `.name` as "1".."10", no
# map entry matches, and _sync closes every deck and opens none. That is
# indistinguishable from "clicking a station does nothing", with no error
# anywhere. Alias the numbers to the same decks so the pills work even when the
# names are missing.
_STATIONS_JSON="${HOME}/.config/nyxus/stations.json"
if [[ -r "${_STATIONS_JSON}" ]] && command -v jq >/dev/null 2>&1; then
  while IFS=$'\t' read -r _sid _sname; do
    [[ -n "${_sid}" && -n "${_sname}" ]] || continue
    [[ -n "${MAP[$_sname]:-}" ]] && MAP["$_sid"]="${MAP[$_sname]}"
  done < <(jq -r '.stations[] | [(.id|tostring), .name] | @tsv' "${_STATIONS_JSON}" 2>/dev/null)
fi

_sync() {
  local ws
  ws="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // empty')"
  [[ -z "$ws" ]] && return 0

  local want="${MAP[$ws]:-}"

  # CLOSE EVERYTHING ELSE, THEN OPEN THE ONE WE WANT. Written as a loop over
  # the map rather than a branch per station: the hand-written version missed
  # `eww close lab-deck` in three of its five branches, which is exactly how
  # two decks ended up mapped at once before. A loop cannot forget one.
  # Assert unconditionally - never branch on `eww active-windows`, which lags
  # its own open/close and made fast station switches read stale state.
  local st win
  for st in "${!MAP[@]}"; do
    win="${MAP[$st]}"
    [[ "$win" == "$want" ]] && continue
    eww close "$win" >/dev/null 2>&1
  done
  [[ -n "$want" ]] && eww open "$want" >/dev/null 2>&1

  # the search overlay holds EXCLUSIVE keyboard - never leave it mapped once
  # the owner has navigated away from START
  [[ "$ws" == "$START_STATION" ]] || eww close start-search >/dev/null 2>&1

  # VERIFY. An `eww open` issued while the daemon is still bringing windows up
  # (e.g. right after `eww reload`, or early at login) is accepted and then
  # dropped, so the station looks empty. Confirm and retry once - this is the
  # failure the owner kept hitting ("I clicked HOME and it went to nothing").
  if [[ -n "$want" ]]; then
    if ! eww active-windows 2>/dev/null | grep -q "^${want}:"; then
      sleep 1
      eww open "$want" >/dev/null 2>&1
    fi
  fi
}

# settle first: eww may still be coming up at login
for _ in $(seq 1 30); do eww ping >/dev/null 2>&1 && break; sleep 1; done
_sync

# `set -u` is on. Both of these were referenced UNGUARDED, so an exec-once
# context missing either one killed the watcher right here — after the single
# startup _sync, so one deck was up and then no station ever changed anything
# again. The lock-file comment 80 lines up already warns that XDG_RUNTIME_DIR
# "is set in a login shell but NOT in some exec-once/systemd contexts"; that
# lesson never made it down to this line.
_RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
_HIS="${HYPRLAND_INSTANCE_SIGNATURE:-}"
if [[ -z "${_HIS}" ]]; then
  # Last resort: pick the newest live instance socket dir.
  _HIS="$(ls -1t "${_RUNDIR}/hypr" /tmp/hypr 2>/dev/null | grep -v ':$' | grep . | head -1)"
fi
SOCK="${_RUNDIR}/hypr/${_HIS}/.socket2.sock"
[[ -S "${SOCK}" ]] || SOCK="/tmp/hypr/${_HIS}/.socket2.sock"
if [[ -S "${SOCK}" ]] && command -v socat >/dev/null 2>&1; then
  socat -U - "UNIX-CONNECT:${SOCK}" | while read -r line; do
    case "${line}" in workspace\>*|focusedmon\>*) _sync ;; esac
  done
else
  # no socat -> cheap poll, still correct just less instant
  while sleep 1; do _sync; done
fi
