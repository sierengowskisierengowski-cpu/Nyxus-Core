#!/usr/bin/env bash
# =============================================================================
#  /usr/local/bin/nyxus-hyprpm-plugins         rev 2026-05-14 r2 (Sprint F)
#
#  Builds + enables Hyprland plugins (borders-plus-plus + hyprexpo) via
#  hyprpm at first user session. Triggered by the user systemd unit
#  /etc/skel/.config/systemd/user/nyxus-hyprpm-plugins.service which
#  Hyprland starts via `exec-once = systemctl --user start ...`.
#
#  WHY a user-context script (not /etc/nyxus-firstboot.d/):
#    - The system firstboot orchestrator runs as root at boot before any
#      Hyprland session exists. hyprctl needs $HYPRLAND_INSTANCE_SIGNATURE
#      from the user session, so the script would always exit early and
#      never retry (orchestrator writes its marker unconditionally).
#    - Running in the user session means hyprctl is reachable and the
#      plugin can be enabled live without a relogin.
#
#  SENTINEL POLICY:
#    - Sentinel ~/.config/nyxus/plugins.done is written ONLY when BOTH
#      plugins enable successfully. Partial / network failures leave the
#      sentinel absent so the next session retries. This fixes the
#      original draft which sentinel'd on every run.
#
#  © 2026 JOSEPH SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# =============================================================================
set -u

LOG="${HOME}/.cache/nyxus/hyprpm-plugins.log"
SENTINEL="${HOME}/.config/nyxus/plugins.done"
SHARD_SRC="${HOME}/.config/hypr/conf.d/nyxus-hyprland-plugins.conf"
mkdir -p "$(dirname "$LOG")" "$(dirname "$SENTINEL")"

log() { printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG" >&2; }

# Already done?
if [[ -f "$SENTINEL" ]]; then
    log "sentinel present — skipping (delete $SENTINEL to force rebuild)"
    exit 0
fi

# Hyprland actually running in this user session?
if ! command -v hyprctl >/dev/null 2>&1; then
    log "hyprctl not on PATH — not a Hyprland session, exiting"
    exit 0
fi
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    log "no HYPRLAND_INSTANCE_SIGNATURE — Hyprland not running, exiting"
    exit 0
fi
if ! hyprctl version >/dev/null 2>&1; then
    log "hyprctl can't talk to Hyprland — exiting"
    exit 0
fi

# hyprpm available?
if ! command -v hyprpm >/dev/null 2>&1; then
    log "hyprpm not found (Hyprland too old?) — exiting"
    exit 0
fi

# Network reachable? (hyprpm needs git clone + build)
if ! curl -sSf --max-time 5 https://github.com >/dev/null 2>&1; then
    log "no network — will retry next session"
    exit 0
fi

# Build deps reachable? (hyprpm needs cmake + meson + gcc)
for tool in cmake meson g++; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        log "build tool '$tool' missing — exiting (won't sentinel)"
        exit 0
    fi
done

log "fetching hyprland headers (hyprpm update)…"
if ! hyprpm update --no-shallow >>"$LOG" 2>&1; then
    log "hyprpm update FAILED — will retry next session"
    exit 0
fi

log "registering hyprwm/hyprland-plugins repo…"
hyprpm add https://github.com/hyprwm/hyprland-plugins >>"$LOG" 2>&1 || \
    log "  hyprpm add returned nonzero (likely already added) — continuing"

# Track success per-plugin so sentinel only writes on FULL success
ok_bpp=0
ok_expo=0

log "enabling borders-plus-plus…"
if hyprpm enable borders-plus-plus >>"$LOG" 2>&1; then
    log "  borders-plus-plus ✓"
    ok_bpp=1
else
    log "  borders-plus-plus FAILED to enable"
fi

log "enabling hyprexpo…"
if hyprpm enable hyprexpo >>"$LOG" 2>&1; then
    log "  hyprexpo ✓"
    ok_expo=1
else
    log "  hyprexpo FAILED to enable"
fi

log "reloading Hyprland to pick up plugin shard…"
hyprctl reload >>"$LOG" 2>&1 || true

if (( ok_bpp == 1 && ok_expo == 1 )); then
    date -Iseconds > "$SENTINEL"
    log "BOTH plugins enabled — sentinel written, install complete"
    exit 0
else
    log "partial failure (bpp=$ok_bpp expo=$ok_expo) — NO sentinel, will retry"
    exit 0
fi
