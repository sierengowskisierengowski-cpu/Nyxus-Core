#!/usr/bin/env bash
# NYXUS Settings — standalone launcher for the unified settings window.
# Note: we import _install_css from main.py so the standalone window gets
# the same DARK MIRROR theme (sidebar nav, hero header, Inter font, etc.)
# that it would inherit if launched from the Panel.
exec python3 -c '
import sys
sys.path.insert(0, "/home/cosmic/.nyxus/nyxus-panel")
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from settings import SettingsWindow, load_config
from main import _install_css

def _main():
    app = Gtk.Application(application_id="io.nyxus.settings")
    def _on_activate(a):
        # CSS must be installed AFTER a Gdk display exists (i.e. after
        # the GtkApplication is activated) so the StyleContext call has
        # a valid display target.
        _install_css(load_config())
        win = SettingsWindow()
        win.set_application(a)
        win.present()
    app.connect("activate", _on_activate)
    app.run(sys.argv)

_main()
' "$@"
