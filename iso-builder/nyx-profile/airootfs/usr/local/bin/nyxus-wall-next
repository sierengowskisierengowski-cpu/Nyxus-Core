#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-wall-next   ·   rev 2026-07-07 r1 (Signature)
#
# Cycle to a random wallpaper (never the current one) with the swww
# grow-from-cursor ripple; the accent follows automatically when
# accent.json has "follow_wallpaper": true. Bound to SUPER+ALT+W —
# each press is a full one-keystroke desktop re-theme.
#
# Pool: ~/.config/hypr/walls + /usr/share/backgrounds/nyxus (PNG/JPG,
# skips the bar/taskbar texture strips that are not real wallpapers).
#
# © 2026 JOSEPH SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:${PATH}"

CONF="${HOME}/.config/nyxus/wallpaper.conf"
CURRENT=""
[[ -r "${CONF}" ]] && CURRENT="$(grep -m1 '^WALLPAPER_PATH=' "${CONF}" | cut -d'"' -f2)"

mapfile -t POOL < <(
  find "${HOME}/.config/hypr/walls" /usr/share/backgrounds/nyxus \
       -maxdepth 1 -type f \( -name '*.png' -o -name '*.jpg' \) 2>/dev/null \
  | grep -vE '(bar-|taskbar|topbar|rightbar|-bg\.png$)' \
  | grep -vxF "${CURRENT}"
)

if [[ ${#POOL[@]} -eq 0 ]]; then
  notify-send -u critical "NYXUS Wallpaper" "No wallpapers found to cycle to" 2>/dev/null
  exit 1
fi

PICK="${POOL[RANDOM % ${#POOL[@]}]}"
exec nyxus-set-wallpaper "${PICK}"
