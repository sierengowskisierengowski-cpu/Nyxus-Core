* {
    bg-deep:   #05060a;
    bg-card:   #05060a;
    text-hi:   #eef2fa;
    text-lo:   rgba(238, 242, 250, 0.62);
    hairline:  rgba(255, 60, 172, 0.35);
    accent:    #ff3cac;
    glass-bg:  rgba(5, 6, 10, 0.88);
    glass-line: rgba(43, 210, 255, 0.35);

    background-color: transparent;
    text-color: @text-hi;
}

window {
    width: 560px;
    background-color: @glass-bg;
    border: 1px;
    border-color: @glass-line;
    border-radius: 10px;
    padding: 0;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: transparent;
    border: 0 0 1px 0;
    border-color: @hairline;
    padding: 12px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrains Mono Nerd Font Bold 12";
}

entry {
    text-color: @text-hi;
    placeholder: "type to search...";
    placeholder-color: @text-lo;
    font: "JetBrains Mono Nerd Font 12";
}

listview {
    background-color: transparent;
    padding: 6px;
    spacing: 2px;
    lines: 10;
    columns: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @text-hi;
    padding: 9px 12px;
    spacing: 10px;
    border-radius: 10px;
}

element selected.normal,
element selected.alternate.normal,
element selected.active,
element selected.urgent {
    background-color: @accent;
    text-color: #05060a;
    border-radius: 10px;
}

element-text {
    text-color: inherit;
    font: "JetBrains Mono Nerd Font 11";
}

element-icon {
    size: 22px;
}
