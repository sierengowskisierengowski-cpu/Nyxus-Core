#!/usr/bin/env python3
# NYXUS recovery gate - PAM helper for emergency login/unlock.
# Invoked via pam_exec (expose_authtok) on sddm + hyprlock stacks.
# Succeeds when the typed password matches /etc/nyxus/recovery.hash
# (registered by nyxus-recovery-register).
import os
import sys
import time
import pathlib

HASH_PATH = pathlib.Path("/etc/nyxus/recovery.hash")
FAILURE_DELAY_SECONDS = 1.0


def fail() -> None:
    time.sleep(FAILURE_DELAY_SECONDS)
    sys.exit(1)


def main() -> None:
    if os.environ.get("PAM_TYPE") != "auth":
        fail()

    try:
        typed = sys.stdin.buffer.read().rstrip(b"\n").rstrip(b"\x00")
    except Exception:
        fail()

    if not typed:
        fail()

    try:
        st = os.stat(HASH_PATH)
        if st.st_uid != 0 or (st.st_mode & 0o077):
            fail()
        stored_hash = HASH_PATH.read_bytes().strip()
    except (FileNotFoundError, PermissionError):
        fail()

    if not stored_hash.startswith(b"$2"):
        fail()

    try:
        import bcrypt
    except ImportError:
        fail()

    if bcrypt.checkpw(typed, stored_hash):
        sys.exit(0)

    fail()


if __name__ == "__main__":
    main()
