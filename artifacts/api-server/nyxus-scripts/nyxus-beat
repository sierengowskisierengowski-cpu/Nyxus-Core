#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-beat <on|off|toggle|status>   ·   rev 2026-07-07 r1 (Signature)
# Front door for the audio-reactive border daemon (nyxus-beatd).
# Bound: Super+Alt+B ("beat"). Quicksettings-friendly.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:${PATH}"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/nyxus-beatd.pid"

running() { [[ -r "${PIDFILE}" ]] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; }

start() {
  running && { echo "beat: already on"; return; }
  nohup nyxus-beatd >/dev/null 2>&1 &
  notify-send -u low -t 2200 "◤ NYXUS ◥ BEAT" "border ring is listening" 2>/dev/null
  echo "beat: on"
}

stop() {
  running || { echo "beat: already off"; return; }
  local pid; pid="$(cat "${PIDFILE}")"
  # bash defers the TERM trap while it waits on the cava pipeline, so
  # signal the children first — cava's exit unblocks the daemon, which
  # then runs its restore trap and exits.
  pkill -P "${pid}" 2>/dev/null
  kill "${pid}" 2>/dev/null
  notify-send -u low -t 2200 "◤ NYXUS ◥ BEAT" "border ring at rest" 2>/dev/null
  echo "beat: off"
}

case "${1:-toggle}" in
  on)     start ;;
  off)    stop ;;
  toggle) running && stop || start ;;
  status) running && echo on || echo off ;;
  *) echo "usage: nyxus-beat <on|off|toggle|status>" >&2; exit 2 ;;
esac
