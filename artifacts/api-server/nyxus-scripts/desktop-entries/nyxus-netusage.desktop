[Desktop Entry]
Type=Application
Name=NYXUS Network Usage
GenericName=Network Usage
Comment=Live per-interface upload/download rates and totals
Exec=/usr/local/bin/nyxus netusage
TryExec=/usr/local/bin/nyxus
Icon=network-wired
Terminal=false
Categories=System;Monitor;
Keywords=NYXUS;NYX;Network;Usage;Bandwidth;
StartupNotify=true
StartupWMClass=nyxus.netusage
X-NYXUS-Module=nyxus_netusage
