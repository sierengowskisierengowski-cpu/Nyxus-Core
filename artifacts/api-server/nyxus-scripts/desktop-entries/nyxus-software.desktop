[Desktop Entry]
Type=Application
Name=NYXUS Software Center
GenericName=Software Center
Comment=Browse, install, and update apps from pacman, AUR, and Flatpak
Exec=python3 /opt/nyxus/nyxus_store.py
TryExec=python3
Icon=system-software-install
Terminal=false
Categories=System;PackageManager;Settings;
Keywords=NYXUS;Software;Apps;Install;Store;Pacman;Flatpak;AUR;
StartupNotify=true
StartupWMClass=io.nyxus.store
X-NYXUS-Module=nyxus_store
