[Desktop Entry]
Type=Application
Name=NYXUS Notification Center
GenericName=Notification Center
Comment=Notification history, Do Not Disturb, and clear-all controls
Exec=python3 /opt/nyxus/nyxus_settings_notifications.py --drawer
TryExec=python3
Icon=nyxus-notification-center
Terminal=false
Categories=System;Settings;
Keywords=NYXUS;Notifications;Center;DND;History;
StartupNotify=true
StartupWMClass=com.nyxus.notifications
X-NYXUS-Module=nyxus_settings_notifications
