        "crouch"
      ],
      "fps": 1,
      "loop": false
    },
    "wave": {
      "frames": [
        "wave"
      ],
      "fps": 1,
      "loop": false
    },
    "peace": {
      "frames": [
        "peace"
      ],
      "fps": 1,
      "loop": false
    },
    "laugh": {
      "frames": [
        "laugh"
      ],
      "fps": 1,
      "loop": false
    },
    "sit": {
      "frames": [
        "sit"
      ],
      "fps": 1,
      "loop": true
