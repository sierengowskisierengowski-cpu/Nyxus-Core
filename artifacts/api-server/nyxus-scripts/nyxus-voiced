# ── logging ──────────────────────────────────────────────────────────

_LOG_FH = None


def _log(msg: str) -> None:
    global _LOG_FH
    line = f"[{time.strftime('%F %T')}] {msg}"
    try:
        if _LOG_FH is None:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            _LOG_FH = open(LOG_FILE, "a", buffering=1)
        _LOG_FH.write(line + "\n")
    except Exception:
        pass
    # Also echo to stderr for interactive/foreground runs, but NOT when
    # stderr is a file (the CLI redirects it into LOG_FILE when detached,
    # which would double every line).
    try:
        if sys.stderr.isatty():
            sys.stderr.write(line + "\n")
            sys.stderr.flush()
    except Exception:
        pass


