#!/usr/bin/env bash
# Axiom launcher — runs the PACKAGED AppImage.
#
# Axiom is an Electron app (unlike the GowskiNet consoles, which are Tauri
# shells). It must be PACKAGED to work: in production it resolves its API
# server from process.resourcesPath, which only exists inside the bundle -
# running electron against the workspace starts the window but no backend.
# electron-builder bundles artifacts/api-server/dist as an extraResource.
#
# Rebuild with:
#   cd ~/GowskiNet-Vault/Apps/AXIOM/artifacts/api-server && node build.mjs
#   cd ../desktop && node electron/build.mjs
#   node ../../node_modules/.pnpm/electron-builder@*/node_modules/electron-builder/cli.js \
#        --linux --config electron-builder.config.cjs
# (call electron-builder directly - the repo's root `preinstall` guard
#  rejects pnpm's own internal invocation, so `pnpm run` cannot drive it.)
set -euo pipefail
exec "$HOME/.local/bin/axiom-app" "$@"
