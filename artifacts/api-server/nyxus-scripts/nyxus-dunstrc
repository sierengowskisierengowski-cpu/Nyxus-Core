# NYXUS · dunst configuration · rev 2026-05-14 r3 (Sprint G)
#
# Locked rev r15 palette: triple-black ink + CREAM #f4ead5 only.
# NO purple, NO cyan, NO red — those were rev r12 holdovers that
# slipped past the Sprint E audit (frame_color #1f1b2c was purple,
# #e9e5f2 was purple-tinted white, #e8edf5 was banned cyan, #f87171
# was banned red).
#
# Critical-urgency notifications can't use red anymore, so we
# distinguish them with: (a) brighter cream foreground #fff8e0,
# (b) thicker frame_width = 3px, (c) zero timeout. Visual hierarchy
# achieved without breaking the locked palette.
#
# JetBrains Mono Nerd throughout. Sharp 3px corners. Top-right anchor.
# 6 simultaneous notifications. Urgency-aware timeouts.
#
# Reload: pkill -USR1 dunst   |   systemctl --user restart dunst

[global]
    monitor = 0
    follow = mouse

    width = (320, 460)
    height = (60, 220)
    origin = top-right
    offset = 18x80
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 240
    progress_bar_max_width = 420
    progress_bar_corner_radius = 3

    indicate_hidden = yes
    transparency = 4
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#1a1a1a"
    gap_size = 6
    separator_color = frame
    sort = yes

    font = JetBrainsMono Nerd Font 11
    line_height = 4
    markup = full
    format = "<b>%a · %s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 3
    icon_path = /usr/share/icons/NYXUS-Aurora/32x32/status/:/usr/share/icons/NYXUS-Aurora/32x32/devices/:/usr/share/icons/Adwaita/32x32/status/:/usr/share/icons/Adwaita/32x32/devices/:/usr/share/icons/hicolor/32x32/apps/

    sticky_history = yes
    history_length = 50

    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = NYXUS Notifications
    class = Dunst
    corner_radius = 3
    ignore_dbusclose = false

    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# ─── Urgency tiers — locked rev r15 palette only ─────────────────────
[urgency_low]
    background    = "#0a0a0a"
    foreground    = "#8a8068"
    frame_color   = "#1a1a1a"
    timeout       = 5
    default_icon  = dialog-information

[urgency_normal]
    background    = "#0a0a0a"
    foreground    = "#f4ead5"
    frame_color   = "#f4ead5"
    timeout       = 8
    override_pause_level = 30
    default_icon  = dialog-information

[urgency_critical]
    background    = "#0a0a0a"
    foreground    = "#fff8e0"
    # Sprint K-A rev r16: critical urgency frame is copper #b8865a so it
    # reads distinct from the cream-framed normal alerts WITHOUT using red.
    # Keep in sync with airootfs copy — verify-profile §15ad+parity guard.
    frame_color   = "#b8865a"
    frame_width   = 3
    timeout       = 0
    override_pause_level = 60
    default_icon  = dialog-warning

# ─── Per-app overrides — match NYXUS app classes (cream-only) ────────
[nyxus_terminal]
    appname     = nyxus-terminal
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"

[nyxus_settings]
    appname     = nyxus-settings
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"

[nyxus_control]
    appname     = nyxus-control
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"

[nyxus_doctor]
    appname     = nyxus-doctor
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"

[nyxus_updater]
    appname     = nyxus-updater
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"

[nyxus_sound]
    appname     = nyxus-sound
    foreground  = "#f4ead5"
    frame_color = "#f4ead5"
