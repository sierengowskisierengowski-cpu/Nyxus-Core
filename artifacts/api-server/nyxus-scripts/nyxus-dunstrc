# NYXUS dunst · Obsidian Prism (rev 2026-07-06)
# Palette: #7949f2 · #ff2667 · #26ffb7 · #ffb026

[global]
    monitor = 0
    follow = mouse

    width = (320, 460)
    height = (60, 220)
    origin = top-right
    offset = 18x80
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 2
    progress_bar_min_width = 240
    progress_bar_max_width = 420
    progress_bar_corner_radius = 5

    indicate_hidden = yes
    transparency = 4
    separator_height = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 3
    frame_color = "#7949f2cc"
    gap_size = 6
    separator_color = "#05060a"
    sort = yes

    font = "JetBrains Mono Nerd Font 11"
    line_height = 3
    markup = full
    format = "<b>%a · %s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 52
    max_icon_size = 96
    icon_corner_radius = 12
    icon_path = /home/cosmic/.local/share/nyxus/icons/:/usr/share/icons/Adwaita/32x32/status/:/usr/share/icons/Adwaita/32x32/devices/:/usr/share/icons/hicolor/32x32/apps/

    sticky_history = yes
    history_length = 50

    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = NYXUS · Obsidian Prism
    class = Dunst
    corner_radius = 12
    ignore_dbusclose = false

    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background    = "#05060af2"
    foreground    = "#eef2facc"
    frame_color   = "#26ffb7aa"
    timeout       = 5
    default_icon  = nyxus-notif-ufo

[urgency_normal]
    background    = "#05060af2"
    foreground    = "#eef2fa"
    frame_color   = "#7949f2cc"
    timeout       = 8
    override_pause_level = 30
    default_icon  = nyxus-notif-ufo

[urgency_critical]
    background    = "#0a0410f2"
    foreground    = "#ffffff"
    frame_color   = "#ff2667"
    timeout       = 0
    override_pause_level = 60
    default_icon  = nyxus-notif-ufo

# Forward every notification to the themed EWW UFO console popup and skip
# dunst's own plain popup. dunst still owns the dbus service + keeps history
# (notification center), so nothing breaks — remove this rule to fall back to
# dunst's native popups.
[nyxus-eww-popup]
    appname = "*"
    script = /home/cosmic/.local/bin/nyxus-notif-to-eww
    skip_display = true
