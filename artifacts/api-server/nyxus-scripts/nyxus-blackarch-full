#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-blackarch-full [--yes]   ·   rev 2026-07-17
#
# Installs the FULL BlackArch tool group (~2800 packages, tens of GB) on
# top of the curated set the ISO already ships. This is deliberately a
# post-boot, opt-in command — the ISO stays lean; anyone who wants
# "everything" runs this once on the installed system.
#
# Safe: refuses to run without an explicit confirmation, verifies the
# blackarch repo is wired first, and syncs the keyring before the pull.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u

RED=$'\e[1;31m'; GRN=$'\e[1;32m'; YEL=$'\e[1;33m'; RST=$'\e[0m'

if ! grep -q '^\[blackarch\]' /etc/pacman.conf 2>/dev/null; then
  echo "${RED}✗${RST} [blackarch] repo not configured in /etc/pacman.conf." >&2
  echo "  Add it with:" >&2
  echo "    echo -e '\\n[blackarch]\\nInclude = /etc/pacman.d/blackarch-mirrorlist' | sudo tee -a /etc/pacman.conf" >&2
  echo "    sudo pacman-key --populate blackarch" >&2
  exit 1
fi

cat <<EOF
${YEL}══════════════════════════════════════════════════════════════════${RST}
  ${YEL}NYXUS · BlackArch FULL install${RST}

  This installs the ENTIRE 'blackarch' package group:
    • ~2800 packages
    • tens of GB of disk + a very large download
    • many tools overlap; some conflict and will prompt for choices

  The NYXUS ISO already ships a curated ~67-tool BlackArch set. Only run
  this if you truly want the whole arsenal on this installed system.
${YEL}══════════════════════════════════════════════════════════════════${RST}
EOF

if [[ "${1:-}" != "--yes" ]]; then
  read -r -p "Type 'INSTALL EVERYTHING' to proceed: " confirm
  [[ "${confirm}" == "INSTALL EVERYTHING" ]] || { echo "Aborted."; exit 0; }
fi

echo "${GRN}▶${RST} refreshing databases + blackarch keyring…"
sudo pacman-key --populate blackarch 2>/dev/null || true
sudo pacman -Sy --needed --noconfirm blackarch-keyring blackarch-mirrorlist 2>/dev/null || true

echo "${GRN}▶${RST} installing the full 'blackarch' group (this will take a while)…"
sudo pacman -S --needed blackarch

echo "${GRN}✓${RST} BlackArch full install complete (or resumed). Re-run to finish if interrupted."
