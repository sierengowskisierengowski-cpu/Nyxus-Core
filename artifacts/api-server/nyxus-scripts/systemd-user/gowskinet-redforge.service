[Unit]
Description=GowskiNet RedForge — offensive-security workbench
# Mirrors gowskinet-forge.service, the app in the vault that was already
# finished. RedForge now serves its built SPA from the same Express process,
# so this single unit is the whole app - no vite dev server, no second port.
After=postgresql.service network-online.target
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/cosmic/GowskiNet-Vault/Security/RedForge/artifacts/api-server
EnvironmentFile=/home/cosmic/GowskiNet-Vault/Security/RedForge/.env
ExecStart=/usr/bin/node --enable-source-maps ./dist/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
