;; ==================================================================
;;  NYXUS - boot splash curtain (rev 2026-07-07 r1, Signature)
;;
;;  Fullscreen opaque overlay shown for the first ~3s of the session
;;  while the bars slide in behind it, then faded out (Hyprland
;;  layerrule animation on namespace "nyxus-splash"). Opened and
;;  closed ONLY by nyxus-eww-cinematic at startup.
;;
;;  (c) 2026 JOSEPH A. SIERENGOWSKI - NYX-J5W-2026-SIERENGOWSKI-LOCKED
;; ==================================================================

(defwidget splash_layout []
  (box :class "splash-root"
       :orientation "v"
       :space-evenly false
       :hexpand true
       :vexpand true
    ;; top-left session status over the top scrim
    (box :class "splash-topbar" :halign "start"
      (label :class "splash-status" :text "◈ NYXUS · HYPRLAND SESSION"))
    (box :vexpand true)
    ;; bottom scrim: tagline + boot line + copyright (the graffiti brand
    ;; art already carries the NYXUS HYPRLAND wordmark, so no big label)
    (box :class "splash-footer" :orientation "v" :space-evenly false :hexpand true :halign "fill"
      (label :class "splash-tag"  :halign "center" :wrap false :show-truncated false :text "ALIEN NEON · IRIDESCENT VOID")
      (label :class "splash-boot" :halign "center" :text "INITIALIZING SESSION …")
      (label :class "splash-foot" :halign "center" :text "© 2026 JOSEPH A. SIERENGOWSKI"))))

(defwindow nyxus-splash
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "nyxus-splash"
  (splash_layout))
