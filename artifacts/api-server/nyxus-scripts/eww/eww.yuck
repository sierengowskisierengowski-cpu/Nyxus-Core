;; ═════════════════════════════════════════════════════════════════════
;; WINDOWS
;; ═════════════════════════════════════════════════════════════════════

;; NOTE: the horizontal bars live on the BOTTOM layer-shell level
;; (:stacking "bottom") while the rails stay on top ("fg"). Hyprland
;; arranges levels background→bottom→top→overlay, applying exclusive
;; zones cumulatively, so the full-width bars are ALWAYS placed before
;; the rails' 66px side zones exist — x=0, true monitor width, every
;; time. When all four shared one level the arrangement followed
;; surface creation order, which reshuffles on every `eww reload` and
;; kept shoving the 1920px bars sideways (x=53, x=33, x=-33 — the
;; "bottom bar doesn't reach the left edge" bug). Do not put the
;; horizontal bars back on "fg".
;; The symmetric floating inset on both bars comes from the CSS margin
;; on .bar-bottom / .bar-top, NOT from a <100% surface width.


;; == HOME STATION DECK ================================================
;; Persistent desktop widgets pinned to the HOME workspace. This replaces
;; the nyxus-home GTK app, which built its grid fine but never painted
;; (see the DISABLED autostart note in hyprland.conf).
;;
;; LAYOUT (rev 2026-07-27, owner picked "loose scatter"): the cards are
;; deliberately NOT on a grid. Flexible (box :hexpand true) struts push
;; them apart while fixed-width shims bias each row left or right, so the
;; wallpaper's alien (x ~350-760) and the UFO (top right) stay visible
;; through the middle. Rows are separated by vexpand struts so the whole
;; set breathes over the full height instead of clustering in the centre.
;;
;; Every card reads an eww var the bars ALREADY poll, so the deck adds no
;; new polling cost.
;; Layer is "bottom": above the wallpaper, below real windows, so it reads
;; as part of the desktop and never steals focus or traps the screen.
;; Visibility is driven by nyxus-home-deck (a socket2 watcher) which opens
;; it on HOME and closes it everywhere else - layer-shell surfaces are
;; per-monitor, not per-workspace, so it cannot self-limit.

;; horizontal shim of a fixed width - biases a row left/right
(defwidget hshim [?w] (box :hexpand false :vexpand false :style "min-width: ${w ?: 40}px;"))
;; flexible struts - eat the remaining space and push cards apart
(defwidget hflex [] (box :hexpand true))
(defwidget vflex [] (box :vexpand true))

(defwidget deck_card [title ?glyph ?tone ?depth]
  ;; Bass-reactive rim so the deck breathes with the music like the rest of
  ;; the rig (boombox / reflex layer). Inline because CAVA_BASS interpolates.
  (box :class "nyxus-surface deck-card deck-card-${tone ?: 'violet'} deck-${depth ?: 'mid'}" :orientation "v"
       :style "box-shadow: inset 0 1px 0 rgba(255,255,255,0.14), 0 0 ${18 + CAVA_BASS / 3}px rgba(${SECSTATE.hacker == 'on' ? '255, 255, 255' : '125, 61, 255'}, ${0.20 + CAVA_BASS / 330}), 0 0 ${44 + CAVA_BASS}px rgba(${SECSTATE.hacker == 'on' ? '255, 45, 85' : '255, 45, 173'}, ${0.10 + CAVA_BASS / 520});"
       :space-evenly false :spacing 8 :valign "start" :hexpand false :vexpand false
    (box :class "deck-card-head" :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-card-glyph" :text {glyph ?: "◈"})
      (label :class "deck-card-title" :halign "start" :text title))
    (box :class "deck-card-body" :orientation "v" :space-evenly false :spacing 4
      (children))))

;; -- one metric column: big value over a small caps caption -----------
(defwidget deck_stat [val cap ?tone]
  (box :orientation "v" :space-evenly false :hexpand false
    (label :class "deck-big deck-big-${tone ?: 'green'}" :text val)
    (label :class "deck-sub" :text cap)))

;; ---------------------------------------------------------------- cards
(defwidget dcard_clock []
  (deck_card :title "CLOCK" :glyph "󰥔" :tone "pink" :depth "near"
    (box :orientation "h" :space-evenly false :spacing 7 :halign "start"
      (label :class "deck-clock" :text "${TIME.hm}")
      (label :class "deck-ampm" :valign "center" :text "${TIME.ampm}"))
    (label :class "deck-sub" :halign "start" :text "${TIME.date}")))

(defwidget dcard_weather []
  (deck_card :title "WEATHER" :glyph "󰖐" :tone "cyan" :depth "far"
    (label :class "deck-big deck-big-cyan" :halign "start" :text "${WEATHER.temp}")
    (label :class "deck-sub" :halign "start" :text "${WEATHER.summary}")
    (box :class "deck-rule" :height 1)
    (box :orientation "h" :space-evenly false :spacing 8 :halign "start"
      (label :class "deck-moon" :text "${MOON.glyph}")
      (label :class "deck-sub" :text "${MOON.name} ${MOON.pct}%"))))

(defwidget dcard_vitals []
  (deck_card :title "VITALS" :glyph "󰍛" :tone "green" :depth "mid"
    (box :orientation "h" :space-evenly false :spacing 18
      (deck_stat :val "${SYSGRAPH.cpu.val}%"  :cap "CPU")
      (deck_stat :val "${SYSGRAPH.mem.val}%"  :cap "RAM")
      (deck_stat :val "${SYSGRAPH.temp.val}°" :cap "TEMP"))
    (label :class "deck-spark" :halign "start" :text "${SYSGRAPH.cpu.spark}")))

(defwidget dcard_media []
  (deck_card :title "NOW PLAYING" :glyph "" :tone "pink" :depth "near"
    (label :class "deck-track" :halign "start" :limit-width 26 :text "${PLAYER.title}")
    (label :class "deck-sub" :halign "start" :limit-width 30 :text "${PLAYER.artist}")
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-time" :text "${PLAYER.pos}")
      (progress :class "deck-prog" :hexpand true :valign "center"
                :value {PLAYER.progress} :orientation "h")
      (label :class "deck-time" :text "${PLAYER.len}"))
    (box :orientation "h" :space-evenly false :spacing 8 :halign "start"
      (button :class "deck-btn deck-btn-sm" :onclick "playerctl previous &" :tooltip "Previous" "󰒮")
      (button :class "deck-btn deck-btn-sm" :onclick "playerctl play-pause &" :tooltip "Play / pause" "${PLAYER.icon}")
      (button :class "deck-btn deck-btn-sm" :onclick "playerctl next &" :tooltip "Next" "󰒭"))))

(defwidget dcard_network []
  (deck_card :title "NETWORK" :glyph "" :tone "blue" :depth "mid"
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-big deck-big-blue" :text "${NETGRAPH.ssid}")
      (label :class "deck-netglyph" :text "${NETGRAPH.icon}"))
    (label :class "deck-sub" :halign "start" :text "${BARTILES.ip}  gw ${BARTILES.gw}")
    (box :class "deck-rule" :height 1)
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "deck-sub" :text "↑ ${NETGRAPH.up_fmt}")
      (label :class "deck-sub" :text "↓ ${NETGRAPH.down_fmt}"))
    (label :class "deck-spark deck-spark-blue" :halign "start" :text "${NETGRAPH.down_spark}")))

(defwidget dcard_calendar []
  (deck_card :title "CALENDAR" :glyph "󰃭" :tone "violet" :depth "far"
    (label :class "deck-sub" :halign "start" :text "${CALENDAR.month}")
    (label :class "deck-cal" :halign "start" :text "${CALENDAR.grid}")))

(defwidget dcard_power []
  (deck_card :title "POWER" :glyph "" :tone "gold" :depth "far"
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "deck-big deck-big-gold" :text "${BATTERY.capacity}%")
      (label :class "deck-battglyph" :text "${BATTERY.icon}"))
    (label :class "deck-sub" :halign "start" :text "${BATTERY.status}")
    (box :class "deck-rule" :height 1)
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-sub" :text "PROFILE")
      (label :class "deck-sub deck-sub-hot" :text "${POWERPROF.label}"))))

(defwidget dcard_updates []
  (deck_card :title "SYSTEM" :glyph "" :tone "orange" :depth "mid"
    (box :orientation "h" :space-evenly false :spacing 18
      (deck_stat :val "${UPDATES.count}" :cap "UPDATES" :tone "orange")
      (deck_stat :val "${BARTILES.disk}%" :cap "DISK" :tone "orange"))
    (box :class "deck-rule" :height 1)
    (label :class "deck-sub" :halign "start" :text "${BARTILES.pkgs} pkgs · up ${BARTILES.up}")
    (label :class "deck-sub" :halign "start" :text "${BARTILES.host} · ${BARTILES.kern}")))

(defwidget dcard_notifs []
  (deck_card :title "ALERTS" :glyph "" :tone "pink" :depth "far"
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-big deck-big-pink" :text "${NOTIFLIST.total}")
      (label :class "deck-sub" :valign "center" :text "waiting"))
    (box :class "deck-rule" :height 1)
    ;; FIXED HEIGHT on purpose: an unbounded feed grows the whole deck
    ;; surface, and eww sizes the window to its content - a busy day would
    ;; push the top row back under bar-top. Scroll instead of grow.
    (scroll :height 52 :vscroll true :hscroll false
      (box :class "deck-feed" :orientation "v" :space-evenly false :spacing 3
        (for it in {NOTIFLIST.items}
          (label :class "deck-feed-line" :halign "start" :limit-width 30
                 :text "▸ ${it.summary}"))))))

(defwidget dcard_launch []
  (deck_card :title "LAUNCH" :glyph "󰀻" :tone "violet" :depth "near"
    (box :orientation "h" :space-evenly false :spacing 10
      (button :class "deck-btn" :onclick "hyprctl dispatch workspace name:START &" :tooltip "NYXUS Start" "󰣇")
      (button :class "deck-btn" :onclick "alacritty &" :tooltip "Terminal" "")
      (button :class "deck-btn" :onclick "firefox &" :tooltip "Browser" "")
      (button :class "deck-btn" :onclick "thunar &" :tooltip "Files" "")
      (button :class "deck-btn" :onclick "sh -c 'python3 ~/.nyxus/nyxus_notepad.py || nyxus-notepad' &" :tooltip "Notepad" ""))))

;; ---------------------------------------------------------------- deck
(defwidget home_deck []
  (box :class "deck-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}" :orientation "v" :space-evenly false :spacing 0
       :hexpand true :vexpand true
    ;; brand sits top-centre, above the scatter
    (label :class "deck-brand" :halign "center" :text "N Y X U S   ·   H O M E   S T A T I O N")
    (vflex)
    ;; The alien occupies x ~350-760 at full height, so the "inward" slots
    ;; are the sky band (x ~800-1250) and the city band (x ~1250-1800).
    ;; row 1 - clock near/left, weather far and pulled in off the corner
    (box :orientation "h" :space-evenly false :valign "start"
      (hshim :w 18) (dcard_clock) (hflex) (dcard_weather) (hshim :w 210))
    (vflex)
    ;; row 2 - media is the hero: near, big, dead centre of the sky band
    (box :orientation "h" :space-evenly false :valign "start"
      (hflex) (dcard_media) (hshim :w 430))
    (vflex)
    ;; row 3 - vitals left, network pulled inward from the right rail
    (box :orientation "h" :space-evenly false :valign "start"
      (hshim :w 34) (dcard_vitals) (hflex) (dcard_network) (hshim :w 150))
    (vflex)
    ;; row 4 - two FAR cards deep in the middle
    (box :orientation "h" :space-evenly false :valign "start"
      (hflex) (dcard_notifs) (hshim :w 250) (dcard_power) (hshim :w 300))
    (vflex)
    ;; row 5 - calendar far/left, launch near/centre, system mid inward.
    ;; LAUNCH shares this row rather than owning a sixth one: the surface
    ;; auto-sizes to content, and a 6th row pushed it past the 882px free
    ;; area (bar-top 40 + bar-bottom 158), which is what parked it at y=-15.
    (box :orientation "h" :space-evenly false :valign "end"
      (hshim :w 96) (dcard_calendar) (hshim :w 120) (dcard_launch)
      (hflex) (dcard_updates) (hshim :w 170))))

(defwindow home-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-home-deck"
  ;; HEIGHT MUST FIT THE FREE AREA. bar-top reserves 40px and bar-bottom
  ;; 158px, leaving 882px of 1080. A "100%" (=1080px) surface does not
  ;; shrink to fit - Hyprland centres it in the free area and parks it at
  ;; y=-59, which silently ate the brand line and slid the top row under
  ;; bar-top. A PERCENT height is not the free area either (eww resolved
  ;; "80%" to 959px, still 77px too tall) - so this is pinned in pixels.
  ;; (measured with `hyprctl layers -j`, 2026-07-27 - do not use 100%.)
  :geometry (geometry :x "0" :y "0" :width "98%" :height "846px" :anchor "center")
  (home_deck))

;; == START STATION PANEL ==============================================
;; One big eww widget replacing the nyxus-start GTK4 app. That app sat on
;; the OVERLAY layer with a single keyboard-dependent dismissal path, so
;; when it did not hold focus it could be neither closed nor moved - which
;; is exactly what happened to the owner. This window is layer "bottom" and
;; NEVER focusable, so it cannot trap anything.
;; Visibility: nyxus-home-deck watches socket2 and maps station -> window
;; (HOME -> home-deck, START -> start-panel).

(defwidget start_tile [name cmd glyph ?tagline]
  (button :class "start-tile" :onclick "${cmd} &" :tooltip "${tagline ?: name}"
    (box :orientation "v" :space-evenly false :spacing 5 :halign "center"
      (label :class "start-tile-glyph" :text glyph)
      (label :class "start-tile-name" :limit-width 13 :text name))))

(defwidget start_row [row]
  (box :orientation "h" :space-evenly false :spacing 9 :halign "start"
    (for a in {row.cells}
      (start_tile :name {a.name} :cmd {a.cmd} :glyph {a.glyph} :tagline {a.tagline}))))

(defwidget start_statchip [label value ok]
  (box :class "start-chip ${ok ? 'start-chip-ok' : 'start-chip-off'}"
       :orientation "h" :space-evenly false :spacing 8
    (label :class "start-chip-dot" :text "●")
    (label :class "start-chip-label" :text label)
    (label :class "start-chip-value" :hexpand true :halign "end" :text value)))

(defwidget start_action [glyph tip cmd ?tone]
  (button :class "start-action start-action-${tone ?: 'violet'}"
          :onclick cmd :tooltip tip glyph))

(defwidget start_panel []
  ;; Bass-reactive rim, same formula the boombox uses (CAVA_BASS 0-100).
  ;; Applied INLINE because the CSS compile strips background-size and the
  ;; scalar has to interpolate per frame anyway.
  (box :class "nyxus-surface start-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}" :orientation "v" :space-evenly false :spacing 12
       :style "border-color: rgba(${SECSTATE.hacker == 'on' ? '255, 255, 255' : '255, 45, 173'}, ${0.30 + CAVA_BASS / 260}); box-shadow: 0 0 ${SECSTATE.hacker == 'on' ? 0 : 30 + CAVA_BASS / 2}px rgba(125, 61, 255, ${0.22 + CAVA_BASS / 380}), 0 0 ${SECSTATE.hacker == 'on' ? 0 : 70 + CAVA_BASS}px rgba(255, 45, 173, ${0.10 + CAVA_BASS / 500});"
    ;; ---- header ------------------------------------------------------
    (box :class "start-head" :orientation "h" :space-evenly false :spacing 18
      (box :class "start-ident" :orientation "h" :space-evenly false :spacing 11
        (label :class "start-avatar" :text "${STARTMETA.user.initial}")
        (box :orientation "v" :space-evenly false :valign "center"
          (label :class "start-name" :halign "start" :text "${STARTMETA.user.name}")
          (label :class "start-role" :halign "start" :text "${STARTMETA.user.subtitle}")))
      ;; A GtkEntry would need keyboard focus, and on this layer focus is
      ;; EXCLUSIVE (see the window note), so search hands off to rofi - the
      ;; same launcher Super+Space already uses.
      (button :class "start-search" :hexpand true
              :onclick "eww update STARTQ='' && eww open start-search"
        (box :orientation "h" :space-evenly false :spacing 10
          (label :class "start-search-glyph" :text "")
          (label :class "start-search-text" :text "Search apps and commands")
          (box :hexpand true)
          (label :class "start-search-kbd" :text "click to search")))
      (box :orientation "v" :space-evenly false :valign "center"
        (label :class "start-clock" :halign "end" :text "${TIME.hm} ${TIME.ampm}")
        (label :class "start-date"  :halign "end" :text "${TIME.date}")))

    ;; ---- body --------------------------------------------------------
    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      (box :class "start-col" :orientation "v" :space-evenly false :spacing 8 :hexpand true
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "PINNED")
          (label :class "start-sec-hint" :halign "end" :text "${STARTMETA.pin_count} apps"))
        (box :orientation "v" :space-evenly false :spacing 9
          (for row in {STARTMETA.pin_rows} (start_row :row row)))
        (box :class "start-div" :height 1)
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "ALL APPS")
          (label :class "start-sec-hint" :halign "end" :text "${STARTMETA.app_total} installed . browse by category"))
        ;; Grouped into labelled category sections rather than one flat grid -
        ;; ~80 identical tiles in a row read as an undifferentiated wall.
        ;; Scrolls so a big catalogue cannot grow the surface past the 882px
        ;; free area between the bars (the trap that parked the home deck at y=-59).
        (scroll :vscroll true :hscroll false :vexpand true
          (box :orientation "v" :space-evenly false :spacing 16 :valign "start"
            (for sec in {STARTMETA.cat_sections}
              (box :class "start-cat-block" :orientation "v" :space-evenly false :spacing 7
                (box :orientation "h" :space-evenly false :spacing 9
                  (label :class "start-cat" :text {sec.label})
                  (label :class "start-cat-count" :text "${sec.count}")
                  (box :class "start-cat-rule" :hexpand true :valign "center" :height 1))
                (for row in {sec.rows} (start_row :row row)))))))

      ;; vertical rule so the app grid and the system column stop reading as
      ;; one cluttered field
      (box :class "start-vdiv" :width 1)

      ;; RIGHT COLUMN - deliberately NOT the machine vitals / weather /
      ;; media the HOME deck already carries. Duplicating those would make
      ;; the two stations interchangeable. This is launcher-context only:
      ;; what is running, where to go, what is pending.
      (box :class "start-col start-col-side" :orientation "v" :space-evenly false :spacing 8
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "RUNNING")
          (label :class "start-sec-hint" :halign "end" :text "${STARTLIVE.run_count} windows"))
        (scroll :class "start-scroll" :vscroll true :hscroll false :height 96
          (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
            (label :class "start-scratch-empty" :halign "start"
                   :visible {STARTLIVE.run_count == 0} :text "nothing open")
            (for w in {STARTLIVE.running}
              (button :class "start-win" :tooltip "${w.cls} on ${w.ws}"
                      :onclick "hyprctl dispatch focuswindow address:${w.addr} &"
                (box :orientation "h" :space-evenly false :spacing 8
                  (label :class "start-win-ws" :text {w.ws})
                  (label :class "start-win-title" :halign "start" :hexpand true
                         :limit-width 24 :text {w.title}))))))

        (box :class "start-div" :height 1)
        ;; RECENT, not ARSENAL: the toolkit moved to the GHOST security
        ;; station, which is where it belongs. Repeating the same panel on
        ;; every station is what made them feel interchangeable.
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "RECENT")
          (label :class "start-sec-hint" :halign "end" :text "last launched"))
        (scroll :class "start-scroll" :vscroll true :hscroll false :height 118
          (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
            (label :class "start-scratch-empty" :halign "start"
                   :visible {arraylength(STARTLIVE.recent) == 0} :text "nothing launched yet")
            (for r in {STARTLIVE.recent}
              (button :class "start-win" :onclick "${r.cmd} &" :tooltip {r.tagline}
                (box :orientation "h" :space-evenly false :spacing 8
                  (label :class "start-hit-glyph" :text {r.glyph})
                  (label :class "start-win-title" :halign "start" :hexpand true
                         :limit-width 24 :text {r.name}))))))

        (box :class "start-div" :height 1)
        (label :class "start-sec" :halign "start" :text "PLACES")
        (box :orientation "v" :space-evenly false :spacing 5
          (for prow in {STARTLIVE.place_rows}
            (box :orientation "h" :space-evenly true :spacing 5
              (for pl in {prow.cells}
                (button :class "start-place" :onclick "thunar ${pl.path} &" :tooltip {pl.path}
                  (box :orientation "h" :space-evenly false :spacing 7
                    (label :class "start-place-glyph" :text {pl.glyph})
                    (label :class "start-place-name" :halign "start" :text {pl.name})))))))

        (box :class "start-div" :height 1)
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "PENDING")
          (label :class "start-sec-hint" :halign "end" :text "checked ${UPDATESLIST.checked}"))
        (box :orientation "h" :space-evenly false :spacing 9
          (label :class "start-upd-count" :text "${UPDATES.count}")
          (box :orientation "v" :space-evenly false :valign "center" :hexpand true
            (label :class "start-scratch" :halign "start" :text "updates ready")
            (label :class "start-search-kbd" :halign "start" :text "${UPDATESLIST.source}")))

        (box :class "start-div" :height 1)
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "SCRATCHPAD")
          (button :class "start-edit-mini" :tooltip "Edit in notepad"
                  :onclick "sh -c 'python3 ~/.nyxus/nyxus_notepad.py || nyxus-notepad' &" ""))
        (scroll :vscroll true :hscroll false :vexpand true
          (box :orientation "v" :space-evenly false :spacing 4 :valign "start"
            (label :class "start-scratch-empty" :halign "start"
                   :visible {STARTMETA.scratch_empty} :text "nothing written yet")
            (for l in {STARTMETA.scratch}
              (label :class "start-scratch" :halign "start" :limit-width 30 :text l))))))

    ;; ---- action bar --------------------------------------------------
    (box :class "start-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph "󰣇" :tip "NYXUS Store"   :cmd "nyxus-store &"    :tone "pink")
      (start_action :glyph ""  :tip "Settings"      :cmd "nyxus-settings &" :tone "violet")
      (start_action :glyph ""  :tip "Files"         :cmd "thunar &"         :tone "gold")
      (start_action :glyph ""  :tip "Terminal"      :cmd "alacritty &"      :tone "cyan")
      (start_action :glyph ""  :tip "Notifications" :cmd "eww open --toggle notifications" :tone "cyan")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+Home  HOME     Super+End  START")
      (box :hexpand true)
      (start_action :glyph ""  :tip "Lock"          :cmd "hyprlock &"       :tone "blue")
      (start_action :glyph ""  :tip "Power menu"    :cmd "eww open --toggle powermenu" :tone "gold"))))

;; -- START search overlay ---------------------------------------------
;; A text field needs keyboard focus, and eww 0.5 only offers EXCLUSIVE
;; keyboard interactivity on a layer surface - so the search box lives in
;; its own SHORT-LIVED window instead of inside the panel. It takes the
;; keyboard only while it is open and closes itself on Enter or Escape.
;; Escape hatches that do NOT depend on this window: the station watcher
;; closes it whenever you leave START, and Super+Shift+S force-closes it.
(defwidget start_hit [name cmd glyph tagline]
  (button :class "start-hit"
          :onclick "${cmd} & eww update STARTQ='' && eww close start-search"
          :tooltip tagline
    (box :orientation "h" :space-evenly false :spacing 12
      (label :class "start-hit-glyph" :text glyph)
      (box :orientation "v" :space-evenly false :hexpand true :halign "start"
        (label :class "start-hit-name" :halign "start" :limit-width 46 :text name)
        (label :class "start-hit-sub"  :halign "start" :limit-width 56 :text tagline)))))

(defwidget start_search_overlay []
  (box :class "start-sroot" :orientation "v" :space-evenly false :spacing 10
    (box :orientation "h" :space-evenly false :spacing 12
      (label :class "start-search-glyph" :text "")
      (input :class "start-sinput" :hexpand true :value STARTQ
             :onchange "python3 ~/.config/eww/scripts/start-search.py {} &"
             :onaccept "python3 ~/.config/eww/scripts/start-search.py --run {} &")
      (button :class "start-sclose" :tooltip "Close (Esc)"
              :onclick "eww update STARTQ='' && eww close start-search" ""))
    (box :class "start-div" :height 1)
    (label :class "start-scratch-empty" :halign "start"
           :visible {STARTFOUND.n == 0} :text "start typing to search installed apps")
    (box :orientation "v" :space-evenly false :spacing 6
      (for r in {STARTFOUND.rows}
        (start_hit :name {r.name} :cmd {r.cmd} :glyph {r.glyph} :tagline {r.tagline})))))

(defwindow start-search
  :monitor 0 :stacking "overlay" :exclusive false :focusable true
  :namespace "nyxus-start-search"
  ;; Docked to the panel's search bar, not floating: the panel is 1660px
  ;; wide centred, so the bar spans roughly x 318..1622 (centre ~970, i.e.
  ;; +10 off screen centre) and its underside sits near y=150. Measured with
  ;; `hyprctl layers -j`, not eyeballed.
  :geometry (geometry :x "10px" :y "150px" :width "1300px" :height "420px" :anchor "top center")
  (start_search_overlay))

(defwindow start-panel
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  ;; FOCUSABLE MUST STAY FALSE. eww 0.5 exposes :focusable as a bool that maps
  ;; to wlr-layer-shell EXCLUSIVE keyboard interactivity - there is no
  ;; on-demand option in this version - so a focusable layer surface swallows
  ;; every keystroke session-wide. That reads exactly like a freeze, and it is
  ;; the same trap that made the old nyxus-start GTK app impossible to dismiss.
  :namespace "nyxus-start-panel"
  :geometry (geometry :x "0" :y "0" :width "1660px" :height "800px" :anchor "center")
  (start_panel))

;; == GHOST STATION DECK ===============================================
;; Security . Intel . Recon. Built entirely on the shared .nyxus-surface
;; language - a whole station for ~30 lines of its own CSS, which was the
;; point of that refactor.
;;
;; Every figure is PROBED LIVE by ghost-feed.py. When the honeypots have seen
;; nothing it reports zero rather than inventing activity, and "installed but
;; never run" scanners are shown as a finding rather than hidden - a security
;; console that flatters you is worse than no console.
;;
;; EVERY ROW IS A BUTTON. A read-only security panel makes you leave it to do
;; anything; each row opens the log, unit or tool behind the number it shows.

(defwidget ghost_card [title ?glyph ?tone ?hint ?fill]
  ;; `fill` lets a card take the height it is given instead of hugging its
  ;; content - without it a scroll inside collapses to a single row.
  (box :class "nyxus-surface deck-card deck-card-${tone ?: 'green'} deck-mid"
       :orientation "v" :space-evenly false :spacing 7
       :valign {fill ? "fill" : "start"} :vexpand {fill ?: false} :hexpand true
       :style "box-shadow: inset 0 1px 0 rgba(255,255,255,0.14), 0 0 ${16 + CAVA_BASS / 3}px rgba(${SECSTATE.hacker == 'on' ? '255, 255, 255' : '125, 61, 255'}, ${0.18 + CAVA_BASS / 340});"
    (box :class "deck-card-head" :orientation "h" :space-evenly false :spacing 8
      (label :class "deck-card-glyph" :text {glyph ?: "◈"})
      (label :class "deck-card-title" :halign "start" :hexpand true :text title)
      (label :class "gh-hint" :text {hint ?: ""}))
    (box :class "deck-card-body" :orientation "v" :space-evenly false :spacing 5
         :vexpand {fill ?: false}
      (children))))

;; one clickable status row: dot + name + state, opens `cmd`
(defwidget ghost_row [name ok cmd ?tip ?state]
  (button :class "gh-row ${ok ? 'gh-row-ok' : 'gh-row-down'}"
          :onclick cmd :tooltip {tip ?: "open ${name}"}
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "gh-dot" :text "●")
      (label :class "gh-name" :halign "start" :hexpand true :text name)
      (label :class "gh-state" :text {state ?: (ok ? "live" : "down")}))))

;; a big number that is itself a button
(defwidget ghost_stat [val cap cmd ?tone ?tip]
  (button :class "gh-stat" :onclick cmd :tooltip {tip ?: cap}
    (box :orientation "v" :space-evenly false :spacing 1
      (label :class "gh-big gh-big-${tone ?: 'ok'}" :halign "start" :text val)
      (label :class "deck-sub" :halign "start" :text cap))))

(defwidget ghost_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}" :orientation "v" :space-evenly false :spacing 8
    (label :class "deck-brand" :halign "center"
           :text "G H O S T   ·   S E C U R I T Y   S T A T I O N")

    (box :orientation "h" :space-evenly true :spacing 12 :valign "start"
      ;; ---- column 1 : posture + defence daemons -------------------
      (box :orientation "v" :space-evenly false :spacing 10 :hexpand true
        (ghost_card :title "THREAT STATE" :glyph "" :tone "green" :hint "click to arm"
          (button :class "gh-posture-btn" :tooltip "Toggle hacker mode"
                  :onclick "sh -c 'nyxus-hacker-mode $([ \"$(nyxus-hacker-mode status)\" = on ] && echo off || echo on)' &"
            (label :class "gh-posture gh-posture-${GHOST_.state.tone}" :halign "start"
                   :text {GHOST_.state.label}))
          (box :orientation "h" :space-evenly true :spacing 6
            (button :class "gh-chip" :tooltip "Toggle hacker mode"
                    :onclick "sh -c 'nyxus-hacker-mode $([ \"$(nyxus-hacker-mode status)\" = on ] && echo off || echo on)' &"
              "HACKER ${GHOST_.state.hacker ? 'ON' : 'off'}")
            (button :class "gh-chip" :tooltip "Toggle ghost mode"
                    :onclick "sh -c 'nyxus-ghost $([ \"$(nyxus-ghost status)\" = on ] && echo off || echo on)' &"
              "GHOST ${GHOST_.state.ghost ? 'ON' : 'off'}")
            (button :class "gh-chip gh-chip-hot" :tooltip "PANIC - lock everything down"
                    :onclick "nyxus-panic on &"
              "PANIC")))
        (ghost_card :title "DEFENSE" :glyph "" :tone "cyan" :hint "daemons"
          ;; a (for) cannot be passed straight into a defwidget slot - eww
          ;; requires a container - so each loop is wrapped in a box.
          (box :orientation "v" :space-evenly false :spacing 5
            (for d in {GHOST_.defense}
              (ghost_row :name {d.name} :ok {d.ok} :tip "follow ${d.name} journal"
                         :cmd "kitty --title ${d.name} -e sh -c 'journalctl ${d.jargs} -n 200 -f; read _' &"))))
        (ghost_card :title "SESSIONS" :glyph "" :tone "violet" :hint "logged in"
          (ghost_stat :val "${GHOST_.sessions.count}" :cap "${GHOST_.sessions.who}"
                      :tone "ok" :tip "who is logged in"
                      :cmd "kitty --title Sessions -e sh -c 'who -a; echo; last -n 20; read _' &")))

      ;; ---- column 2 : honeypot stack ------------------------------
      (box :orientation "v" :space-evenly false :spacing 10 :hexpand true
        (ghost_card :title "HONEYPOT STACK" :glyph "" :tone "gold"
                    :hint "${GHOST_.pots_up}/${GHOST_.pots_total} up"
          ;; scrolled: ten rows is the tallest block in the deck and pushed
          ;; the surface past the 882px gap once HONEYHIVE landed
          (scroll :class "start-scroll" :vscroll true :hscroll false :height 196
            (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
              (for pot in {GHOST_.pots}
                (ghost_row :name {pot.name} :ok {pot.ok} :tip "tail ${pot.name} logs"
                           :cmd "kitty --title ${pot.name} -e sh -c 'docker logs -f --tail 200 ${pot.name}; read _' &"))))))

      ;; ---- column 3 : attack feed + exposure ----------------------
      (box :orientation "v" :space-evenly false :spacing 10 :hexpand true
        ;; HONEYHIVE - the live attacker map's own API, not a log scrape.
        ;; eww cannot embed the Leaflet map, so the deck renders the same
        ;; data natively and the card opens the real map on click.
        (ghost_card :title "HONEYHIVE" :glyph "" :tone "pink"
                    :hint {GHOST_.hive.up ? "live . click for map" : "hive down"}
          (box :orientation "h" :space-evenly true :spacing 8
            (ghost_stat :val "${GHOST_.hive.h1}" :cap "hits 1h"
                        :tone {GHOST_.hive.h1 > 0 ? "hot" : "ok"} :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${GHOST_.hive.ips}" :cap "src ips" :tone "warn"
                        :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${GHOST_.hive.countries}" :cap "countries" :tone "ok"
                        :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &"))
          (box :class "deck-rule" :height 1)
          (label :class "deck-sub" :halign "start"
                 :visible {GHOST_.hive.quiet} :text "no events recorded yet")
          (box :orientation "v" :space-evenly false :spacing 3
            (for h in {GHOST_.hive.rows}
              (button :class "gh-hive" :tooltip "${h.pot} . ${h.kind} . ${h.country}"
                      :onclick "xdg-open http://localhost:8888 &"
                (box :orientation "h" :space-evenly false :spacing 8
                  (label :class "gh-hive-ip" :halign "start" :hexpand true :text {h.ip})
                  (label :class "gh-hive-meta" :text "${h.proto}:${h.port}")
                  (label :class "gh-hive-pot" :text {h.pot}))))))
        (ghost_card :title "EXPOSURE" :glyph "" :tone "blue" :hint "listening"
          (ghost_stat :val "${GHOST_.exposure.count}" :cap "open ports" :tone "warn"
                      :tip "list listening sockets"
                      :cmd "kitty --title Exposure -e sh -c 'ss -tulnp; echo; read _' &")
          (box :class "deck-rule" :height 1)
          (label :class "gh-ports" :halign "start" :wrap true
                 :text "${GHOST_.exposure.ports_str}"))
        (ghost_card :title "FIREWALL" :glyph "" :tone "green"
                    :hint "${GHOST_.firewall.bridges} bridges"
          (ghost_row :name "ufw" :ok {GHOST_.firewall.ufw} :tip "ufw status (asks for root)"
                     :state {GHOST_.firewall.ufw ? "active" : "down"}
                     :cmd "kitty --title Firewall -e sh -c 'sudo ufw status verbose; echo; read _' &")))

      ;; ---- column 4 : connections, auth, scanners -----------------
      (box :orientation "v" :space-evenly false :spacing 10 :hexpand true
        (ghost_card :title "CONNECTIONS" :glyph "" :tone "cyan"
                    :hint "${GHOST_.conns.foreign} remote"
          (ghost_stat :val "${GHOST_.conns.count}" :cap "established" :tone "ok"
                      :tip "live socket table"
                      :cmd "kitty --title Connections -e sh -c 'ss -tnp state established; echo; read _' &")
          (box :class "deck-rule" :height 1)
          (label :class "gh-ports" :halign "start" :wrap true :text "${GHOST_.conns.top}"))
        (ghost_card :title "AUTH" :glyph "" :tone "violet" :hint "24h"
          (ghost_stat :val "${GHOST_.auth.failed}" :cap "failed logins"
                      :tone {GHOST_.auth.failed > 0 ? "hot" : "ok"} :tip "auth journal"
                      :cmd "kitty --title Auth -e sh -c 'journalctl --since \"24 hours ago\" | grep -iE \"authentication failure|failed password|invalid user\" | tail -80; echo; read _' &"))
        (ghost_card :title "SCANNERS" :glyph "" :tone "orange"
                    :hint {GHOST_.scanners.stale ? "never run" : "ready"}
          (ghost_row :name "rkhunter" :ok {GHOST_.scanners.rk_run}
                     :state {GHOST_.scanners.rk ? (GHOST_.scanners.rk_run ? "run" : "never") : "absent"}
                     :tip "run a rootkit check"
                     :cmd "kitty --title rkhunter -e sh -c 'sudo rkhunter --check --sk; read _' &")
          (ghost_row :name "clamav" :ok {GHOST_.scanners.cl_db}
                     :state {GHOST_.scanners.cl ? (GHOST_.scanners.cl_db ? "db ok" : "no db") : "absent"}
                     :tip "update signatures then scan $HOME"
                     :cmd "kitty --title clamav -e sh -c 'sudo freshclam; clamscan -ri $HOME; read _' &"))))

    ;; ---- lower band: the whole toolkit + what broke -----------------
    ;; Lives in space the columns were already reserving (they valign to the
    ;; top), so it costs no extra window height - which matters, because the
    ;; surface must stay inside the 882px gap between the bars.
    (box :orientation "h" :space-evenly false :spacing 12 :vexpand true
      ;; ARSENAL is the centrepiece down here: all 14 tools, four categories
      ;; side by side, each one launchable.
      (box :orientation "v" :space-evenly false :hexpand false :vexpand true
        (ghost_card :title "ARSENAL" :glyph "" :tone "cyan" :fill true
                    :hint "${GHOST_.arsenal.live}/${GHOST_.arsenal.total} live . click to launch"
          ;; space-evenly stretched the four categories across the whole card
          ;; and left big gaps between them - natural widths, left-aligned,
          ;; with the tool buttons on a fixed width instead.
          (box :orientation "h" :space-evenly false :spacing 16 :valign "start"
               :halign "start" :vexpand true
            (for g in {GHOST_.arsenal.groups}
              (box :orientation "v" :space-evenly false :spacing 4
                   :hexpand false :valign "start"
                (label :class "gh-cat" :halign "start" :text {g.label})
                (for t in {g.items}
                  (button :class "gh-tool gh-tool-${t.state}" :tooltip {t.desc}
                          :onclick "${t.launch} &"
                    (box :orientation "h" :space-evenly false :spacing 7
                      (label :class "gh-dot" :text "●")
                      (label :class "gh-name" :halign "start"
                             :limit-width 18 :text {t.name})))))))))

      (box :orientation "v" :space-evenly false :spacing 12 :vexpand true
           :style "min-width: 320px;"
        (ghost_card :title "FAILED UNITS" :glyph "" :tone "orange"
                    :hint {GHOST_.units.clean ? "all clean" : "needs a look"}
          (ghost_stat :val "${GHOST_.units.count}" :cap "failed"
                      :tone {GHOST_.units.clean ? "ok" : "warn"} :tip "systemctl --failed"
                      :cmd "kitty --title Failed -e sh -c 'systemctl --failed; echo; systemctl --user --failed; echo; read _' &")
          (box :orientation "v" :space-evenly false :spacing 3
            (for u in {GHOST_.units.rows}
              (label :class "gh-feed" :halign "start" :limit-width 30 :text "▸ ${u.name}"))))
        (ghost_card :title "EVENTS" :glyph "" :tone "pink" :hint "journal 24h" :fill true
          (ghost_stat :val "${GHOST_.events.count}"
                      :cap {GHOST_.events.quiet ? "nothing flagged" : "sudo / ssh / denied"}
                      :tone {GHOST_.events.quiet ? "ok" : "warn"} :tip "open the security journal"
                      :cmd "kitty --title Events -e sh -c 'journalctl --since \"24 hours ago\" | grep -iE \"sudo:|sshd|denied|refused|segfault|audit\" | tail -100; echo; read _' &")
          (box :orientation "v" :space-evenly false :spacing 3
            (for e in {GHOST_.events.recent}
              (label :class "gh-feed" :halign "start" :limit-width 32 :text "▸ ${e.line}"))))))

    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (button :class "start-action start-action-cyan" :tooltip "Arsenal hub"
              :onclick "kitty --title Arsenal -e arsenal &" "")
      (button :class "start-action start-action-gold" :tooltip "Grafana dashboards"
              :onclick "xdg-open http://localhost:3000 &" "")
      (button :class "start-action start-action-pink" :tooltip "NYXUS Security"
              :onclick "sh -c 'command -v nyxus-security >/dev/null && nyxus-security || python3 ~/.nyxus/nyxus_security.py' &" "")
      (button :class "start-action start-action-violet" :tooltip "Honeypot compose status"
              :onclick "kitty --title Honeypot -e sh -c 'cd ~/Projects/honeypot && docker compose ps; echo; exec bash' &" "")
      (box :hexpand true)
      (label :class "start-hint" :valign "center"
             :text "Super+3  GHOST     every row opens its log or tool     probes refresh 15s"))))

(defwindow ghost-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-ghost-deck"
  ;; must fit the 882px free area between the bars - verify with
  ;; `hyprctl layers -j`, never by eye (see the home-deck y=-59 note)
  :geometry (geometry :x "0" :y "0" :width "1780px" :height "770px" :anchor "center")
  (ghost_deck))

;; == FORGE STATION DECK ===============================================
;; Build . Code . Ship. Fourth station, same shared .nyxus-surface language.
;;
;; Repo state across ~/Projects. `git status` over ~20 repos is far too slow
;; for a poll, so forge-feed.py CACHES for 60s (cold 1.2s -> warm 0.03s) -
;; the same lesson the START app catalogue taught when it froze the search
;; box by rescanning on every keystroke.
;;
;; Every row opens that repo: click = editor, right-click = terminal there.

(defwidget forge_repo [r]
  (eventbox :class "fg-repo-box"
    (button :class "fg-repo ${r.clean ? 'fg-repo-clean' : 'fg-repo-dirty'}"
            :onclick "cursor ${r.path} &"
            :tooltip "${r.subject}  .  click: editor"
      (box :orientation "v" :space-evenly false :spacing 6
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "fg-name" :halign "start" :hexpand true :text {r.name})
          (label :class "fg-dirty" :visible {r.dirty > 0} :text "${r.dirty}")
          (label :class "fg-ahead" :visible {r.ahead > 0} :text "${r.ahead}↑"))
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "fg-branch" :halign "start" :hexpand true :text {r.branch})
          (label :class "fg-when" :text {r.when}))))))

(defwidget forge_mini [r]
  (button :class "fg-mini" :onclick "kitty --title ${r.name} -e sh -c 'cd ${r.path} && git status && exec bash' &"
          :tooltip "${r.path}  .  open a shell there"
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "fg-name" :halign "start" :hexpand true :limit-width 18 :text {r.name})
      (label :class "fg-dirty" :text "${r.dirty}"))))

(defwidget forge_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}" :orientation "v" :space-evenly false :spacing 16
    (label :class "deck-brand" :halign "center"
           :text "F O R G E   ·   B U I L D   S T A T I O N")

    (box :orientation "h" :space-evenly false :spacing 18 :vexpand true
      ;; ---- active repos ------------------------------------------
      (ghost_card :title "REPOS" :glyph "" :tone "violet" :fill true
                  :hint "${FORGE_.total} tracked . newest first . click to open"
        (scroll :class "start-scroll" :vscroll true :hscroll false :vexpand true
          (box :orientation "v" :space-evenly false :spacing 10 :valign "start"
            (label :class "start-scratch-empty" :halign "start"
                   :visible {FORGE_.total == 0} :text "no git repos under ~/Projects")
            (for r in {FORGE_.repos} (forge_repo :r r)))))

      ;; ---- what needs attention ----------------------------------
      (box :orientation "v" :space-evenly false :spacing 16 :style "min-width: 340px;"
        (ghost_card :title "UNCOMMITTED" :glyph "" :tone "orange"
                    :hint {FORGE_.dirty > 0 ? "needs a commit" : "all clean"}
          (ghost_stat :val "${FORGE_.dirty}" :cap "dirty repos"
                      :tone {FORGE_.dirty > 0 ? "warn" : "ok"}
                      :tip "repos with uncommitted changes"
                      :cmd "kitty --title Dirty -e sh -c 'for d in ~/Projects/*/; do [ -d \"$d/.git\" ] || continue; n=$(git -C \"$d\" status --porcelain | wc -l); [ \"$n\" -gt 0 ] && printf \"%-28s %s\\n\" \"$(basename $d)\" \"$n\"; done; echo; read _' &")
          (box :orientation "v" :space-evenly false :spacing 7
            (for r in {FORGE_.dirty_rows} (forge_mini :r r))))

        (ghost_card :title "UNPUSHED" :glyph "" :tone "gold"
                    :hint {FORGE_.unpushed > 0 ? "ahead of remote" : "in sync"}
          (ghost_stat :val "${FORGE_.unpushed}" :cap "ahead of origin"
                      :tone {FORGE_.unpushed > 0 ? "warn" : "ok"}
                      :tip "commits not on the remote"
                      :cmd "kitty --title Unpushed -e sh -c 'for d in ~/Projects/*/; do [ -d \"$d/.git\" ] || continue; a=$(git -C \"$d\" rev-list --count @{u}..HEAD 2>/dev/null || echo 0); [ \"$a\" -gt 0 ] && printf \"%-28s +%s\\n\" \"$(basename $d)\" \"$a\"; done; echo; read _' &")
          (box :orientation "v" :space-evenly false :spacing 7
            (for r in {FORGE_.unpushed_rows} (forge_mini :r r))))

        (ghost_card :title "PULL REQUESTS" :glyph "" :tone "cyan" :fill true
                    :hint "open . yours"
          (label :class "start-scratch-empty" :halign "start"
                 :visible {arraylength(FORGE_.prs) == 0} :text "none open")
          (box :orientation "v" :space-evenly false :spacing 4
            (for pr in {FORGE_.prs}
              (button :class "fg-mini" :onclick "gh pr view ${pr.n} --web &"
                      :tooltip {pr.title}
                (box :orientation "h" :space-evenly false :spacing 8
                  (label :class "fg-branch" :text "#${pr.n}")
                  (label :class "fg-name" :halign "start" :hexpand true
                         :limit-width 20 :text {pr.title}))))))))

    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph "" :tip "Editor"    :cmd "cursor &"                       :tone "violet")
      (start_action :glyph "" :tip "Terminal in ~/Projects"
                    :cmd "kitty --title Projects -e sh -c 'cd ~/Projects && exec bash' &"  :tone "cyan")
      (start_action :glyph ""  :tip "Browse ~/Projects" :cmd "thunar ~/Projects &"     :tone "gold")
      (box :hexpand true)
      (label :class "start-hint" :valign "center"
             :text "Super+2  FORGE     click a repo to open it     refreshed every 30s"))))

(defwindow forge-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-forge-deck"
  ;; must fit the 882px free area - verify with `hyprctl layers -j`
  :geometry (geometry :x "0" :y "0" :width "1560px" :height "740px" :anchor "center")
  (forge_deck))

;; == LAB STATION DECK =================================================
;; Home lab: the VirtualBox guests, the live attacker view off the
;; honeypots, and the tools for working them - all in one place so opening
;; the station gives you the whole lab.
;;
;; The attacker feed comes from the SAME HoneyHive API the GHOST deck uses
;; (one source, not a second scraper). lab-attacker is the box you drive;
;; the bifrost-* guests are what it hits.

(defwidget lab_vm [v]
  (box :class "nyxus-surface lab-vm ${v.on ? 'lab-vm-on' : (v.aborted ? 'lab-vm-bad' : 'lab-vm-off')}"
       :orientation "v" :space-evenly false :spacing 6
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "lab-dot" :text "●")
      (label :class "lab-name" :halign "start" :hexpand true :text {v.name})
      (label :class "lab-role" :text {v.role}))
    (label :class "lab-note" :halign "start" :text {v.note})
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "lab-meta" :hexpand true :halign "start"
             :text "${v.os}  ·  ${v.mem}  ·  ${v.net}${v.snaps > 0 ? '  ·  ' + v.snaps + ' snap' : ''}")
      (label :class "lab-state" :text {v.state}))
    (box :orientation "h" :space-evenly false :spacing 7
      (button :class "lab-btn lab-btn-go" :visible {!v.on}
              :tooltip "Boot ${v.name} with a console window"
              :onclick "VBoxManage startvm ${v.name} --type gui &" "start")
      (button :class "lab-btn" :visible {v.on}
              :tooltip "Send ACPI shutdown to ${v.name}"
              :onclick "VBoxManage controlvm ${v.name} acpipowerbutton &" "shut down")
      (button :class "lab-btn" :visible {v.on}
              :tooltip "Save state and stop"
              :onclick "VBoxManage controlvm ${v.name} savestate &" "save")
      (button :class "lab-btn" :visible {v.aborted}
              :tooltip "Clear the aborted state"
              :onclick "VBoxManage discardstate ${v.name} &" "reset")
      (button :class "lab-btn" :tooltip "Snapshots for ${v.name}"
              :onclick "kitty --title ${v.name} -e sh -c 'VBoxManage snapshot ${v.name} list; echo; read _' &" "snaps"))))

(defwidget lab_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}" :orientation "v" :space-evenly false :spacing 14
    (label :class "deck-brand" :halign "center"
           :text "L A B   ·   H O M E   L A B   S T A T I O N")

    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ---- the guests ---------------------------------------------
      (box :orientation "v" :space-evenly false :spacing 10 :hexpand true
        (box :orientation "h" :space-evenly false
          (label :class "start-sec" :halign "start" :hexpand true :text "VIRTUAL MACHINES")
          (label :class "start-sec-hint" :halign "end" :text "${LAB_.vms_up} running"))
        (box :orientation "v" :space-evenly false :spacing 10
          (for v in {LAB_.vms} (lab_vm :v v)))
        (ghost_card :title "LAB NETWORK" :glyph "" :tone "blue"
                    :hint {LAB_.net.up ? "up" : "down"}
          (box :orientation "h" :space-evenly false :spacing 10
            (label :class "gh-big gh-big-${LAB_.net.up ? 'ok' : 'warn'}" :text {LAB_.net.iface})
            (box :orientation "v" :space-evenly false :valign "center" :hexpand true
              (label :class "deck-sub" :halign "start" :text {LAB_.net.ip})
              (label :class "start-search-kbd" :halign "start"
                     :text {LAB_.net.up ? "host-only . guests reachable" : "host-only . bring it up to reach guests"})))))

      ;; ---- live attackers -----------------------------------------
      (box :orientation "v" :space-evenly false :spacing 10 :style "min-width: 470px;"
        (ghost_card :title "LIVE ATTACKERS" :glyph "" :tone "pink" :fill true
                    :hint {LAB_.attack.up ? "honeyhive . click for map" : "hive down"}
          (box :orientation "h" :space-evenly true :spacing 8
            (ghost_stat :val "${LAB_.attack.h1}" :cap "hits 1h"
                        :tone {LAB_.attack.h1 > 0 ? "hot" : "ok"}
                        :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${LAB_.attack.ips}" :cap "src ips" :tone "warn"
                        :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${LAB_.attack.total}" :cap "total" :tone "ok"
                        :tip "open the HoneyHive map"
                        :cmd "xdg-open http://localhost:8888 &"))
          (box :class "deck-rule" :height 1)
          (label :class "start-scratch-empty" :halign "start"
                 :visible {LAB_.attack.quiet} :text "no events recorded yet")
          (scroll :class "start-scroll" :vscroll true :hscroll false :vexpand true
            (box :orientation "v" :space-evenly false :spacing 4 :valign "start"
              (for a in {LAB_.attack.rows}
                (button :class "gh-hive" :tooltip "${a.pot} . ${a.kind}"
                        :onclick "xdg-open http://localhost:8888 &"
                  (box :orientation "h" :space-evenly false :spacing 8
                    (label :class "gh-hive-ip" :halign "start" :hexpand true :text {a.ip})
                    (label :class "gh-hive-meta" :text "${a.proto}:${a.port}")
                    (label :class "gh-hive-pot" :text {a.pot})))))))))

    ;; ---- lab tools ---------------------------------------------------
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""   :tip "VirtualBox manager" :cmd "virtualbox &" :tone "blue")
      (start_action :glyph ""  :tip "Arsenal hub"
                    :cmd "kitty --title Arsenal -e arsenal &" :tone "cyan")
      (start_action :glyph "" :tip "Grafana" :cmd "xdg-open http://localhost:3000 &" :tone "gold")
      (start_action :glyph "" :tip "HoneyHive map" :cmd "xdg-open http://localhost:8888 &" :tone "pink")
      (start_action :glyph ""   :tip "Watch lab traffic on vboxnet0"
                    :cmd "kitty --title lab-traffic -e sh -c 'sudo tcpdump -ni ${LAB_.net.iface} -q; read _' &" :tone "violet")
      (start_action :glyph ""   :tip "Honeypot compose status"
                    :cmd "kitty --title Honeypot -e sh -c 'cd ~/Projects/honeypot && docker compose ps; echo; exec bash' &" :tone "gold")
      (box :hexpand true)
      (label :class "start-hint" :valign "center"
             :text "LAB     lab-attacker is the box you drive     refreshed every 8s"))))

(defwindow lab-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-lab-deck"
  ;; must fit the 882px free area - verify with `hyprctl layers -j`
  :geometry (geometry :x "0" :y "0" :width "1640px" :height "760px" :anchor "center")
  (lab_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; OPS STATION DECK  (workspace 1)  ·  Command · Terminal · Control
;; System vitals, fans, network throughput and a quick-launch panel for the
;; ops toolkit. Reuses the ghost_card / ghost_stat language from GHOST deck.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget ops_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "O P S   ·   C O M M A N D   S T A T I O N")
    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: live system vitals ─────────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "SYSTEM VITALS" :glyph "󰍛" :tone "pink"
          (box :orientation "h" :space-evenly true :spacing 12
            (ghost_stat :val "${SYSPULSE.cpu}%" :cap "CPU"
                        :tone {SYSPULSE.chot == 1 ? "hot" : "ok"}
                        :tip "CPU load · 1m ${SYSPULSE.load}"
                        :cmd "alacritty -e btop &")
            (ghost_stat :val "${SYSPULSE.mem}%" :cap "RAM"
                        :tone {SYSPULSE.mhot == 1 ? "hot" : "ok"}
                        :tip "Memory in use · swap ${SYSPULSE.swap}%"
                        :cmd "alacritty -e btop &")
            (ghost_stat :val "${SYSPULSE.temp}°" :cap "TEMP"
                        :tone {SYSPULSE.thot == 1 ? "hot" : "ok"}
                        :tip "CPU temperature"
                        :cmd "alacritty -e sh -c 'sensors; read _' &")
            (ghost_stat :val "${SYSPULSE.gpu}%" :cap "GPU"
                        :tone {SYSPULSE.ghot == 1 ? "hot" : "ok"}
                        :tip "GPU load · ${SYSPULSE.gputemp}°C"
                        :cmd "alacritty -e btop &"))
          (label :class "deck-spark" :halign "start" :text "${SYSGRAPH.cpu.spark}"))
        (ghost_card :title "LOAD · FAN · SWAP" :glyph "" :tone "cyan"
          (box :orientation "h" :space-evenly false :spacing 14
            (ghost_stat :val "${SYSPULSE.load}" :cap "1m load"
                        :tone {SYSPULSE.hot == "1" ? "hot" : "ok"}
                        :tip "1-minute load average"
                        :cmd "alacritty -e sh -c 'uptime && ps aux --sort=-%cpu | head -15; read _' &")
            (ghost_stat :val "${SYSPULSE.fan}" :cap "FAN"
                        :tone "ok" :tip "Fan RPM"
                        :cmd "alacritty -e sh -c 'sensors; read _' &")
            (ghost_stat :val "${SYSPULSE.swap}%" :cap "SWAP"
                        :tone {SYSPULSE.swap > 50 ? "warn" : "ok"} :tip "Swap in use"
                        :cmd "alacritty -e sh -c 'free -h; read _' &"))
          (label :class "deck-spark" :halign "start" :text "${FANGRAPH.spark}"))
        (ghost_card :title "NETWORK THROUGHPUT" :glyph "" :tone "blue"
          (box :orientation "h" :space-evenly false :spacing 14
            (ghost_stat :val "${NETGRAPH.up_fmt}" :cap "↑ UP"
                        :tone "ok" :tip "Upload speed"
                        :cmd "alacritty -e sh -c 'ss -tulpn; read _' &")
            (ghost_stat :val "${NETGRAPH.down_fmt}" :cap "↓ DOWN"
                        :tone "ok" :tip "Download speed"
                        :cmd "alacritty -e sh -c 'ss -tulpn; read _' &")
            (ghost_stat :val "${NETGRAPH.ssid}" :cap "LINK"
                        :tone "ok" :tip "Connected SSID"
                        :cmd "alacritty -e sh -c 'ip addr; read _' &"))
          (label :class "deck-spark deck-spark-blue" :halign "start"
                 :text "${NETGRAPH.down_spark}")))
      ;; ── RIGHT: ops toolkit quick-launch ──────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 380px;"
        (ghost_card :title "OPS TOOLKIT" :glyph "" :tone "violet" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "BTOP"   :cmd "alacritty -e btop"
                          :tagline "Full system monitor")
              (start_tile :glyph ""  :name "TERM"   :cmd "alacritty"
                          :tagline "New terminal")
              (start_tile :glyph ""  :name "LOG"
                          :cmd "alacritty -e sh -c 'journalctl -n 200 -f; read _'"
                          :tagline "System journal (live)")
              (start_tile :glyph "󰒠" :name "DMESG"
                          :cmd "alacritty -e sh -c 'sudo dmesg -w; read _'"
                          :tagline "Kernel ring buffer"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "PORTS"
                          :cmd "alacritty -e sh -c 'ss -tulpn; read _'"
                          :tagline "Open sockets & ports")
              (start_tile :glyph ""  :name "PROCS"
                          :cmd "alacritty -e sh -c 'ps aux --sort=-%mem | head -30; read _'"
                          :tagline "Process list by memory")
              (start_tile :glyph "󱑹" :name "DISK"
                          :cmd "alacritty -e sh -c 'df -h; ncdu / 2>/dev/null || du -sh /* 2>/dev/null | sort -hr | head -20; read _'"
                          :tagline "Disk usage")
              (start_tile :glyph "󰖙" :name "CRON"
                          :cmd "alacritty -e sh -c 'crontab -l; systemctl list-timers; read _'"
                          :tagline "Scheduled jobs"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "Terminal"           :cmd "alacritty &"                                        :tone "cyan")
      (start_action :glyph ""  :tip "System monitor"     :cmd "alacritty -e btop &"                               :tone "pink")
      (start_action :glyph ""  :tip "Journal (live)"     :cmd "alacritty -e sh -c 'journalctl -n 200 -f; read _' &" :tone "gold")
      (start_action :glyph ""  :tip "Open ports"        :cmd "alacritty -e sh -c 'ss -tulpn; read _' &"          :tone "blue")
      (start_action :glyph "󰒠" :tip "Kernel log"         :cmd "alacritty -e sh -c 'sudo dmesg -w; read _' &"     :tone "violet")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+1  OPS  ·  command & control"))))

(defwindow ops-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-ops-deck"
  :geometry (geometry :x "0" :y "0" :width "1580px" :height "740px" :anchor "center")
  (ops_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; PULSE STATION DECK  (workspace 4)  ·  Comms · Signal · Chat
;; Network status, quick-link hub, weather, and clock. The browsing station.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget pulse_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "P U L S E   ·   C O M M S   S T A T I O N")
    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: network status + weather ───────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "NETWORK" :glyph "" :tone "blue"
          (box :orientation "h" :space-evenly false :spacing 14
            (ghost_stat :val "${NETGRAPH.ssid}" :cap "LINK"
                        :tone "ok" :tip "Active connection"
                        :cmd "alacritty -e sh -c 'ip addr; read _' &")
            (ghost_stat :val "${NETGRAPH.up_fmt}" :cap "↑ UP"
                        :tone "ok" :tip "Upload speed"
                        :cmd "alacritty -e sh -c 'ss -s; read _' &")
            (ghost_stat :val "${NETGRAPH.down_fmt}" :cap "↓ DOWN"
                        :tone "ok" :tip "Download speed"
                        :cmd "alacritty -e sh -c 'ss -s; read _' &"))
          (label :class "deck-spark deck-spark-blue" :halign "start"
                 :text "${NETGRAPH.down_spark}"))
        (ghost_card :title "WEATHER" :glyph "󰖐" :tone "cyan"
          (box :orientation "h" :space-evenly false :spacing 16
            (box :orientation "v" :space-evenly false :spacing 4
              (label :class "gh-big gh-big-ok" :text "${WEATHER.temp}")
              (label :class "deck-sub" :text "${WEATHER.summary}"))
            (box :orientation "v" :space-evenly false :spacing 4 :valign "center"
              (label :class "deck-moon" :text "${MOON.glyph}")
              (label :class "deck-sub" :text "${MOON.name}"))))
        (ghost_card :title "TIME & DATE" :glyph "󰥔" :tone "pink"
          (box :orientation "h" :space-evenly false :spacing 14
            (box :orientation "v" :space-evenly false
              (label :class "deck-clock" :halign "start" :text "${TIME.hm}")
              (label :class "deck-sub" :halign "start" :text "${TIME.date}"))
            (dcard_calendar))))
      ;; ── RIGHT: quick links + actions ────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 380px;"
        (ghost_card :title "QUICK LINKS" :glyph "" :tone "gold" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "BROWSER"  :cmd "firefox"
                          :tagline "Firefox web browser")
              (start_tile :glyph ""  :name "EMAIL"    :cmd "xdg-open https://mail.google.com"
                          :tagline "Gmail")
              (start_tile :glyph "󰙈" :name "DISCORD"  :cmd "xdg-open https://discord.com/app"
                          :tagline "Discord")
              (start_tile :glyph ""  :name "GITHUB"   :cmd "xdg-open https://github.com"
                          :tagline "GitHub"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph "󰎈" :name "YOUTUBE"  :cmd "xdg-open https://youtube.com"
                          :tagline "YouTube")
              (start_tile :glyph "󰡦" :name "REDDIT"   :cmd "xdg-open https://reddit.com"
                          :tagline "Reddit")
              (start_tile :glyph ""  :name "CALENDAR" :cmd "xdg-open https://calendar.google.com"
                          :tagline "Google Calendar")
              (start_tile :glyph ""  :name "MAPS"     :cmd "xdg-open https://maps.google.com"
                          :tagline "Google Maps"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "Firefox"            :cmd "firefox &"                      :tone "orange")
      (start_action :glyph ""  :tip "Network settings"   :cmd "nm-connection-editor &"         :tone "blue")
      (start_action :glyph ""  :tip "Bluetooth"          :cmd "eww open --toggle bluetooth"    :tone "cyan")
      (start_action :glyph ""  :tip "WiFi networks"      :cmd "eww open --toggle wifi"         :tone "gold")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+4  PULSE  ·  comms & signal"))))

(defwindow pulse-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-pulse-deck"
  :geometry (geometry :x "0" :y "0" :width "1580px" :height "740px" :anchor "center")
  (pulse_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; WAVE STATION DECK  (workspace 5)  ·  Media · Sound · Stream
;; The music command centre. Full-width CAVA, now-playing, transport,
;; volume and sink management — everything music in one panel.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget wave_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "W A V E   ·   M E D I A   S T A T I O N")

    ;; ── hero: full-width CAVA visualizer ─────────────────────────────
    (box :class "nyxus-surface wave-cava-hero"
         :style "box-shadow: 0 0 ${24 + CAVA_BASS / 2}px rgba(${SECSTATE.hacker == 'on' ? '255,255,255' : '255,138,30'}, ${0.28 + CAVA_BASS / 220}); padding: 10px 18px;"
      (label :class "wave-cava-text" :halign "center" :hexpand true
             :text "${CAVA}"))

    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: now playing + transport ───────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "NOW PLAYING" :glyph "" :tone "orange" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (label :class "wave-track" :halign "start" :limit-width 36
                   :text "${PLAYER.title}")
            (label :class "wave-artist" :halign "start" :limit-width 40
                   :text "${PLAYER.artist}")
            (box :class "deck-rule" :height 1)
            (box :orientation "h" :space-evenly false :spacing 8 :valign "center"
              (label :class "deck-time" :text "${PLAYER.pos}")
              (progress :class "wave-prog" :hexpand true :valign "center"
                        :value {PLAYER.progress} :orientation "h")
              (label :class "deck-time" :text "${PLAYER.len}"))
            (box :orientation "h" :space-evenly true :spacing 12 :halign "center"
              (button :class "wave-btn wave-btn-sm"
                      :onclick "playerctl previous &" :tooltip "Previous"
                "󰒮")
              (button :class "wave-btn wave-btn-play"
                      :style "box-shadow: 0 0 ${10 + CAVA_BASS / 3}px rgba(${SECSTATE.hacker == 'on' ? '255,255,255' : '255,138,30'}, ${0.4 + CAVA_BASS / 180});"
                      :onclick "playerctl play-pause &" :tooltip "Play / Pause"
                "${PLAYER.icon}")
              (button :class "wave-btn wave-btn-sm"
                      :onclick "playerctl next &" :tooltip "Next"
                "󰒭")))))
      ;; ── RIGHT: volume + sinks ────────────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 380px;"
        (ghost_card :title "VOLUME" :glyph "" :tone "violet"
          (box :orientation "h" :space-evenly false :spacing 12
            (ghost_stat :val "${AUDIO.vol}%" :cap "OUTPUT"
                        :tone "ok" :tip "Master volume"
                        :cmd "eww open --toggle mixer &")
            (ghost_stat :val "${MIC.vol}%" :cap "MIC"
                        :tone {MIC.mute == "yes" ? "warn" : "ok"}
                        :tip "Microphone level"
                        :cmd "eww open --toggle mixer &"))
          (box :orientation "h" :space-evenly false :spacing 10 :halign "start"
            (button :class "start-action start-action-violet" :tooltip "Volume up"
                    :onclick "pactl set-sink-volume @DEFAULT_SINK@ +5% &" "")
            (button :class "start-action start-action-violet" :tooltip "Volume down"
                    :onclick "pactl set-sink-volume @DEFAULT_SINK@ -5% &" "")
            (button :class "start-action start-action-${MIC.mute == 'yes' ? 'red' : 'cyan'}"
                    :tooltip "Toggle mic mute"
                    :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle &"
                    "${MIC.icon}")))
        (ghost_card :title "QUICK LAUNCH" :glyph "" :tone "pink" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "PAVUCTL"
                          :cmd "pavucontrol"
                          :tagline "PulseAudio volume control")
              (start_tile :glyph ""  :name "MIXER"
                          :cmd "eww open --toggle mixer"
                          :tagline "NYXUS audio mixer")
              (start_tile :glyph ""  :name "CAVA"
                          :cmd "alacritty --title CAVA -e cava"
                          :tagline "Audio visualizer"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph "󰒮" :tip "Previous track" :cmd "playerctl previous &"  :tone "orange")
      (start_action :glyph {PLAYER.icon} :tip "Play / Pause" :cmd "playerctl play-pause &" :tone "pink")
      (start_action :glyph "󰒭" :tip "Next track"     :cmd "playerctl next &"      :tone "orange")
      (start_action :glyph ""  :tip "Volume mixer"   :cmd "eww open --toggle mixer" :tone "violet")
      (box :hexpand true)
      (label :class "wave-cava-mini" :valign "center" :text "${CAVA}")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+5  WAVE  ·  media & sound"))))

(defwindow wave-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-wave-deck"
  :geometry (geometry :x "0" :y "0" :width "1580px" :height "760px" :anchor "center")
  (wave_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; CORE STATION DECK  (workspace 6)  ·  Files · Data · Vault
;; Storage overview, disk health, and quick-nav to the key directories.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget core_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "C O R E   ·   F I L E S   &   V A U L T")
    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: disk usage ────────────────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "STORAGE" :glyph "󱑹" :tone "blue"
          (box :orientation "v" :space-evenly false :spacing 10
            (box :orientation "h" :space-evenly false :spacing 14
              (ghost_stat :val "${DISK_.root.used}" :cap "/ USED"
                          :tone {DISK_.root.pct > 85 ? "hot" : (DISK_.root.pct > 70 ? "warn" : "ok")}
                          :tip "Root partition used · ${DISK_.root.pct}% of ${DISK_.root.total}"
                          :cmd "alacritty -e sh -c 'df -h; read _' &")
              (ghost_stat :val "${DISK_.home.used}" :cap "~ USED"
                          :tone {DISK_.home.pct > 85 ? "hot" : (DISK_.home.pct > 70 ? "warn" : "ok")}
                          :tip "Home partition used · ${DISK_.home.pct}% of ${DISK_.home.total}"
                          :cmd "alacritty -e sh -c 'df -h ~; read _' &")
              (ghost_stat :val "${DISK_.projects.used}" :cap "PROJECTS"
                          :tone "ok"
                          :tip "~/Projects disk usage"
                          :cmd "alacritty -e sh -c 'du -sh ~/Projects/*/; read _' &"))
            (box :class "deck-rule" :height 1)
            (box :orientation "h" :space-evenly false :spacing 14
              (ghost_stat :val "${SYSPULSE.mem}%" :cap "RAM"
                          :tone {SYSPULSE.mhot == 1 ? "hot" : "ok"}
                          :tip "Memory in use"
                          :cmd "alacritty -e sh -c 'free -h; read _' &")
              (ghost_stat :val "${SYSPULSE.swap}%" :cap "SWAP"
                          :tone {SYSPULSE.swap > 30 ? "warn" : "ok"}
                          :tip "Swap in use"
                          :cmd "alacritty -e sh -c 'free -h; read _' &"))))
        (ghost_card :title "QUICK TOOLS" :glyph "" :tone "gold"
          (box :orientation "h" :space-evenly true :spacing 6
            (start_tile :glyph ""  :name "FILES"
                        :cmd "thunar" :tagline "File manager")
            (start_tile :glyph "󰒖" :name "ARCHIVE"
                        :cmd "alacritty -e sh -c 'ls ~/Archive/ 2>/dev/null || ls ~/Downloads/; read _'"
                        :tagline "Archives & Downloads")
            (start_tile :glyph ""  :name "SYNC"
                        :cmd "alacritty -e sh -c 'rsync --progress -avh ~/Projects/ ~/Backups/projects-rsync/ 2>/dev/null; read _'"
                        :tagline "Sync Projects → Backups")
            (start_tile :glyph "󰋊" :name "NCDU"
                        :cmd "alacritty -e sh -c 'ncdu / 2>/dev/null || du -sh ~/* | sort -hr | head -20; read _'"
                        :tagline "Disk usage browser"))))
      ;; ── RIGHT: quick-nav bookmarks ───────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 360px;"
        (ghost_card :title "DIRECTORIES" :glyph "" :tone "violet" :fill true
          (box :orientation "v" :space-evenly false :spacing 6 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "HOME"      :cmd "thunar ~"            :tagline "Home directory")
              (start_tile :glyph ""  :name "PROJECTS"  :cmd "thunar ~/Projects"   :tagline "~/Projects")
              (start_tile :glyph ""  :name "DOWNLOADS" :cmd "thunar ~/Downloads"  :tagline "~/Downloads"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "DOCS"      :cmd "thunar ~/Documents"  :tagline "~/Documents")
              (start_tile :glyph ""  :name "VAULT"     :cmd "thunar ~/GowskiNet-Vault 2>/dev/null || thunar ~" :tagline "GowskiNet Vault")
              (start_tile :glyph "󰒆" :name "BACKUPS"   :cmd "thunar ~/Backups 2>/dev/null || thunar ~" :tagline "Backups"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "Files (Thunar)"  :cmd "thunar &"                                    :tone "gold")
      (start_action :glyph ""  :tip "Terminal in ~"   :cmd "alacritty &"                                 :tone "cyan")
      (start_action :glyph "󱑹" :tip "Disk usage"      :cmd "alacritty -e sh -c 'df -h; read _' &"       :tone "blue")
      (start_action :glyph "󰋊" :tip "Disk browser"    :cmd "alacritty -e sh -c 'ncdu /; read _' &"      :tone "violet")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+6  CORE  ·  files & data"))))

(defwindow core-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-core-deck"
  :geometry (geometry :x "0" :y "0" :width "1560px" :height "740px" :anchor "center")
  (core_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; SCRIBE STATION DECK  (workspace 8)  ·  Notes · Docs · Scribe
;; Writing focus station. Scratchpad, stickies shortcut, quick doc tools.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget scribe_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "S C R I B E   ·   N O T E S   &   D O C S")
    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: scratchpad + time (writing focus) ──────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "TIME" :glyph "󰥔" :tone "pink"
          (box :orientation "h" :space-evenly false :spacing 16
            (box :orientation "v" :space-evenly false
              (label :class "deck-clock" :halign "start" :text "${TIME.hm}")
              (label :class "deck-sub" :halign "start" :text "${TIME.date}"))
            (box :orientation "v" :space-evenly false :valign "center"
              (label :class "deck-moon" :text "${MOON.glyph}")
              (label :class "deck-sub" :text "${MOON.name}"))))
        (ghost_card :title "SCRATCHPAD" :glyph "" :tone "violet" :fill true
          (box :orientation "v" :space-evenly false :spacing 4 :vexpand true
            (label :class "start-scratch-empty" :halign "start"
                   :visible {STARTMETA.scratch_empty} :text "nothing written yet  ·  open notepad to start")
            (scroll :class "start-scroll" :vscroll true :hscroll false :vexpand true
              (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
                (for l in {STARTMETA.scratch}
                  (label :class "start-scratch" :halign "start" :limit-width 40 :text l)))))))
      ;; ── RIGHT: writing toolkit ───────────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 360px;"
        (ghost_card :title "WRITING TOOLS" :glyph "" :tone "gold" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "NOTEPAD"
                          :cmd "sh -c 'command -v nyxus-notepad >/dev/null && nyxus-notepad || python3 ~/.nyxus/nyxus_notepad.py'"
                          :tagline "NYXUS Notepad")
              (start_tile :glyph ""  :name "STICKIES"
                          :cmd "sh -c 'command -v nyxus-stickies >/dev/null && nyxus-stickies || python3 ~/.nyxus/nyxus_stickies.py'"
                          :tagline "NYXUS Stickies")
              (start_tile :glyph ""  :name "VIM"
                          :cmd "alacritty -e vim"
                          :tagline "Vim text editor"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "MD VIEW"
                          :cmd "sh -c 'ls ~/Documents/*.md 2>/dev/null | head -1 | xargs -I{} xdg-open {} || thunar ~/Documents'"
                          :tagline "Open last markdown doc")
              (start_tile :glyph ""  :name "DOCS"
                          :cmd "thunar ~/Documents"
                          :tagline "~/Documents folder")
              (start_tile :glyph "󰻭" :name "TODO"
                          :cmd "alacritty -e sh -c 'cat ~/TODO.md 2>/dev/null || cat ~/todo.md 2>/dev/null || echo \"no TODO file\"; read _'"
                          :tagline "View TODO list"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "Notepad"        :cmd "sh -c 'command -v nyxus-notepad >/dev/null && nyxus-notepad || python3 ~/.nyxus/nyxus_notepad.py' &" :tone "violet")
      (start_action :glyph ""  :tip "Stickies"       :cmd "sh -c 'command -v nyxus-stickies >/dev/null && nyxus-stickies || python3 ~/.nyxus/nyxus_stickies.py' &" :tone "gold")
      (start_action :glyph ""  :tip "Terminal"       :cmd "alacritty &"                                                                                           :tone "cyan")
      (start_action :glyph ""  :tip "Documents"      :cmd "thunar ~/Documents &"                                                                                   :tone "blue")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+8  SCRIBE  ·  notes & docs"))))

(defwindow scribe-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-scribe-deck"
  :geometry (geometry :x "0" :y "0" :width "1560px" :height "740px" :anchor "center")
  (scribe_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; ARSENAL STATION DECK  (workspace 10)  ·  Security Consoles
;; Badass mosaic of GowskiNet security app tiles: CIPHER, RedForge, Forge,
;; GSL and Trainer — live port-status dots, click to launch. Two big hero
;; tiles on top, three medium tiles below. AXIOM as a standalone launch.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget arsenal_app_hero [name glyph tagline port cmd live]
  ;; Big hero tile — 2 in a row, prominent
  (button :class "arsenal-hero${live ? '' : ' arsenal-hero-down'}"
          :style "box-shadow: 0 0 ${live ? (16 + CAVA_BASS / 3) : 6}px rgba(${SECSTATE.hacker == 'on' ? '255,255,255' : '43,210,255'}, ${live ? 0.35 : 0.10});"
          :onclick "${cmd} &" :tooltip "${tagline} · port ${port}"
    (box :orientation "v" :space-evenly false :spacing 8 :halign "center" :valign "center"
      (box :orientation "h" :space-evenly false :spacing 10 :halign "center"
        (label :class "arsenal-hero-dot" :text {live ? "●" : "○"}
               :style "color: ${live ? (SECSTATE.hacker == 'on' ? '#fff' : '#2bd2ff') : 'rgba(255,255,255,0.3)'};" )
        (label :class "arsenal-hero-glyph" :text glyph))
      (label :class "arsenal-hero-name" :text name)
      (label :class "arsenal-hero-tag" :text tagline)
      (label :class "arsenal-hero-port" :text "127.0.0.1:${port}"))))

(defwidget arsenal_app_tile [name glyph tagline port cmd live]
  ;; Medium tile — 3 in a row
  (button :class "arsenal-tile${live ? '' : ' arsenal-tile-down'}"
          :style "box-shadow: 0 0 ${live ? (12 + CAVA_BASS / 4) : 4}px rgba(${SECSTATE.hacker == 'on' ? '255,255,255' : '125,61,255'}, ${live ? 0.3 : 0.08});"
          :onclick "${cmd} &" :tooltip "${tagline} · port ${port}"
    (box :orientation "h" :space-evenly false :spacing 10 :halign "start"
      (label :class "arsenal-tile-glyph" :text glyph)
      (box :orientation "v" :space-evenly false :spacing 3
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "arsenal-tile-name" :text name)
          (label :class "arsenal-tile-dot" :text {live ? "●" : "○"}
                 :style "color: ${live ? (SECSTATE.hacker == 'on' ? '#fff' : '#7d3dff') : 'rgba(255,255,255,0.28)'};" ))
        (label :class "arsenal-tile-tag" :text tagline)
        (label :class "arsenal-tile-port" :text ":${port}")))))

(defwidget arsenal_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 14
    (label :class "deck-brand" :halign "center"
           :text "A R S E N A L   ·   S E C U R I T Y   C O N S O L E S")

    ;; ── ROW 1: two big hero tiles (CIPHER + RedForge) ─────────────────
    (box :orientation "h" :space-evenly true :spacing 16
      (arsenal_app_hero
        :name "CIPHER" :glyph ""
        :tagline "Encryption & Key Forge"
        :port "8080"
        :cmd "nyxus-webapp cipher"
        :live {ARSENAL_.cipher})
      (arsenal_app_hero
        :name "RED FORGE" :glyph ""
        :tagline "Red Team Operations"
        :port "5000"
        :cmd "nyxus-webapp redforge"
        :live {ARSENAL_.redforge}))

    ;; ── ROW 2: three medium tiles (Forge, GSL, Trainer) ───────────────
    (box :orientation "h" :space-evenly true :spacing 12
      (arsenal_app_tile
        :name "FORGE" :glyph ""
        :tagline "GowskiNet Build Console"
        :port "20000"
        :cmd "nyxus-webapp forge"
        :live {ARSENAL_.forge})
      (arsenal_app_tile
        :name "GSL" :glyph ""
        :tagline "Security Lab Intelligence"
        :port "19670"
        :cmd "nyxus-webapp gsl"
        :live {ARSENAL_.gsl})
      (arsenal_app_tile
        :name "TRAINER" :glyph "󰑓"
        :tagline "Security Training Platform"
        :port "20508"
        :cmd "nyxus-webapp trainer"
        :live {ARSENAL_.trainer}))

    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "Launch all consoles"  :cmd "nyxus-consoles &"       :tone "cyan")
      (start_action :glyph ""  :tip "AXIOM"                :cmd "nyxus-webapp axiom &"   :tone "violet")
      (start_action :glyph ""  :tip "GHOST security"       :cmd "hyprctl dispatch workspace name:GHOST &" :tone "green")
      (start_action :glyph ""  :tip "Terminal"             :cmd "alacritty &"            :tone "gold")
      (box :hexpand true)
      (label :class "start-hint" :valign "center"
             :text "Super+0  ARSENAL  ·  status refreshes every 10s  ·  click any tile to launch"))))

(defwindow arsenal-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-arsenal-deck"
  :geometry (geometry :x "0" :y "0" :width "1580px" :height "720px" :anchor "center")
  (arsenal_deck))

;; ══════════════════════════════════════════════════════════════════════════
;; MESH STATION DECK  (workspace 7)  ·  Network · NOC · Mesh
;; Live network throughput, connection matrix, GowskiNet NOC status and a
;; full toolkit row for the network operator. Every stat is a clickable
;; button that opens the relevant tool.
;; ══════════════════════════════════════════════════════════════════════════
(defwidget mesh_deck []
  (box :class "gh-root${SECSTATE.hacker == 'on' ? ' nyx-hacker' : ''}"
       :orientation "v" :space-evenly false :spacing 12
    (label :class "deck-brand" :halign "center"
           :text "M E S H   ·   N E T W O R K   O P S   C E N T R E")

    (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
      ;; ── LEFT: live throughput + connection matrix ─────────────────────
      (box :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (ghost_card :title "THROUGHPUT" :glyph "" :tone "blue"
          (box :orientation "h" :space-evenly false :spacing 16
            (ghost_stat :val "${NETGRAPH.up_fmt}" :cap "↑ UPLOAD"
                        :tone "ok" :tip "Upload speed"
                        :cmd "alacritty -e sh -c 'nethogs 2>/dev/null || iftop 2>/dev/null || ip -s link; read _' &")
            (ghost_stat :val "${NETGRAPH.down_fmt}" :cap "↓ DOWNLOAD"
                        :tone "ok" :tip "Download speed"
                        :cmd "alacritty -e sh -c 'nethogs 2>/dev/null || iftop 2>/dev/null || ip -s link; read _' &")
            (ghost_stat :val "${NETGRAPH.ssid}" :cap "LINK"
                        :tone "ok" :tip "Active SSID / interface"
                        :cmd "alacritty -e sh -c 'nmcli device status; read _' &"))
          (label :class "deck-spark deck-spark-blue" :halign "start"
                 :text "${NETGRAPH.down_spark}"))
        (ghost_card :title "CONNECTIONS" :glyph "" :tone "cyan"
          (box :orientation "h" :space-evenly false :spacing 14
            (ghost_stat :val "${MESH_.conns}" :cap "TOTAL"
                        :tone "ok" :tip "Total active sockets"
                        :cmd "alacritty -e sh -c 'ss -s; read _' &")
            (ghost_stat :val "${MESH_.listen}" :cap "LISTEN"
                        :tone "ok" :tip "Listening ports"
                        :cmd "alacritty -e sh -c 'ss -tlpn; read _' &")
            (ghost_stat :val "${MESH_.foreign}" :cap "FOREIGN"
                        :tone {MESH_.foreign > 20 ? "warn" : "ok"}
                        :tip "Established to external hosts"
                        :cmd "alacritty -e sh -c 'ss -tnp | grep ESTAB; read _' &")
            (ghost_stat :val "${MESH_.tcp}" :cap "TCP"
                        :tone "ok" :tip "TCP sockets"
                        :cmd "alacritty -e sh -c 'ss -tnp; read _' &")))
        (ghost_card :title "NOC STATUS" :glyph "" :tone "pink" :fill true
          (box :orientation "h" :space-evenly false :spacing 16 :vexpand true
            (ghost_stat :val "${GHOST_.hive.h1}" :cap "HITS 1h"
                        :tone {GHOST_.hive.h1 > 0 ? "hot" : "ok"}
                        :tip "HoneyHive hits in the last hour"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${GHOST_.hive.ips}" :cap "SRC IPs"
                        :tone "warn" :tip "Unique source IPs seen"
                        :cmd "xdg-open http://localhost:8888 &")
            (ghost_stat :val "${GHOST_.conns.count}" :cap "CONNS"
                        :tone {GHOST_.conns.foreign > 5 ? "warn" : "ok"}
                        :tip "Active foreign connections from GHOST scan"
                        :cmd "alacritty -e sh -c 'ss -tnp | grep ESTAB | head -30; read _' &"))))
      ;; ── RIGHT: network toolkit ────────────────────────────────────────
      (box :orientation "v" :space-evenly false :spacing 12
           :style "min-width: 360px;"
        (ghost_card :title "NETWORK TOOLKIT" :glyph "" :tone "violet" :fill true
          (box :orientation "v" :space-evenly false :spacing 8 :vexpand true
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "NOC"
                          :cmd "alacritty --title 'GowskiNet NOC' -e sh -c 'command -v sharknoc >/dev/null && exec sharknoc --watch || exec btop'"
                          :tagline "SharkFin NOC (live watch)")
              (start_tile :glyph ""  :name "IFTOP"
                          :cmd "alacritty -e sh -c 'sudo iftop 2>/dev/null; read _'"
                          :tagline "Per-connection bandwidth")
              (start_tile :glyph ""  :name "NETHOGS"
                          :cmd "alacritty -e sh -c 'sudo nethogs 2>/dev/null; read _'"
                          :tagline "Per-process bandwidth"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "NMAP"
                          :cmd "alacritty -e sh -c 'echo \"target: \"; read t; sudo nmap -sV $t; read _'"
                          :tagline "Port scanner")
              (start_tile :glyph ""  :name "SS"
                          :cmd "alacritty -e sh -c 'watch -n1 ss -s; read _'"
                          :tagline "Socket statistics (live)")
              (start_tile :glyph "󰛳" :name "HIVE"
                          :cmd "xdg-open http://localhost:8888"
                          :tagline "HoneyHive map"))
            (box :orientation "h" :space-evenly true :spacing 6
              (start_tile :glyph ""  :name "WIRESHARK"
                          :cmd "wireshark 2>/dev/null || alacritty -e sh -c 'sudo tcpdump -ni any -q; read _'"
                          :tagline "Packet capture")
              (start_tile :glyph ""  :name "CURL"
                          :cmd "alacritty -e sh -c 'echo \"URL: \"; read u; curl -sIL $u | head -30; read _'"
                          :tagline "HTTP headers probe")
              (start_tile :glyph ""  :name "GRAFANA"
                          :cmd "xdg-open http://localhost:3000"
                          :tagline "Grafana dashboards"))))))
    ;; ── action bar ────────────────────────────────────────────────────
    (box :class "gh-bar" :orientation "h" :space-evenly false :spacing 10
      (start_action :glyph ""  :tip "NOC (sharknoc --watch)"
                    :cmd "alacritty --title 'GowskiNet NOC' -e sh -c 'command -v sharknoc >/dev/null && exec sharknoc --watch || exec btop' &"
                    :tone "pink")
      (start_action :glyph ""  :tip "Listening ports"
                    :cmd "alacritty -e sh -c 'ss -tulpn; read _' &" :tone "cyan")
      (start_action :glyph ""  :tip "Connections (live)"
                    :cmd "alacritty -e sh -c 'watch -n1 ss -tnp; read _' &" :tone "blue")
      (start_action :glyph "󰛳" :tip "HoneyHive map"
                    :cmd "xdg-open http://localhost:8888 &" :tone "gold")
      (start_action :glyph ""  :tip "Grafana"
                    :cmd "xdg-open http://localhost:3000 &" :tone "violet")
      (box :hexpand true)
      (label :class "start-hint" :valign "center" :text "Super+7  MESH  ·  network ops"))))

(defwindow mesh-deck
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :namespace "nyxus-mesh-deck"
  :geometry (geometry :x "0" :y "0" :width "1580px" :height "750px" :anchor "center")
  (mesh_deck))

(defwindow bar-bottom
  :monitor 0 :stacking "bottom" :exclusive true :namespace "nyxus-bar-bottom"
  :geometry (geometry :x "0" :y "8" :width "100%" :height "74px" :anchor "bottom center")
  (bar_bottom_layout))

(defwindow bar-top
  :monitor 0 :stacking "bottom" :exclusive true :namespace "nyxus-bar-top"
  :geometry (geometry :x "0" :y "4" :width "100%" :height "36px" :anchor "top center")
  (bar_top_layout))

(defwindow bar-left
  :monitor 0 :stacking "fg" :exclusive false :namespace "nyxus-bar-left"
  :geometry (geometry :x "10" :y "0" :width "56px" :height "70%" :anchor "center left")
  (workspaces_rail))

(defwindow bar-right
  :monitor 0 :stacking "fg" :exclusive false :namespace "nyxus-bar-right"
  :geometry (geometry :x "10" :y "0" :width "56px" :height "70%" :anchor "center right")
  (app_rail))

;; Fullscreen overlays sit inside .overlay-backdrop — a tinted sheet
;; whose alpha (0.34) clears the layerrule ignore_alpha threshold (0.2),
;; so Hyprland frosts EVERYTHING behind the overlay edge-to-edge while
;; window shadows stay visible through the glass.
;; "fg" (TOP), not "overlay": same fullscreen-input-surface hazard as
;; nyxus-hub. See HANDOFF Section 7 and the defwindow nyxus-hub comment.
(defwindow dashboard
  :monitor 0 :stacking "fg" :focusable false :namespace "nyxus-dashboard"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (box :class "overlay-backdrop" (dashboard_layout)))

(defwindow nyxus-hub
  ;; focusable false: no exclusive keyboard grab, so the compositor Escape
  ;; bind ALWAYS fires and can never be trapped. No text field lives here.
  ;;
  ;; stacking "fg" (= wlr-layer-shell TOP), NOT "overlay". HANDOFF Section 7:
  ;; a fullscreen OVERLAY-layer input surface sits above everything and eats
  ;; every pointer event on the desktop. On TOP the Hub still covers ordinary
  ;; windows, but OSDs, notifications, the powermenu and hyprlock -- all of
  ;; which are on OVERLAY -- can still surface above it, so the session always
  ;; has a route to tell the user something and hyprlock can always take over.
  ;;
  ;; There is deliberately no :onkeydown here. eww has no such attribute in
  ;; 0.5.0 or 0.6.0 (checked against both sources); it was silently dropped
  ;; with a log warning, so the in-widget Escape it looked like it provided
  ;; never existed. Escape is handled by the compositor binds in hyprland.conf,
  ;; which is the only layer that can guarantee it.
  :monitor 0 :stacking "fg" :focusable false :namespace "nyxus-hub"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (eventbox :onclick "nyxus-hub-close &"
    :vexpand true :hexpand true
    ;; A plain (box) fills the full layer height reliably (GtkCenterBox
    ;; did not, leaving a ~44px transparent strip at the bottom where the
    ;; live video wallpaper bled through). The opaque backdrop rides here.
    (box :class "hub-backdrop" :orientation "v" :vexpand true :hexpand true
         :style "background-color: rgb(3,1,9); background-image: linear-gradient(rgba(4,2,10,0.95), rgba(2,1,7,0.98)), url('assets/nyxus-hero-crew-meet.png'); background-size: cover; background-position: center;"
      (centerbox :vexpand true :hexpand true
        (box)
        (nyxus_hub_layout)
        (box)))))

;; "fg" (TOP), not "overlay": same fullscreen-input-surface hazard as
;; nyxus-hub. See HANDOFF Section 7 and the defwindow nyxus-hub comment.
(defwindow powermenu
  :monitor 0 :stacking "fg" :focusable false :namespace "nyxus-powermenu"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (box :class "overlay-backdrop"
       :style "background-image: linear-gradient(rgba(5,1,13,0.76), rgba(5,1,13,0.82)), url('assets/nyxus-hero-ufo-shop.png'); background-size: cover; background-position: center;"
    (powermenu_layout)))

;; "fg" (TOP), not "overlay": same fullscreen-input-surface hazard as
;; nyxus-hub. See HANDOFF Section 7 and the defwindow nyxus-hub comment.
(defwindow cheatsheet
  :monitor 0 :stacking "fg" :focusable false :namespace "nyxus-cheatsheet"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (box :class "overlay-backdrop" (cheatsheet_layout)))

(defwindow osd-volume
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-osd"
  :geometry (geometry :x "0" :y "120" :width "420px" :height "70px" :anchor "bottom center")
  (osd_volume_layout))

(defwindow osd-brightness
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-osd"
  :geometry (geometry :x "0" :y "120" :width "420px" :height "70px" :anchor "bottom center")
  (osd_brightness_layout))

(defwindow osd-mic
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-osd"
  :geometry (geometry :x "0" :y "120" :width "420px" :height "70px" :anchor "bottom center")
  (osd_mic_layout))

(defwindow screensaver
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-screensaver"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (screensaver_layout))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · QUICK SETTINGS
;; ═════════════════════════════════════════════════════════════════════

(defwidget qs_tile [glyph label state cmd]
  (button :class {state == "on" ? "qs-tile qs-tile-on" : "qs-tile"}
          :onclick "(${cmd}) &"
    (box :orientation "v" :space-evenly false :spacing 4 :halign "center"
      (label :class "qs-tile-glyph" :text "${glyph}")
      (label :class "qs-tile-label" :text "${label}"))))

(defwidget quicksettings_layout []
  (box :class "qs-root" :orientation "v" :space-evenly false :spacing 14
    (label :class "qs-title" :text "QUICK SETTINGS")

    (box :class "qs-grid" :orientation "h" :space-evenly true :spacing 10
      (qs_tile :glyph "󰖩" :label "WiFi"      :state "${QS.wifi}"       :cmd "~/.config/eww/scripts/qs-toggle.sh wifi")
      (qs_tile :glyph "󰂯" :label "Bluetooth" :state "${QS.bt}"         :cmd "~/.config/eww/scripts/qs-toggle.sh bt")
      (qs_tile :glyph "󰀝" :label "Airplane"  :state "${QS.airplane}"   :cmd "~/.config/eww/scripts/qs-toggle.sh airplane")
      (qs_tile :glyph "󰂛" :label "DND"       :state "${QS.dnd}"        :cmd "~/.config/eww/scripts/qs-toggle.sh dnd"))

    (box :class "qs-grid" :orientation "h" :space-evenly true :spacing 10
      (qs_tile :glyph "󰖔"  :label "NightLight":state "${QS.nightlight}" :cmd "~/.config/eww/scripts/qs-toggle.sh nightlight")
      (qs_tile :glyph "󰓅" :label "${QS.profile}" :state "on"           :cmd "~/.config/eww/scripts/qs-toggle.sh profile")
      (qs_tile :glyph "󰍬" :label "Mic"        :state "${QS.mic_mute}"   :cmd "~/.config/eww/scripts/qs-toggle.sh mic")
      (qs_tile :glyph "󰝟" :label "Mute"       :state "${QS.audio_mute}" :cmd "~/.config/eww/scripts/qs-toggle.sh audio"))

    (box :class "qs-grid" :orientation "h" :space-evenly true :spacing 10
      (qs_tile :glyph "󰑵" :label "RotLock"   :state "${QS.rot_lock}"    :cmd "~/.config/eww/scripts/qs-toggle.sh rot")
      (qs_tile :glyph "☼"  :label "AutoBrt"  :state "${QS.auto_bright}" :cmd "~/.config/eww/scripts/qs-toggle.sh auto-bright")
      (qs_tile :glyph "󰌾" :label "Lock"      :state "off" :cmd "eww close quicksettings && hyprlock")
      (qs_tile :glyph "󰐥"  :label "Power"    :state "off" :cmd "eww close quicksettings && eww open --toggle powermenu"))

    (box :class "qs-sliders" :orientation "v" :space-evenly false :spacing 10
      (box :orientation "h" :space-evenly false :spacing 12
        (label :class "qs-slider-glyph" :text "󰕾")
        (scale :class "qs-scale" :value "${AUDIO.vol}" :min 0 :max 100 :hexpand true
               :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"))
      (box :orientation "h" :space-evenly false :spacing 12
        (label :class "qs-slider-glyph" :text "☼")
        (scale :class "qs-scale" :value "${BACKLIGHT.percent}" :min 1 :max 100 :hexpand true
               :onchange "brightnessctl set {}%"))
      (box :orientation "h" :space-evenly false :spacing 12
        (label :class "qs-slider-glyph" :text "󰍬")
        (scale :class "qs-scale" :value "${MIC.vol}" :min 0 :max 100 :hexpand true
               :onchange "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {}%")))

    (button :class "qs-close" :onclick "eww close quicksettings" "Close (Esc)")))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · WIFI PICKER
;; ═════════════════════════════════════════════════════════════════════

;; SSID is passed only as the base64 `b64` field, never raw, to prevent
;; shell injection from malicious access-point names (rev r9-eww).
(defwidget wifi_row [net]
  (box :class {net.active ? "wifi-row wifi-row-active" : "wifi-row"}
       :orientation "h" :space-evenly false :spacing 10
    (label :class "wifi-bars" :text "${net.bars}")
    (button :class "wifi-name" :hexpand true :halign "start"
            :onclick "~/.config/eww/scripts/wifi-action.sh connect ${net.b64} &"
            :tooltip "Click to connect · ${net.security} · ${net.signal}%"
      "${net.icon}  ${net.ssid}")
    (label :class "wifi-sig" :text "${net.signal}%")
    (button :class "wifi-forget"
            :onclick "~/.config/eww/scripts/wifi-action.sh forget ${net.b64} &"
            :tooltip "Forget" "✕")))

;; Saved profile row — connect/disconnect + autoconnect + forget, all
;; in-panel via nmcli (no nmtui escape hatch; rev 2026-07-09).
(defwidget wifi_saved_row [net]
  (box :class {net.active ? "wifi-row wifi-row-active" : "wifi-row"}
       :orientation "h" :space-evenly false :spacing 10
    (label :class "wifi-bars" :text "${net.active ? '◉' : '○'}")
    (label :class "wifi-name" :hexpand true :halign "start" :limit-width 22
           :text "${net.name}")
    (button :class {net.autoconnect ? "wifi-auto wifi-auto-on" : "wifi-auto"}
            :onclick "~/.config/eww/scripts/wifi-action.sh autoconnect ${net.b64} &"
            :tooltip "Autoconnect ${net.autoconnect ? 'on — click to disable' : 'off — click to enable'}"
      "AUTO")
    (button :class "wifi-act"
            :onclick "~/.config/eww/scripts/wifi-action.sh ${net.active ? 'disconnect' : 'connect'} ${net.b64} &"
            :tooltip "${net.active ? 'Disconnect' : 'Connect'}"
      "${net.active ? 'Disc' : 'Conn'}")
    (button :class "wifi-forget"
            :onclick "~/.config/eww/scripts/wifi-action.sh forget ${net.b64} &"
            :tooltip "Forget profile" "✕")))

(defwidget wifi_layout []
  (box :class "wifi-root" :orientation "v" :space-evenly false :spacing 12
    (box :class "wifi-header" :orientation "h" :space-evenly false :spacing 10
      (label :class "wifi-title" :text "󰖩 WIFI" :hexpand true :halign "start")
      (button :class "wifi-toggle"
              :onclick "~/.config/eww/scripts/wifi-action.sh toggle &"
              :tooltip "Toggle WiFi radio"
        "${WIFILIST.enabled == 'true' ? 'ON' : 'OFF'}")
      (button :class "wifi-rescan"
              :onclick "~/.config/eww/scripts/wifi-action.sh rescan &"
              :tooltip "Rescan" "↻"))
    ;; view switch: nearby scan results ↔ saved profiles / link details
    (box :class "panel-tabs" :orientation "h" :space-evenly true :spacing 8
      (button :class {WIFI_VIEW == "nearby" ? "panel-tab panel-tab-on" : "panel-tab"}
              :onclick "eww update WIFI_VIEW=nearby" "NEARBY")
      (button :class {WIFI_VIEW == "saved" ? "panel-tab panel-tab-on" : "panel-tab"}
              :onclick "eww update WIFI_VIEW=saved" "SAVED · ${arraylength(WIFISAVED.saved)}"))
    (label :class "wifi-current" :text "Connected · ${WIFILIST.current == '' ? '—' : WIFILIST.current}"
           :halign "start")
    ;; ── nearby view ──
    (scroll :class "wifi-scroll" :hscroll false :vscroll true :height 330
            :visible {WIFI_VIEW == "nearby"}
      (box :orientation "v" :space-evenly false :spacing 4
        ;; DESIGN_CONTRACT §9 — empty state. Visible only when the
        ;; networks array is empty so the panel never shows a blank box.
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {arraylength(WIFILIST.networks) == 0}
          (label :class "empty-glyph" :text "📡")
          (label :class "empty-title" :text "No networks in range")
          (label :class "empty-hint"  :text "Try Rescan, or move closer to an access point."))
        (for net in {WIFILIST.networks}
          (wifi_row :net {net}))))
    ;; ── saved profiles + link details view ──
    (scroll :class "wifi-scroll" :hscroll false :vscroll true :height 330
            :visible {WIFI_VIEW == "saved"}
      (box :orientation "v" :space-evenly false :spacing 4
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {arraylength(WIFISAVED.saved) == 0}
          (label :class "empty-glyph" :text "󰤯")
          (label :class "empty-title" :text "No saved networks")
          (label :class "empty-hint"  :text "Connect to a network once and it lands here."))
        (for net in {WIFISAVED.saved}
          (wifi_saved_row :net {net}))
        (box :class "wifi-details" :orientation "v" :space-evenly false :spacing 2
             :visible {WIFISAVED.details.iface != ""}
          (label :class "wifi-detail-line" :halign "start" :text "IFACE  ${WIFISAVED.details.iface}")
          (label :class "wifi-detail-line" :halign "start" :text "IP     ${WIFISAVED.details.ip}")
          (label :class "wifi-detail-line" :halign "start" :text "GW     ${WIFISAVED.details.gw}")
          (label :class "wifi-detail-line" :halign "start" :text "DNS    ${WIFISAVED.details.dns}"))))
    (box :orientation "h" :space-evenly true :spacing 10
      (button :class "wifi-advanced"
              :onclick "eww close wifi && nyxus-settings &"
              :tooltip "VPN & deeper network config in NYXUS Settings"
        "VPN & More")
      (button :class "wifi-close" :onclick "eww close wifi" "Close (Esc)"))))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · BLUETOOTH MANAGER
;; ═════════════════════════════════════════════════════════════════════

(defwidget bt_row [dev]
  (box :class {dev.connected ? "bt-row bt-row-conn" : "bt-row"}
       :orientation "h" :space-evenly false :spacing 10
    (label :class "bt-icon" :text "${dev.icon}")
    (box :orientation "v" :space-evenly false :spacing 2 :hexpand true :halign "start"
      (label :class "bt-name" :halign "start" :text "${dev.name}")
      (label :class "bt-mac"  :halign "start"
             :text "${dev.mac}${dev.battery >= 0 ? '  ·  🔋' + dev.battery + '%' : ''}"))
    (button :class "bt-act"
            :onclick "~/.config/eww/scripts/bt-action.sh ${dev.connected ? 'disconnect' : 'connect'} ${dev.mac} &"
            :tooltip "${dev.connected ? 'Disconnect' : 'Connect'}"
      "${dev.connected ? 'Disc' : 'Conn'}")
    (button :class "bt-act" :visible {!dev.paired}
            :onclick "~/.config/eww/scripts/bt-action.sh pair ${dev.mac} &"
            :tooltip "Pair" "Pair")
    (button :class {dev.trusted ? "bt-act bt-trusted" : "bt-act"} :visible {dev.paired}
            :onclick "~/.config/eww/scripts/bt-action.sh trust-toggle ${dev.mac} &"
            :tooltip "${dev.trusted ? 'Trusted — click to untrust' : 'Trust (auto-reconnect)'}"
      "${dev.trusted ? '✓Trust' : 'Trust'}")
    (button :class "bt-forget" :visible {dev.paired}
            :onclick "~/.config/eww/scripts/bt-action.sh unpair ${dev.mac} &"
            :tooltip "Forget" "✕")))

(defwidget bluetooth_layout []
  (box :class "bt-root" :orientation "v" :space-evenly false :spacing 12
    (box :class "bt-header" :orientation "h" :space-evenly false :spacing 10
      (label :class "bt-title" :text "BLUETOOTH" :hexpand true :halign "start")
      (button :class "bt-toggle"
              :onclick "~/.config/eww/scripts/bt-action.sh toggle &"
              :tooltip "Toggle adapter"
        "${BTLIST.powered == 'true' ? 'ON' : 'OFF'}")
      (button :class "bt-scan"
              :onclick "~/.config/eww/scripts/bt-action.sh scan &"
              :tooltip "Scan 8s"
        "${BTLIST.scanning == 'true' ? '⟳ scan' : 'Scan'}"))
    (scroll :class "bt-scroll" :hscroll false :vscroll true :height 360
      (box :orientation "v" :space-evenly false :spacing 4
        ;; DESIGN_CONTRACT §9 — empty state.
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {arraylength(BTLIST.devices) == 0}
          (label :class "empty-glyph" :text {BTLIST.powered == 'true' ? "" : ""})
          (label :class "empty-title" :text {BTLIST.powered == 'true' ? "No devices yet" : "Bluetooth is off"})
          (label :class "empty-hint"  :text {BTLIST.powered == 'true' ? "Tap Scan to discover nearby devices." : "Toggle the adapter on, then Scan."}))
        (for dev in {BTLIST.devices}
          (bt_row :dev {dev}))))
    (box :orientation "h" :space-evenly true :spacing 10
      (button :class "bt-advanced"
              :onclick "eww close bluetooth && nyxus-settings &"
              :tooltip "Deeper bluetooth config in NYXUS Settings"
        "More")
      (button :class "bt-close" :onclick "eww close bluetooth" "Close (Esc)"))))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · AUDIO MIXER
;; ═════════════════════════════════════════════════════════════════════

(defwidget mix_sink_row [s]
  (box :class {s.default ? "mix-row mix-row-default" : "mix-row"}
       :orientation "h" :space-evenly false :spacing 10
    (button :class "mix-pick"
            :onclick "~/.config/eww/scripts/audio-action.sh set-default-sink ${s.id} &"
            :tooltip "Make default" "${s.default ? '◉' : '○'}")
    (label :class "mix-name" :hexpand true :halign "start" :limit-width 28
           :text "${s.description}")
    (scale :class "mix-scale" :value "${s.vol}" :min 0 :max 150 :hexpand true
           :onchange "~/.config/eww/scripts/audio-action.sh set-sink-vol ${s.id} {} &")
    (label :class "mix-pct" :text "${s.vol}%")
    (button :class "mix-mute"
            :onclick "~/.config/eww/scripts/audio-action.sh toggle-sink-mute ${s.id} &"
      "${s.mute ? '✕' : '🔊'}")))

(defwidget mix_app_row [a]
  (box :class "mix-row" :orientation "h" :space-evenly false :spacing 10
    (label :class "mix-app-glyph" :text "♫")
    (label :class "mix-name" :hexpand true :halign "start" :limit-width 28 :text "${a.name}")
    (scale :class "mix-scale" :value "${a.vol}" :min 0 :max 150 :hexpand true
           :onchange "~/.config/eww/scripts/audio-action.sh set-app-vol ${a.id} {} &")
    (label :class "mix-pct" :text "${a.vol}%")
    (button :class "mix-mute"
            :onclick "~/.config/eww/scripts/audio-action.sh toggle-app-mute ${a.id} &"
      "${a.mute ? '✕' : '🔊'}")))

;; Input-device row — default-source pick + volume + mute, in-panel via
;; pactl/wpctl (no pavucontrol escape hatch; rev 2026-07-09).
(defwidget mix_source_row [s]
  (box :class {s.default ? "mix-row mix-row-default" : "mix-row"}
       :orientation "h" :space-evenly false :spacing 10
    (button :class "mix-pick"
            :onclick "~/.config/eww/scripts/audio-action.sh set-default-source ${s.id} &"
            :tooltip "Make default input" "${s.default ? '◉' : '○'}")
    (label :class "mix-name" :hexpand true :halign "start" :limit-width 28
           :text "${s.description}")
    (scale :class "mix-scale" :value "${s.vol}" :min 0 :max 150 :hexpand true
           :onchange "~/.config/eww/scripts/audio-action.sh set-source-vol ${s.id} {} &")
    (label :class "mix-pct" :text "${s.vol}%")
    (button :class "mix-mute"
            :onclick "~/.config/eww/scripts/audio-action.sh toggle-source-mute ${s.id} &"
      "${s.mute ? '✕' : ''}")))

(defwidget mixer_layout []
  (box :class "mix-root" :orientation "v" :space-evenly false :spacing 14
    (label :class "mix-title" :text "󰕾 AUDIO MIXER")

    (label :class "mix-section" :text "OUTPUT DEVICES" :halign "start")
    (scroll :class "mix-scroll" :vscroll true :hscroll false :height 150
      (box :orientation "v" :space-evenly false :spacing 4
        (for s in {AUDIOMIX.sinks}
          (mix_sink_row :s {s}))))

    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "mix-section" :text "INPUT DEVICES" :halign "start" :hexpand true)
      (button :class {MIX_SHOW_INPUTS ? "panel-tab panel-tab-on" : "panel-tab"}
              :onclick "eww update MIX_SHOW_INPUTS=${MIX_SHOW_INPUTS ? 'false' : 'true'}"
              :tooltip "Show/hide input devices"
        "${MIX_SHOW_INPUTS ? 'HIDE' : 'SHOW'}"))
    (box :orientation "v" :space-evenly false :spacing 4
         :visible {MIX_SHOW_INPUTS}
      (for s in {AUDIOMIX.sources}
        (mix_source_row :s {s})))

    (label :class "mix-section" :text "PER-APP" :halign "start")
    (scroll :class "mix-scroll" :vscroll true :hscroll false :height 150
      (box :orientation "v" :space-evenly false :spacing 4
        ;; DESIGN_CONTRACT §9 — empty state.
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {arraylength(AUDIOMIX.apps) == 0}
          (label :class "empty-glyph" :text "♪")
          (label :class "empty-title" :text "No apps playing audio")
          (label :class "empty-hint"  :text "Open a media app to see per-app volumes here."))
        (for a in {AUDIOMIX.apps}
          (mix_app_row :a {a}))))

    (box :orientation "h" :space-evenly true :spacing 10
      (button :class "mix-advanced"
              :onclick "eww close mixer && nyxus-settings &"
              :tooltip "Deeper audio config in NYXUS Settings"
        "More")
      (button :class "mix-close" :onclick "eww close mixer" "Close (Esc)"))))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · CALENDAR
;; ═════════════════════════════════════════════════════════════════════

(defwidget cal_day [c]
  (label :class {c.today ? "cal-day cal-day-today" :
                 c.inmonth ? "cal-day cal-day-in" : "cal-day cal-day-out"}
         :text "${c.d}"))

(defwidget cal_week [w]
  (box :class "cal-week" :orientation "h" :space-evenly true :spacing 4
    (for c in {w}
      (cal_day :c {c}))))

(defwidget calendar_layout []
  (box :class "cal-root" :orientation "v" :space-evenly false :spacing 14
    (label :class "cal-title" :text "${CALMONTH.month} ${CALMONTH.year}")
    (label :class "cal-today" :text "${TIME.long}")
    (box :class "cal-dow" :orientation "h" :space-evenly true :spacing 4
      (label :class "cal-dow-cell" :text "Su") (label :class "cal-dow-cell" :text "Mo")
      (label :class "cal-dow-cell" :text "Tu") (label :class "cal-dow-cell" :text "We")
      (label :class "cal-dow-cell" :text "Th") (label :class "cal-dow-cell" :text "Fr")
      (label :class "cal-dow-cell" :text "Sa"))
    (box :class "cal-grid" :orientation "v" :space-evenly false :spacing 4
      (for w in {CALMONTH.weeks}
        (cal_week :w {w})))
    (button :class "cal-close" :onclick "eww close calendar" "Close (Esc)")))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · NOTIFICATION CENTER
;; ═════════════════════════════════════════════════════════════════════

(defwidget notif_row [n]
  (box :class "notif-row" :orientation "h" :space-evenly false :spacing 10
    (label :class "notif-app" :text "${n.app}")
    (box :orientation "v" :space-evenly false :spacing 2 :hexpand true :halign "start"
      (label :class "notif-summary" :halign "start" :limit-width 36 :text "${n.summary}")
      (label :class "notif-body"    :halign "start" :limit-width 44 :text "${n.body}"))
    (button :class "notif-dismiss"
            :onclick "~/.config/eww/scripts/notif-action.sh close-id ${n.id} &"
            :tooltip "Dismiss" "✕")))

(defwidget notifications_layout []
  (box :class "notif-root" :orientation "v" :space-evenly false :spacing 12
    (box :class "notif-header" :orientation "h" :space-evenly false :spacing 10
      (label :class "notif-title" :text "NOTIFICATIONS · ${NOTIFLIST.total}" :hexpand true :halign "start")
      (button :class "notif-dnd"
              :onclick "~/.config/eww/scripts/notif-action.sh toggle-dnd &"
        "${NOTIFLIST.paused == 'true' ? 'DND' : 'ON'}")
      (button :class "notif-clear"
              :onclick "~/.config/eww/scripts/notif-action.sh clear-all &"
        "Clear all"))
    (scroll :class "notif-scroll" :vscroll true :hscroll false :height 460
      (box :orientation "v" :space-evenly false :spacing 6
        ;; DESIGN_CONTRACT §9 — empty state. NOTIFLIST.total is already
        ;; surfaced by notif-history.sh so we don't need arraylength here.
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {NOTIFLIST.total == 0}
          (label :class "empty-glyph" :text "✓")
          (label :class "empty-title" :text {NOTIFLIST.paused == 'true' ? "Do Not Disturb is on" : "All caught up"})
          (label :class "empty-hint"  :text {NOTIFLIST.paused == 'true' ? "Notifications are silenced. Toggle DND to resume." : "New notifications will appear here."}))
        (for n in {NOTIFLIST.items}
          (notif_row :n {n}))))
    (button :class "notif-close" :onclick "eww close notifications" "Close (Esc)")))

;; ═════════════════════════════════════════════════════════════════════
;; UPDATE CENTER — themed pending-updates surface (rev 2026-07-09).
;; Replaces the old raw `alacritty -e sudo pacman -Syu` bar/dashboard
;; click target. The terminal only appears for the interactive sudo
;; sync itself, launched explicitly from here.
;; ═════════════════════════════════════════════════════════════════════

(defwidget upd_row [p]
  (box :class "upd-row" :orientation "h" :space-evenly false :spacing 10
    (label :class "upd-name"  :hexpand true :halign "start" :limit-width 26 :text "${p.name}")
    (label :class "upd-old"   :text "${p.old}")
    (label :class "upd-arrow" :text "")
    (label :class "upd-new"   :text "${p.new}")))

(defwidget updates_layout []
  (box :class "upd-root" :orientation "v" :space-evenly false :spacing 12
    (box :class "upd-header" :orientation "h" :space-evenly false :spacing 10
      (label :class "upd-title" :text "󰚰 UPDATES · ${UPDATESLIST.count}" :hexpand true :halign "start")
      (button :class "upd-refresh"
              :onclick "rm -f ~/.cache/nyxus-updates.json && eww update UPDATESLIST=\"$(~/.config/eww/scripts/updates-list.sh)\" && eww update UPDATES=\"$(~/.config/eww/scripts/updates.sh)\" &"
              :tooltip "Re-check now" "↻"))
    (label :class "upd-sub" :halign "start"
           :text "checked ${UPDATESLIST.checked} · via ${UPDATESLIST.source}")
    (scroll :class "upd-scroll" :hscroll false :vscroll true :height 380
      (box :orientation "v" :space-evenly false :spacing 4
        (box :class "empty-state" :orientation "v" :space-evenly false :spacing 6
             :valign "center" :halign "center"
             :visible {UPDATESLIST.count == 0}
          (label :class "empty-glyph" :text "✓")
          (label :class "empty-title" :text "System is up to date")
          (label :class "empty-hint"  :text "Nothing pending. Check again any time."))
        (for p in {UPDATESLIST.packages}
          (upd_row :p {p}))))
    (box :orientation "h" :space-evenly true :spacing 10
      (button :class "upd-sync"
              :onclick "eww close updates && alacritty -e sh -c 'sudo pacman -Syu; rm -f ~/.cache/nyxus-updates.json; echo; read -p \"done — press enter\"' &"
              :tooltip "Run the full system upgrade (interactive sudo)"
              :visible {UPDATESLIST.count > 0}
        "Sync Now")
      (button :class "upd-close" :onclick "eww close updates" "Close (Esc)"))))

;; ═════════════════════════════════════════════════════════════════════
;; SPRINT 1 · WINDOWS
;; ═════════════════════════════════════════════════════════════════════

;; ─── Flyout sizing contract ───────────────────────────────────────────
;; All bar-anchored flyouts share x=16, y=78, anchor=bottom right so they
;; line up under the bottom-bar pill cluster regardless of which one the
;; user opens. Two width buckets:
;;   * 420px  — compact (single column, short content)
;;   * 460px  — list-heavy (scrollable rows of devices / items)
;; Heights cap at 560px so flyouts never exceed the visible workspace
;; on 1366×768 panels. Internal lists scroll inside the flyout body.
;; ──────────────────────────────────────────────────────────────────────

(defwindow quicksettings
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-quicksettings"
  :geometry (geometry :x "16" :y "78" :width "420px" :height "520px" :anchor "bottom right")
  (quicksettings_layout))

;; ── UFO console notification popup (fed by the dunst→EWW bridge) ──────
;; The message sits inside the saucer's screen window (same eye-trick as the
;; bottom-bar clock). dunst renders no popup of its own (skip_display); this
;; is the visible notification.
(defwidget notif_popup_card []
  (overlay
    (image :class "notif-ufo-frame" :path "assets/nyxus-notif-frame${SECSTATE.hacker == 'on' ? '-mono' : ''}.png"
           :image-width 470 :image-height 314)
    (box :class "notif-ufo" :orientation "v" :space-evenly false :halign "fill" :valign "fill"
         :style "padding: 96px 108px 132px 108px;"
      (label :class "notif-app" :halign "center" :limit-width 34
             :text {notif.app == "" || notif.app == "notify-send" ? "NYXUS" : notif.app})
      (label :class "notif-summary" :halign "center" :wrap true :limit-width 26 :text {notif.summary})
      (label :class "notif-body" :halign "center" :wrap true :limit-width 32 :text {notif.body}))))

(defwindow notif-popup
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-notif"
  :geometry (geometry :x "18" :y "56" :width "470px" :height "314px" :anchor "top right")
  (notif_popup_card))

(defwindow wifi
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-wifi"
  :geometry (geometry :x "16" :y "78" :width "460px" :height "560px" :anchor "bottom right")
  (wifi_layout))

(defwindow bluetooth
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-bluetooth"
  :geometry (geometry :x "16" :y "78" :width "460px" :height "560px" :anchor "bottom right")
  (bluetooth_layout))

(defwindow mixer
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-mixer"
  :geometry (geometry :x "16" :y "78" :width "460px" :height "560px" :anchor "bottom right")
  (mixer_layout))

(defwindow calendar
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-calendar"
  :geometry (geometry :x "16" :y "78" :width "420px" :height "480px" :anchor "bottom right")
  (calendar_layout))

(defwindow notifications
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-notifications"
  :geometry (geometry :x "16" :y "78" :width "460px" :height "560px" :anchor "bottom right")
  (notifications_layout))

(defwindow brightness-flyout
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-brightness"
  :geometry (geometry :x "16" :y "78" :width "420px" :height "200px" :anchor "bottom right")
  (brightness_flyout_layout))

(defwindow updates
  :monitor 0 :stacking "overlay" :focusable false :namespace "nyxus-updates"
  :geometry (geometry :x "16" :y "78" :width "460px" :height "560px" :anchor "bottom right")
  (updates_layout))

; ── NYXUS Dock module ─────────────────────────────────────────────────
(include "dock.yuck")
(include "hotkey.yuck")
(include "snap.yuck")
(include "mission.yuck")
(include "deepcore.yuck")
(include "quicksettings.yuck")
(include "osd-extra.yuck")
(include "splash.yuck")
