/* nyxus accent vars - generated by nyxus-apply-accent, imported here.
 * NEVER hand-edit accent.scss / _nyxus_accent.scss - run
 * nyxus-apply-accent (or fix its template) instead.                   */
@import "_nyxus_accent";

/* -- NYXUS . HOME-HUD shared tokens (mirrors ~/.nyxus/nyxus-home/style.py
 *    PALETTE + nyxus-palette.css rev r13 - fixed, preset-independent) -- */
$neon-orange: #ff7849;   // HUD "orange"  (fans / power)
$neon-green:  #6dffcf;   // HUD "green"   (network)
$neon-blue:   #4d9fff;   // HUD "blue"    (bluetooth)
$neon-cyan:   #ff2667;   // HUD "cyan"    (HOME station)
$neon-red:    #ff4d6b;   // HUD "red"     (music / danger)

$text:       #e8edf5;    // nyx_white_off
$dim:        #c8ccd6;    // nyx_grey_light
$grey-mid:   #9aa0ad;    // nyx_grey_mid
$grey-ghost: #6a6e78;    // nyx_grey_tertiary

$void-card:  rgba(7, 5, 14, 0.93);   // HUD card fill
$void-deep:  rgba(5, 1, 13, 0.97);   // HUD root sheet
$hairline:   rgba(255, 255, 255, 0.10);

/* -- Apple-grade design tokens (rev 2026-07-13) ----------------------- */
$radius-sm:   8px;
$radius-md:   12px;
$radius-lg:   14px;
$radius-xl:   16px;
$ease-apple:  cubic-bezier(0.23, 1, 0.32, 1);
$ease-glass:  cubic-bezier(0.16, 1, 0.2, 1);
$t-fast:      200ms $ease-glass;
$t-med:       280ms $ease-apple;
$t-slow:      350ms $ease-apple;

/* -- OBSIDIAN HUD VESSEL (rev 2026-07-12) -----------------------------
 * The premium bar-vessel DNA, lifted straight from the NYXUS Home cards
 * (~/.nyxus/nyxus-home/style.py _card_css): a deep obsidian near-black
 * fill (kills the old plum "wash"), a crisp glassy top sheen, a 1px
 * accent hairline with a bold 2px SOLID accent top-rule, a soft colored
 * outer glow, a real ink drop-shadow so the vessel floats off the bar,
 * and an inner ink vignette for depth. Pass the accent hue in; every
 * pill / tile / clock / ticker shares this exact language so the whole
 * bar reads as one machined obsidian instrument panel.
 * ------------------------------------------------------------------- */
@mixin obsidian-vessel($hue, $strength: 1.0) {
  background-color: rgba(8, 3, 16, 0.985);
  background-image:
    url('assets/fog-vessel.png'),
    linear-gradient(180deg,
      rgba(24, 12, 40, 0.34) 0%,
      rgba(6, 2, 12, 0.00) 52%);
  background-size: 240% 240%, 100% 100%;
  background-repeat: no-repeat, no-repeat;
  background-position: center, center;
  border: 1px solid rgba($hue, 0.48 * $strength);
  border-top: 2px solid rgba($hue, 0.95 * $strength);
  box-shadow:
    0 0 16px rgba($hue, 0.22 * $strength),
    0 6px 18px rgba(0, 0, 0, 0.62),
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    inset 0 0 14px rgba(0, 0, 0, 0.52),
    inset 0 -8px 18px rgba($hue, 0.06 * $strength);
}
@mixin obsidian-vessel-hover($hue) {
  border-color: rgba($hue, 0.95);
  box-shadow:
    0 0 22px rgba($hue, 0.50),
    0 0 40px rgba($hue, 0.22),
    0 6px 18px rgba(0, 0, 0, 0.6),
    inset 0 1px 0 rgba(255, 255, 255, 0.07),
    inset 0 0 12px rgba(0, 0, 0, 0.40);
}
/* pressed keycap: the button sinks -- ink floods in, the top sheen dies,
   a tight accent rim confirms the click. Pairs with obsidian-vessel. */
@mixin obsidian-press($hue) {
  background-color: rgba(2, 1, 6, 0.99);
  background-image: none;
  border-color: rgba($hue, 0.85);
  box-shadow:
    inset 0 2px 7px rgba(0, 0, 0, 0.7),
    inset 0 0 13px rgba(0, 0, 0, 0.6),
    0 0 11px rgba($hue, 0.32);
}
/* frosted obsidian cards on cosmic flyout backdrops - lighter than bar
   vessels so the milky-way / black-hole art still breathes through. */
@mixin flyout-glass($hue, $strength: 1.0) {
  background-color: rgba(5, 2, 11, 0.78);
  border: 1px solid rgba($hue, 0.32 * $strength);
  border-top: 1px solid rgba($hue, 0.62 * $strength);
  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.48),
    inset 0 1px 0 rgba(255, 255, 255, 0.05),
    inset 0 0 14px rgba(0, 0, 0, 0.38);
}
@mixin flyout-glass-hover($hue) {
  background-color: rgba(8, 4, 16, 0.86);
  border-color: rgba($hue, 0.58);
  box-shadow:
    0 0 18px rgba($hue, 0.28),
    0 4px 16px rgba(0, 0, 0, 0.48),
    inset 0 0 12px rgba($hue, 0.08);
}

/* soft tints derived from the live accent slots (auto-follow presets) */
$accent-primary-soft:   mix(#ffffff, $nyxus-accent-primary, 42%);
$accent-secondary-soft: mix(#ffffff, $nyxus-accent-secondary, 45%);
$accent-ok-soft:        mix(#ffffff, $nyxus-accent-ok, 45%);
$accent-warn-soft:      mix(#ffffff, $nyxus-accent-warn, 40%);
$accent-primary-deep:   mix(#000000, $nyxus-accent-primary, 30%);
$neon-red-soft:         mix(#ffffff, $neon-red, 35%);
$neon-green-soft:       mix(#ffffff, $neon-green, 30%);
$neon-orange-soft:      mix(#ffffff, $neon-orange, 30%);
$neon-blue-soft:        mix(#ffffff, $neon-blue, 40%);

/* ---------------------------------------------------------------------
 * NYXUS . EWW styles - DARK MIRROR aesthetic
 * (c) 2026 JOSEPH SIERENGOWSKI . NYX-J5W-2026-SIERENGOWSKI-LOCKED
 *
 * Palette:
 *   void-0     #05060a   (deep background)
 *   void-1     #0a0d14   (panel)
 *   void-2     #11151f   (raised)
 *   text       $text
 *   dim        $grey-mid
 *   magenta    $nyxus-accent-primary   (primary accent - hot prism)
 *   teal       $nyxus-accent-secondary   (secondary accent - electric signal)
 *   violet     $nyxus-accent-ok   (tertiary - obsidian refraction)
 *   gold       $nyxus-accent-warn   (warning / highlight)
 *   crimson    $neon-red   (critical / low)
 * --------------------------------------------------------------------- */

/* Kill the GTK theme's window/decoration paint - it was drawing a
   full-width brown slab under the bar margins (the "double bar" ghost). */
window, window.background, decoration {
  background: none;
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
}

* {
  all: unset;
  font-family: "Inter Display", "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 12px;
  color: $text;
}

/* Re-assert AFTER the `all: unset` above - unset reverts the window node
   to the GTK theme's opaque dark fill, which painted a full-width slab
   behind every bar (the ghost-HUD killer). Order matters here. */
window, window.background, decoration {
  background: none;
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
}

/* -- BARS . PRISM EYE CANDY ------------------------------------------- */
/* Every bar is a glass slab wrapped in a full prism rim: two stacked
   backgrounds, the glass painted on padding-box and the gradient on
   border-box, showing only through the transparent border. Alphas sit
   at .70-.86 so Hyprland's dual-kawase layer blur reads through the
   glass (the DARK MIRROR frosted look) without killing legibility. */

/* Structural shell: animated starfield + prism rim paint via inline :style
   in eww.yuck. Static fallbacks below keep bars obsidian if inline hiccups. */
.bar {
  border: 1px solid transparent;
  border-radius: 16px;
  padding: 4px 12px;
  box-shadow: none;
}

.bar-bottom {
  margin: 0 72px;
  padding: 0 8px;
  min-height: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  background-image: none;
  box-shadow: none;
}

.bar-top {
  margin: 0;
  padding: 0;
  min-height: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  background-image: none;
  box-shadow: none;
}

/* Top bar · ticker-only float — zero chrome, pure scrolling text */
.bar-top-ticker-only {
  margin: 0;
  padding: 0;
  min-height: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  background-image: none;
  box-shadow: none;
}

/* -- MINIMAL BOTTOM BAR (naked metrics + hub trigger) -------------- */
.bar-bottom-minimal {
  padding: 0 12px;
  min-height: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}
.bar-metrics-left,
.bar-metrics-right {
  padding: 0 8px;
  min-width: 0;
}
.bar-metric {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.10em;
  color: rgba($nyxus-accent-secondary, 0.92);
  text-shadow:
    0 0 12px rgba($nyxus-accent-secondary, 0.55),
    0 0 24px rgba($nyxus-accent-primary, 0.28);
}
.bar-metric-alert {
  color: #ffd9a0;
  text-shadow: 0 0 10px rgba(255, 160, 60, 0.75);
}
.bar-hub-trigger {
  padding: 0 6px;
  background: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  transition: all $t-fast;
}
.bar-hub-trigger:hover {
  color: #ffffff;
  text-shadow: 0 0 14px rgba($nyxus-accent-primary, 0.65);
}
.bar-hub-brand {
  font-family: "Inter Display", "Inter", sans-serif;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 0.38em;
  color: $nyxus-accent-primary;
  text-shadow:
    0 0 14px rgba($nyxus-accent-primary, 0.90),
    0 0 28px rgba($nyxus-accent-secondary, 0.45);
}
.bar-hub-time {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 23px;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: #ffffff;
  text-shadow:
    0 0 14px rgba($nyxus-accent-secondary, 0.80),
    0 0 26px rgba($nyxus-accent-primary, 0.50);
}
.bar-hub-date {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.10em;
  color: rgba($nyxus-accent-secondary, 0.92);
  text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.55);
}
.bar-hub-music-title {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: $neon-red;
  text-shadow:
    0 0 12px rgba($neon-red, 0.65),
    0 0 22px rgba($nyxus-accent-primary, 0.30);
}
.bar-hub-music-artist {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: rgba($nyxus-accent-secondary, 0.90);
  text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.45);
}
.bar-strip {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: rgba($nyxus-accent-secondary, 0.92);
  text-shadow:
    0 0 12px rgba($nyxus-accent-secondary, 0.55),
    0 0 24px rgba($nyxus-accent-primary, 0.28);
  min-width: 0;
}
.bar-strip-fans {
  color: rgba($neon-orange, 0.95);
  text-shadow:
    0 0 12px rgba($neon-orange, 0.55),
    0 0 22px rgba($nyxus-accent-primary, 0.25);
}
.bar-strip-net {
  color: rgba($neon-green, 0.95);
  text-shadow:
    0 0 12px rgba($neon-green, 0.50),
    0 0 22px rgba($nyxus-accent-secondary, 0.28);
}
.cava-mini {
  color: $nyxus-accent-secondary;
  font-size: 11px;
  letter-spacing: 0.02em;
  text-shadow:
    0 0 8px rgba($nyxus-accent-ok, 0.80),
    0 0 16px rgba($nyxus-accent-secondary, 0.40);
}

/* -- Phase 6 monitoring readouts (bottom-bar ghost HUD) --------------- */
/* Zero chrome: no background, no border, no slab. Each metric is a neon
   glyph + glowing live block-trace + mono value floating straight on the
   wallpaper - text-shadow glow carries the legibility (live-build-notes
   section 2 "ghost HUD / glow text only"). Hues: fan=orange, temp=gold,
   cpu=primary purple, gpu=blue, net down=green / up=magenta. */
.mon-cluster { min-height: 0; min-width: 0; background: transparent; }
.mon-cell {
  padding: 0 2px;
  background: transparent;
  border: none;
  box-shadow: none;
}
.mon-glyph {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 13px;
  min-width: 15px;
}
.mon-trace {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.02em;
}
.mon-value {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #e8edf5;
  text-shadow: 0 0 10px rgba(0, 0, 0, 0.85), 0 0 6px rgba(255, 255, 255, 0.28);
}
/* compact rows for the two-row stacked cells (dual fans, net down/up) */
.mon-trace-sm {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0.01em;
}
.mon-value-sm {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #e8edf5;
  text-shadow: 0 0 8px rgba(0, 0, 0, 0.85);
}
.mon-updown {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
}

/* hue variants: neon glyph + trace glow (double halo = ink for contrast
   on bright nebula regions + colored bloom for the neon read). */
.mon-glyph-orange { color: $neon-orange; text-shadow: 0 0 9px rgba($neon-orange, 0.75), 0 1px 6px rgba(0,0,0,0.9); }
.mon-trace-orange { color: rgba($neon-orange, 0.92); text-shadow: 0 0 10px rgba($neon-orange, 0.65), 0 0 22px rgba($neon-orange, 0.30), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-orange { color: $neon-orange-soft; }

.mon-glyph-gold { color: $nyxus-accent-warn; text-shadow: 0 0 9px rgba($nyxus-accent-warn, 0.75), 0 1px 6px rgba(0,0,0,0.9); }
.mon-trace-gold { color: rgba($nyxus-accent-warn, 0.92); text-shadow: 0 0 10px rgba($nyxus-accent-warn, 0.65), 0 0 22px rgba($nyxus-accent-warn, 0.30), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-gold { color: $accent-warn-soft; }

.mon-glyph-pink { color: $nyxus-accent-primary; text-shadow: 0 0 9px rgba($nyxus-accent-primary, 0.80), 0 1px 6px rgba(0,0,0,0.9); }
.mon-trace-pink { color: rgba($nyxus-accent-primary, 0.95); text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.70), 0 0 22px rgba($nyxus-accent-primary, 0.32), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-pink { color: $accent-primary-soft; }

.mon-glyph-blue { color: $neon-blue; text-shadow: 0 0 9px rgba($neon-blue, 0.75), 0 1px 6px rgba(0,0,0,0.9); }
.mon-trace-blue { color: rgba($neon-blue, 0.92); text-shadow: 0 0 10px rgba($neon-blue, 0.65), 0 0 22px rgba($neon-blue, 0.30), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-blue { color: $neon-blue-soft; }

.mon-glyph-green { color: $neon-green; text-shadow: 0 0 9px rgba($neon-green, 0.70), 0 1px 6px rgba(0,0,0,0.9); }
.mon-trace-green { color: rgba($neon-green, 0.92); text-shadow: 0 0 10px rgba($neon-green, 0.60), 0 0 22px rgba($neon-green, 0.28), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-green { color: $neon-green-soft; }

.mon-trace-secondary { color: rgba($nyxus-accent-secondary, 0.92); text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.62), 0 0 22px rgba($nyxus-accent-secondary, 0.30), 0 1px 5px rgba(0,0,0,0.85); }
.mon-value-secondary { color: $accent-secondary-soft; }

/* ember alert state (hot metric) + graceful-degrade dim (dGPU asleep) */
.mon-alert .mon-value { color: #ffd9a0; text-shadow: 0 0 12px rgba(255, 160, 60, 0.85), 0 1px 5px rgba(0,0,0,0.9); }
.mon-alert .mon-glyph { color: #ffb45e; text-shadow: 0 0 12px rgba(255, 160, 60, 0.85); }
.mon-dim { opacity: 0.45; }

/* -- STARFALL REACTOR NEXUS (bottom bar) --------------------------- */
.nexus-root {
  margin: 0 52px;
  padding: 0;
  min-height: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}
.nexus-starfall {
  min-height: 3px;
  margin: 0 12px;
  border-radius: 999px 999px 0 0;
  background-blend-mode: screen, screen;
  background-size: 100% 100%, 100% 100%;
  background-repeat: no-repeat;
  opacity: 0.88;
  box-shadow: 0 0 14px rgba($nyxus-accent-secondary, 0.35);
}
.nexus-deck {
  padding: 0 10px 4px;
  min-height: 44px;
  border-radius: $radius-xl;
  border: 1px solid transparent;
  border-top: 2px solid rgba($nyxus-accent-secondary, 0.55);
  background-blend-mode: screen, screen, normal, normal;
  background-size: 100% 100%, 100% 100%, 100% 100%, 100% 100%;
  background-origin: padding-box, padding-box, padding-box, border-box;
  background-clip:   padding-box, padding-box, padding-box, border-box;
}
.nexus-cava-river {
  min-height: 14px;
  padding: 1px 8px 0;
  margin: 3px 4px 0;
  border-radius: 999px;
  background: linear-gradient(90deg,
    rgba($nyxus-accent-primary, 0.06) 0%,
    rgba($nyxus-accent-secondary, 0.14) 50%,
    rgba($nyxus-accent-primary, 0.06) 100%);
  border-bottom: 1px solid rgba($nyxus-accent-secondary, 0.12);
}
.nexus-cava-wave {
  color: rgba($nyxus-accent-secondary, 0.92);
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-shadow:
    0 0 10px rgba($nyxus-accent-secondary, 0.75),
    0 0 20px rgba($nyxus-accent-primary, 0.40);
}
.nexus-command-row {
  padding: 2px 4px 3px;
  min-height: 32px;
}
.nexus-wing {
  min-width: 0;
  padding: 0 4px;
}
.nexus-wing-left  { padding-left: 2px; }
.nexus-wing-right { padding-right: 2px; }

/* Reactor-heart — elevated center core */
.nexus-heart {
  padding: 0 10px;
  margin: 0 6px;
}
.nexus-heart-btn {
  padding: 3px 20px 4px;
  border-radius: 999px;
  @include obsidian-vessel($nyxus-accent-secondary, 0.80);
  border-top: 2px solid rgba($nyxus-accent-secondary, 0.95);
  box-shadow:
    0 0 24px rgba($nyxus-accent-secondary, 0.35),
    0 0 48px rgba($nyxus-accent-primary, 0.18),
    0 4px 16px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    inset 0 0 20px rgba($nyxus-accent-primary, 0.10);
  transition: all $t-med;
}
.nexus-heart-btn:hover {
  @include obsidian-vessel-hover($nyxus-accent-secondary);
  box-shadow:
    0 0 32px rgba($nyxus-accent-secondary, 0.55),
    0 0 60px rgba($nyxus-accent-primary, 0.28),
    0 4px 16px rgba(0, 0, 0, 0.55);
}
.nexus-heart-btn:active { @include obsidian-press($nyxus-accent-secondary); }
.nexus-gem {
  color: $nyxus-accent-primary;
  font-size: 11px;
  text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.90);
}
.nexus-clock-hm {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #ffffff;
  text-shadow:
    0 0 14px rgba($nyxus-accent-secondary, 0.70),
    0 0 28px rgba($nyxus-accent-primary, 0.45);
}
.nexus-clock-date {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: rgba($nyxus-accent-secondary, 0.82);
  text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.45);
}

/* Orb action buttons — magnetic pills on the wings */
.nexus-orb {
  padding: 4px 10px;
  min-height: 28px;
  border-radius: 999px;
  @include obsidian-vessel($nyxus-accent-secondary, 0.55);
  border-color: rgba($nyxus-accent-secondary, 0.42);
  transition: all $t-fast;
}
.nexus-orb:hover {
  @include obsidian-vessel-hover($nyxus-accent-secondary);
  color: #ffffff;
}
.nexus-orb:active { @include obsidian-press($nyxus-accent-secondary); }
.nexus-orb-label {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 700;
  color: $text;
}
.orb-net   .nexus-orb-label { color: $neon-blue-soft; }
.orb-audio .nexus-orb-label { color: $accent-secondary-soft; }
.orb-brt   .nexus-orb-label { color: $accent-warn-soft; }
.orb-bt    .nexus-orb-label { color: $neon-blue-soft; }
.orb-batt  .nexus-orb-label { color: $neon-green-soft; }
.orb-notif .nexus-orb-label { color: $accent-primary-soft; }
.orb-qs    .nexus-orb-label { color: $accent-ok-soft; }
.orb-power .nexus-orb-label { color: $neon-red-soft; }
.nexus-orb:hover .nexus-orb-label {
  color: #ffffff;
  text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.65);
}
.orb-power:hover .nexus-orb-label {
  text-shadow: 0 0 12px rgba($neon-red, 0.75);
}

/* Reactor metric chips — orbit the heart */
.nexus-metrics {
  padding: 0 4px;
}
.reactor-chip {
  padding: 2px 7px;
  border-radius: 6px;
  @include obsidian-vessel($nyxus-accent-primary, 0.45);
  transition: all $t-fast;
}
.reactor-chip:hover {
  @include obsidian-vessel-hover($nyxus-accent-primary);
}
.reactor-chip-key {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: $grey-mid;
}
.reactor-chip-val {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 800;
  color: $text;
}
.reactor-chip-pink   { border-color: rgba($nyxus-accent-primary, 0.50); }
.reactor-chip-pink   .reactor-chip-val { color: $accent-primary-soft; text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.55); }
.reactor-chip-purple { border-color: rgba($nyxus-accent-ok, 0.50); }
.reactor-chip-purple .reactor-chip-val { color: $accent-ok-soft; text-shadow: 0 0 8px rgba($nyxus-accent-ok, 0.55); }
.reactor-chip-blue   { border-color: rgba($neon-blue, 0.50); }
.reactor-chip-blue   .reactor-chip-val { color: $neon-blue-soft; text-shadow: 0 0 8px rgba($neon-blue, 0.55); }
.reactor-chip-orange { border-color: rgba($neon-orange, 0.50); }
.reactor-chip-orange .reactor-chip-val { color: $neon-orange-soft; text-shadow: 0 0 8px rgba($neon-orange, 0.55); }
.reactor-chip-alert {
  border-color: rgba(255, 176, 80, 0.75);
  border-top-color: rgba(255, 200, 120, 0.95);
  box-shadow:
    0 0 14px rgba(255, 140, 40, 0.45),
    inset 0 0 8px rgba(255, 132, 32, 0.20);
}
.reactor-chip-alert .reactor-chip-val {
  color: #ffd9a0;
  text-shadow: 0 0 9px rgba(255, 160, 60, 0.80);
}

/* legacy bottom bar flip deck — removed, keep selectors harmless */
.bar-bottom-deck {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

/* Side rails are transparent columns — glass lives on .float-island only. */
.ws-rail, .app-rail {
  background: transparent;
  background-image: none;
  background-blend-mode: normal;
  border: none;
  box-shadow: none;
  padding: 0;
}
.bar-bottom > *, .bar-top > * { min-height: 0; min-width: 0; }
.bar-bottom .bar-cluster { min-height: 0; }
.bar-top .bar-cluster, .bar-bottom .bar-cluster { min-width: 0; }
.cluster-left, .cluster-right { min-width: 0; }

.bar-cluster { padding: 0 4px; }
.cluster-left  { padding-left: 0; }
.cluster-right { padding-right: 0; }

/* -- PILLS . glass capsules ----------------------------------------- */

/* HOME-HUD micro buttons: near-black fill, 1px neon hairline, square-ish
   radius, mono type, hover bloom (mirrors style.py btn-nav/btn-icon). */
/* Machined obsidian keycaps (rev 2026-07-12): same vessel + accent-ring
   language as the side rails, so every button on every bar matches.
   Glyph-forward: action pills are square caps, value pills keep their
   numbers. min-height locks the cap silhouette; no letter-spacing
   (it widened pills past their allocation and GTK ellipsized labels). */
.pill {
  padding: 4px 12px;
  min-height: 30px;
  min-width: 20px;
  border-radius: $radius-md;
  @include obsidian-vessel($nyxus-accent-primary);
  color: $text;
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 700;
  font-size: 11px;
  transition: all $t-med;
}
.pill-fog {
  /* inline :style sets background-position layer 1 for trapped fog drift */
}
.pill:hover {
  @include obsidian-vessel-hover($nyxus-accent-primary);
  color: #ffffff;
  text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.55);
}
.pill:active { @include obsidian-press($nyxus-accent-primary); }

/* -- PILL SPECTRUM . per-widget prism hues ---------------------------- */
/* Each status pill carries its own accent so the right cluster reads
   like light split through a prism. Declared BEFORE the state classes
   (mic-mute, bt-conn, batt-low, ...) so live states still win. */
/* Each hue recolors the whole border (incl. the 2px top-rule from .pill)
   and rides the premium obsidian shadow with its own colored outer glow. */
@mixin pill-hue($hue) {
  border-color: rgba($hue, 0.52);
  box-shadow:
    0 0 13px rgba($hue, 0.20),
    0 5px 16px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.05),
    inset 0 0 11px rgba(0, 0, 0, 0.45);
}
.p-brt   { color: $accent-warn-soft;      @include pill-hue($nyxus-accent-warn);
           text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.50); }
.p-audio { color: $accent-secondary-soft; @include pill-hue($nyxus-accent-secondary);
           text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.50); }
.p-mic   { color: $accent-primary-soft;   @include pill-hue($nyxus-accent-primary);
           text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.50); }
.p-net   { color: $neon-blue-soft;        @include pill-hue($neon-blue);
           text-shadow: 0 0 8px rgba($neon-blue, 0.50); }
.p-bt    { color: $neon-blue-soft;        @include pill-hue($neon-blue);
           text-shadow: 0 0 8px rgba($neon-blue, 0.45); }
.p-batt  { color: $neon-green-soft;       @include pill-hue($neon-green);
           text-shadow: 0 0 8px rgba($neon-green, 0.50); }
.p-pp    { color: $accent-ok-soft;        @include pill-hue($nyxus-accent-ok);
           text-shadow: 0 0 8px rgba($nyxus-accent-ok, 0.50); }
.p-upd   { color: $accent-warn-soft;      @include pill-hue($nyxus-accent-warn);
           text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.45); }
.p-notif { color: $accent-primary-soft;   @include pill-hue($nyxus-accent-primary);
           text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.50); }

.batt-charge {
  border-color: rgba($nyxus-accent-secondary, 0.45);
  color: $nyxus-accent-secondary;
}
.batt-low {
  border-color: rgba($neon-red, 0.55);
  color: $neon-red;
}

/* danger key: obsidian base (from .pill) + red top-rule; blooms red on
   hover, sinks on press. No translucent red fill -- keeps the wash off. */
.power-pill {
  @include pill-hue($neon-red);
  color: $neon-red-soft;
}
.power-pill:hover {
  @include obsidian-vessel-hover($neon-red);
  color: #ffffff;
  text-shadow: 0 0 10px rgba($neon-red, 0.6);
}
.power-pill:active { @include obsidian-press($neon-red); }

/* -- BRAND ---------------------------------------------------------- */

.brand {
  padding: 3px 12px 3px 8px;
  border-radius: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  border: 1px solid transparent;
  @include obsidian-vessel($neon-red, 0.95);
  color: #ffffff;
  box-shadow:
    0 0 18px rgba($neon-red, 0.35),
    0 6px 18px rgba(0, 0, 0, 0.62),
    inset 0 1px 0 rgba(255, 255, 255, 0.07),
    inset 0 0 14px rgba(0, 0, 0, 0.52);
}
.brand-gem {
  font-size: 14px;
  color: #ffffff;
  text-shadow:
    0 0 10px rgba(255, 255, 255, 0.95),
    0 0 22px rgba($neon-red, 0.75);
}
.brand-word {
  font-family: "Permanent Marker", "Inter", cursive;
  font-size: 13px;
  color: #ffffff;
  text-shadow:
    0 0 12px rgba($neon-red, 0.70),
    0 0 24px rgba($nyxus-accent-primary, 0.35);
}
.brand-stamp {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 7px;
  font-weight: 700;
  color: rgba(255, 220, 228, 0.82);
  letter-spacing: 0.18em;
}
.brand:hover {
  @include obsidian-vessel-hover($neon-red);
  box-shadow:
    0 0 28px rgba($neon-red, 0.55),
    0 0 48px rgba($nyxus-accent-primary, 0.22),
    0 6px 18px rgba(0, 0, 0, 0.62);
}
.brand-top {
  padding: 2px 10px 2px 6px;
  min-height: 22px;
  .brand-gem { font-size: 11px; }
  .brand-word { font-size: 11px; letter-spacing: 0.08em; }
}
.brand-bottom {
  margin-left: 0;
}

/* -- HEARTBEAT ------------------------------------------------------ */

.heartbeat {
  color: $nyxus-accent-secondary;
  font-size: 10px;
  /* 0.18em ellipsized this label in the centerbox slot ("SYS:LI...") */
  letter-spacing: 0.08em;
  padding: 0 8px;
  text-shadow:
    0 0 8px rgba($nyxus-accent-secondary, 0.75),
    0 0 18px rgba($nyxus-accent-secondary, 0.35);
}

/* -- SYS PULSE ------------------------------------------------------ */

/* container is transparent - the per-metric .hud-tile cards inside
   carry the HOME-HUD look (rev 2026-07-09) */
.syspulse {
  padding: 0;
  background: transparent;
  border: none;
}

/* -- CAVA VISUALIZER ------------------------------------------------- */

.cava-box {
  padding: 0 12px;
  border-radius: 999px;
  background: linear-gradient(90deg,
    rgba(9, 5, 18, 0.92),
    rgba(4, 2, 10, 0.96) 30%,
    rgba(4, 2, 10, 0.96) 70%,
    rgba(9, 5, 18, 0.92));
  border: 1px solid rgba($nyxus-accent-secondary, 0.30);
  box-shadow:
    0 0 13px rgba($nyxus-accent-secondary, 0.16),
    0 5px 16px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    inset 0 0 10px rgba(0, 0, 0, 0.42);
}
.cava-label {
  color: $nyxus-accent-secondary;
  font-size: 13px;
  text-shadow:
    0 0 8px rgba($nyxus-accent-ok, 0.85),
    0 0 16px rgba($nyxus-accent-secondary, 0.40);
}

.tray-dummy {
  color: $grey-ghost;
  letter-spacing: 0.3em;
  padding: 0 8px;
  border-radius: 4px;
  border: 1px dashed rgba(255, 255, 255, 0.08);
}

/* -- CLOCK ---------------------------------------------------------- */

/* HOME-HUD clock card: hairline shell + solid accent top rule, chunky
   mono numerals with white bloom (the dot-matrix voice). */
.clock {
  padding: 3px 18px;
  border-radius: 8px;
  @include obsidian-vessel($nyxus-accent-primary);
  transition: all 180ms ease;
}
.clock:hover { @include obsidian-vessel-hover($nyxus-accent-primary); }
.clock-glyph { color: $nyxus-accent-primary; font-size: 14px;
               text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.65); }
.clock-hms   { font-weight: 800; font-size: 20px; letter-spacing: 0.06em;
               color: #ffffff;
               text-shadow:
                 0 0 12px rgba(255, 255, 255, 0.70),
                 0 0 24px rgba($nyxus-accent-primary, 0.50); }
.clock-sec   { font-weight: 700; font-size: 11px; letter-spacing: 0.04em;
               color: rgba($nyxus-accent-secondary, 0.85);
               text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.55);
               padding-top: 4px; }
.clock-date  { color: $dim; font-size: 11px; letter-spacing: 0.16em; font-weight: 600; }
.bar-bottom .clock {
  min-width: 148px;
  padding: 2px 18px;
}

/* -- TICKER (top bar) ----------------------------------------------- */

/* full-width ticker vessel — legacy; naked ticker uses .ticker-naked */
.ticker-vessel {
  padding: 0;
  min-width: 0;
  background: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
}
.ticker-naked {
  padding: 2px 0;
  text-align: center;
}
.ticker-row {
  margin: 0 auto;
  padding: 0;
  min-width: 0;
  width: 100%;
  justify-content: center;
}
.ticker-marquee {
  text-align: center;
}
/* legacy float ticker (unused) */
.ticker-box-float {
  padding: 8px 0;
  min-width: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}
.ticker-hero {
  color: rgba($nyxus-accent-secondary, 0.98);
  font-family: "JetBrainsMono Nerd Font", "JetBrainsMono", monospace;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-shadow:
    0 0 14px rgba($nyxus-accent-secondary, 0.65),
    0 0 28px rgba($nyxus-accent-primary, 0.35);
  min-width: 0;
}

/* legacy ticker chrome (panels / dock reuse) */
.ticker-overlay {
  min-width: 700px;
}
.ticker-watermark {
  color: $nyxus-accent-primary;
  font-family: "Inter Display", "Inter", sans-serif;
  font-weight: 800;
  font-size: 10px;
  letter-spacing: 0.32em;
  padding: 1px 14px;
  background: linear-gradient(180deg, rgba(7, 3, 14, 0.97), rgba(4, 2, 10, 0.94));
  border: 1px solid rgba($nyxus-accent-primary, 0.48);
  border-radius: 5px;
  text-shadow:
    0 0 10px rgba($nyxus-accent-primary, 0.90),
    0 0 22px rgba($nyxus-accent-primary, 0.45);
}
/* full-width scrolling ribbon - dressed as obsidian HUD marquee card */
.ticker-box {
  padding: 2px 14px;
  border-radius: 10px;
  @include obsidian-vessel($nyxus-accent-secondary, 0.72);
  min-width: 0;
  box-shadow:
    0 0 14px rgba($nyxus-accent-secondary, 0.18),
    0 5px 16px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    inset 0 0 12px rgba($nyxus-accent-secondary, 0.08);
}
.ticker-label {
  font-family: "Permanent Marker", "Inter", cursive;
  font-size: 10px;
  color: $nyxus-accent-primary;
  text-shadow:
    0 0 10px rgba($nyxus-accent-primary, 0.75),
    0 0 20px rgba($nyxus-accent-secondary, 0.35);
  padding-right: 2px;
}
.ticker {
  color: rgba($nyxus-accent-secondary, 0.95);
  font-family: "JetBrainsMono Nerd Font", "JetBrainsMono", monospace;
  font-size: 10px;
  text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.55);
  min-width: 0;
}

/* -- SIDE RAILS · float islands (no vertical slab) ----------------- */

.ws-rail, .app-rail,
.ws-rail-float, .app-rail-float {
  background: transparent;
  background-image: none;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  box-shadow: none;
  min-width: 0;
}

/* Per-button float — pink rim always on, subtle fill, glow on hover. */
.float-island {
  margin-bottom: 8px;
  padding: 3px 4px;
  border-radius: 11px;
  background: rgba(255, 38, 103, 0.04);
  background-color: rgba(255, 38, 103, 0.04);
  border: 1px solid rgba(255, 38, 103, 0.55);
  box-shadow:
    0 0 8px rgba(255, 38, 103, 0.12),
    inset 0 0 10px rgba(255, 38, 103, 0.04);
  transition: all $t-fast;
}
.float-island:hover {
  border-color: rgba(255, 38, 103, 0.78);
  background: rgba(255, 38, 103, 0.08);
  box-shadow:
    0 0 16px rgba(255, 38, 103, 0.35),
    inset 0 0 12px rgba(255, 38, 103, 0.08);
}
.float-island:active {
  border-color: rgba(255, 38, 103, 0.90);
  box-shadow: 0 0 12px rgba(255, 38, 103, 0.42);
}

.float-island .ws-pill,
.float-island .app-pill,
.float-island .ws-pill-pink,
.float-island .ws-pill-green,
.float-island .ws-pill-purple,
.float-island .ws-pill-gold,
.float-island .ws-pill-orange,
.float-island .ws-pill-blue,
.float-island .ws-pill-cyan,
.float-island .app-pill-pink,
.float-island .app-pill-green,
.float-island .app-pill-purple,
.float-island .app-pill-gold,
.float-island .app-pill-orange,
.float-island .app-pill-blue {
  background: transparent;
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  margin: 0;
}
.float-island .ws-pill:hover,
.float-island .app-pill:hover,
.float-island .ws-pill-pink:hover,
.float-island .ws-pill-green:hover,
.float-island .ws-pill-purple:hover,
.float-island .ws-pill-gold:hover,
.float-island .ws-pill-orange:hover,
.float-island .ws-pill-blue:hover,
.float-island .ws-pill-cyan:hover,
.float-island .app-pill-pink:hover,
.float-island .app-pill-green:hover,
.float-island .app-pill-purple:hover,
.float-island .app-pill-gold:hover,
.float-island .app-pill-orange:hover,
.float-island .app-pill-blue:hover {
  background: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
}

.ws-pill {
  min-width: 38px;
  min-height: 38px;
  border-radius: $radius-md;
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 700;
  font-size: 12px;
  transition: all $t-fast;
}
.ws-rail-divider {
  opacity: 0;
  min-height: 0;
  min-width: 0;
  margin: 0;
  padding: 0;
  background: none;
}

.app-pill {
  min-width: 38px;
  min-height: 38px;
  border-radius: $radius-md;
  color: $dim;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 16px;
  transition: all $t-fast;
}
.app-pill:active { @include obsidian-press($nyxus-accent-primary); }

/* -- BOOT SPLASH (nyxus-splash namespace) ---------------------------- */

.splash-root {
  background-color: rgba(3, 1, 7, 0.98);
  background-image:
    linear-gradient(180deg, rgba(4, 2, 10, 0.35), rgba(2, 1, 6, 0.72)),
    url('assets/cosmic-overlay-splash.png');
  background-size: cover;
  background-position: center;
}
.splash-glyph {
  font-size: 48px;
  font-weight: 700;
  color: #ffffff;
  text-shadow:
    0 0 24px rgba($nyxus-accent-primary, 0.75),
    0 0 48px rgba($nyxus-accent-secondary, 0.45);
}
.splash-word {
  font-family: "Permanent Marker", "Inter Display", sans-serif;
  font-size: 72px;
  font-weight: 400;
  letter-spacing: 0.18em;
  color: #ffffff;
  text-shadow:
    0 0 20px rgba($nyxus-accent-primary, 0.85),
    0 0 40px rgba($nyxus-accent-secondary, 0.45);
}
.splash-tag {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 11px;
  letter-spacing: 0.28em;
  color: $grey-mid;
  padding-top: 8px;
}
.splash-foot {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  letter-spacing: 0.22em;
  color: $grey-ghost;
  padding-bottom: 24px;
}

/* -- OVERLAY BACKDROP ------------------------------------------------ */
/* Fullscreen tinted sheet behind dashboard / powermenu / cheatsheet.
   Alpha 0.34 clears Hyprland's layerrule ignore_alpha 0.2 so the
   compositor frosts the ENTIRE screen behind the overlay - desktop,
   windows and their shadows all melt into blurred glass. */
/* Near-opaque ink sheet (rev 2026-07-09): the user wants overlays to
   read as a solid dimmed backdrop - no desktop bleed. Alpha stays a
   hair under 1.0 so the Hyprland layerrule blur still catches edges. */
.overlay-backdrop {
  /* Transparent frosted dim (rev 2026-07-14): lets the Hyprland-blurred
     wallpaper read through the fullscreen overlays while still focusing
     the eye on the centered panel. */
  background: radial-gradient(circle at 50% 42%,
    rgba(12, 6, 24, 0.50),
    rgba(3, 1, 9, 0.74));
}

/* -- starfield veil (Phase 5.5) ------------------------------------- */
/* Subtle Rolls-Royce twinkle dropped as the TOP child of an (overlay ...)
   over a menu/panel. Transparent star frames over the blurred wallpaper;
   kept low-opacity so it reads as a faint sparkle, never noisy. The box
   owns no input window so clicks pass straight through. */
.starfield-veil {
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  opacity: 0.30;
}
.starfield-veil-full {
  background-size: cover;
  opacity: 0.22;
}

/* -- NYXUS MAIN HUB overlay ----------------------------------------- */
.hub-backdrop {
  background: radial-gradient(circle at 50% 40%,
    rgba(12, 6, 24, 0.42),
    rgba(3, 1, 9, 0.68));
}
.hub-panel {
  min-width: 900px;
  padding: 28px 32px 24px;
  border-radius: $radius-xl;
  border: 1px solid transparent;
  background-color: rgba(7, 3, 15, 0.24);
  background-blend-mode: normal;
  background-size: cover;
  background-origin: border-box;
  background-clip:   border-box;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-primary, 0.14),
    0 0 56px rgba($nyxus-accent-primary, 0.24),
    0 32px 96px rgba(0, 0, 0, 0.86),
    inset 0 0 72px rgba($nyxus-accent-primary, 0.07);
}
.hub-title {
  color: $nyxus-accent-primary;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 0.32em;
  text-shadow:
    0 0 18px rgba($nyxus-accent-primary, 0.65),
    0 0 36px rgba($nyxus-accent-secondary, 0.25);
}
.hub-subtitle {
  color: $grey-mid;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
  padding-bottom: 4px;
}
.hub-section-title {
  color: $nyxus-accent-secondary;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.28em;
  padding-top: 6px;
  text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.45);
}
.hub-grid {
  padding: 4px 0 2px;
}
.hub-tile {
  padding: 14px 10px;
  min-width: 96px;
  border-radius: $radius-md;
  @include flyout-glass($nyxus-accent-primary, 0.62);
  transition: all $t-med;
}
.hub-tile:hover {
  @include flyout-glass-hover($nyxus-accent-primary);
}
.hub-tile-glyph { font-size: 22px; }
.hub-tile-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: $dim;
}
.hub-tile-green  { border-color: rgba($nyxus-accent-secondary, 0.45); }
.hub-tile-green  .hub-tile-glyph { color: $nyxus-accent-secondary; text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.55); }
.hub-tile-blue   { border-color: rgba($neon-blue, 0.45); }
.hub-tile-blue   .hub-tile-glyph { color: $neon-blue; text-shadow: 0 0 12px rgba($neon-blue, 0.55); }
.hub-tile-purple { border-color: rgba($nyxus-accent-ok, 0.45); }
.hub-tile-purple .hub-tile-glyph { color: $nyxus-accent-ok; text-shadow: 0 0 12px rgba($nyxus-accent-ok, 0.55); }
.hub-tile-pink   { border-color: rgba($nyxus-accent-primary, 0.45); }
.hub-tile-pink   .hub-tile-glyph { color: $nyxus-accent-primary; text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.55); }
.hub-tile-gold   { border-color: rgba($nyxus-accent-warn, 0.45); }
.hub-tile-gold   .hub-tile-glyph { color: $nyxus-accent-warn; text-shadow: 0 0 12px rgba($nyxus-accent-warn, 0.55); }
.hub-tile-orange { border-color: rgba($neon-orange, 0.45); }
.hub-tile-orange .hub-tile-glyph { color: $neon-orange; text-shadow: 0 0 12px rgba($neon-orange, 0.55); }
.hub-tile-cyan   { border-color: rgba($neon-cyan, 0.45); }
.hub-tile-cyan   .hub-tile-glyph { color: rgba($neon-cyan, 0.92); text-shadow: 0 0 12px rgba($neon-cyan, 0.55); }
.hub-tile-red    { border-color: rgba($neon-red, 0.45); }
.hub-tile-red    .hub-tile-glyph { color: $neon-red; text-shadow: 0 0 12px rgba($neon-red, 0.55); }
.hub-slider-row {
  padding: 2px 0;
}
.hub-slider-label {
  min-width: 36px;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: $grey-mid;
}
.hub-ws-row {
  padding: 4px 0 8px;
}
.hub-ws-pill {
  min-width: 38px;
  min-height: 34px;
  padding: 4px 8px;
  border-radius: $radius-sm;
  @include flyout-glass($nyxus-accent-primary, 0.50);
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 11px;
  font-weight: 700;
  color: $dim;
  transition: all $t-fast;
}
.hub-ws-pill:hover { @include flyout-glass-hover($nyxus-accent-primary); color: #ffffff; }
.hub-ws-active {
  border-color: rgba($nyxus-accent-primary, 0.85);
  color: #ffffff;
  text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.75);
}
.hub-ws-occupied { color: $accent-primary-soft; }
.hub-ws-pink   { border-color: rgba($nyxus-accent-primary, 0.40); color: $accent-primary-soft; }
.hub-ws-green  { border-color: rgba($nyxus-accent-secondary, 0.40); color: $accent-secondary-soft; }
.hub-ws-purple { border-color: rgba($nyxus-accent-ok, 0.40); color: $accent-ok-soft; }
.hub-ws-gold   { border-color: rgba($nyxus-accent-warn, 0.40); color: $accent-warn-soft; }
.hub-ws-orange { border-color: rgba($neon-orange, 0.40); color: $neon-orange-soft; }
.hub-ws-blue   { border-color: rgba($neon-blue, 0.40); color: $neon-blue-soft; }
.hub-ws-cyan   { border-color: rgba($neon-cyan, 0.40); color: rgba($neon-cyan, 0.88); }
.hub-close-x {
  padding: 4px 10px;
  border-radius: 8px;
  background: rgba(17, 21, 31, 0.55);
  border: 1px solid rgba($nyxus-accent-primary, 0.25);
  color: $grey-mid;
  font-size: 14px;
  transition: all $t-fast;
}
.hub-close-x:hover {
  color: $nyxus-accent-primary;
  border-color: rgba($nyxus-accent-primary, 0.55);
}
.hub-close {
  margin-top: 8px;
  padding: 8px 18px;
  border-radius: 10px;
  background: rgba(17, 21, 31, 0.65);
  border: 1px solid rgba($nyxus-accent-secondary, 0.25);
  color: $grey-mid;
  font-size: 11px;
  transition: all $t-fast;
}
.hub-close:hover {
  color: $nyxus-accent-secondary;
  border-color: rgba($nyxus-accent-secondary, 0.55);
}
.hub-power-row { padding-top: 2px; }

/* -- DEEP CORE overlay ----------------------------------------------- */

.deepcore-root {
  background-color: rgba(6, 2, 15, 0.42);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.54), rgba(4, 2, 11, 0.22));
  background-size: cover;
  background-position: center;
  padding: 48px 56px;
  border: 1px solid rgba($nyxus-accent-secondary, 0.42);
  border-top: 2px solid $nyxus-accent-secondary;
  border-radius: 12px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 40px 120px rgba(0, 0, 0, 0.85),
    inset 0 0 80px rgba($nyxus-accent-ok, 0.06);
}
.dc-title {
  color: $nyxus-accent-warn;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.35em;
  text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.50);
}
.dc-sub {
  color: $grey-mid;
  font-size: 10px;
  letter-spacing: 0.22em;
}
.dc-cols { padding: 10px 0; }
.dc-col {
  padding: 18px 22px;
  border-radius: 8px;
  background: $void-card;
  border: 1px dashed rgba($nyxus-accent-ok, 0.45);
  border-top: 2px solid $nyxus-accent-ok;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  min-width: 300px;
}
.dc-section {
  color: $nyxus-accent-ok;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.30em;
  text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.45);
}
.dc-row { padding: 2px 0; }
.dc-key {
  color: $nyxus-accent-secondary;
  font-size: 11px;
  font-weight: 700;
  min-width: 110px;
}
.dc-val  { color: $text; font-size: 11px; }
.dc-bad  { color: $neon-red; text-shadow: 0 0 8px rgba($neon-red, 0.45); }
.dc-live { color: $neon-green; text-shadow: 0 0 8px rgba($neon-green, 0.45); }
.dc-dot-on  { color: $neon-green; text-shadow: 0 0 10px rgba($neon-green, 0.75); }
.dc-dot-off { color: $neon-red; }
.dc-close {
  margin-top: 6px;
  padding: 8px 18px;
  border-radius: 10px;
  background: rgba(17, 21, 31, 0.65);
  border: 1px solid rgba($nyxus-accent-secondary, 0.25);
  color: $grey-mid;
  font-size: 11px;
  transition: all 180ms ease;
}
.dc-close:hover { color: $nyxus-accent-secondary; border-color: rgba($nyxus-accent-secondary, 0.55); }

/* -- DASHBOARD overlay ---------------------------------------------- */

.dashboard-root {
  background-color: rgba(6, 2, 15, 0.42);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.54), rgba(4, 2, 11, 0.22));
  background-size: cover;
  background-position: center;
  padding: 80px 60px;
  border: 2px solid rgba($nyxus-accent-secondary, 0.35);
  border-radius: 28px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 40px 120px rgba(0, 0, 0, 0.85),
    inset 0 0 80px rgba($nyxus-accent-primary, 0.06);
}
/* Scroll wrapper around dashboard content (only visible when content
   exceeds viewport height - typical 1366x768 keeps it hidden). */
.dashboard-scroll {
  background: transparent;
  /* Make scrollbar match the dark/violet theme rather than the default
     GTK accent - keeps the panel visually quiet when it does appear. */
}
.dashboard-scroll scrollbar {
  background: transparent;
  border: none;
}
.dashboard-scroll scrollbar slider {
  background: rgba($nyxus-accent-primary, 0.35);
  border-radius: 4px;
  min-width: 6px;
  min-height: 24px;
}
.dashboard-scroll scrollbar slider:hover { background: rgba($nyxus-accent-primary, 0.65); }
.dash-clock {
  font-size: 88px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #ffffff;
  text-shadow: 0 0 32px rgba($nyxus-accent-primary, 0.55);
}
.dash-date {
  font-size: 16px;
  color: $dim;
  letter-spacing: 0.20em;
}
.dash-grid { padding: 24px 0; }
/* HOME-HUD card: near-black fill, 1px dashed neon hairline, 2px solid
   neon top rule, radius 8 (mirrors style.py _card_css). */
.dash-card {
  padding: 20px 28px;
  border-radius: 8px;
  @include flyout-glass($nyxus-accent-primary, 0.72);
  min-width: 200px;
  transition: all 320ms ease;
}
.dash-card:hover {
  @include flyout-glass-hover($nyxus-accent-primary);
}
/* Each card carries its own neon (HUD: Clock=pink, Weather=gold,
   Music=red, System=pink, Fans=orange, Network=green, Storage=gold):
   weather=gold, system=pink, power=orange, calendar=purple, media=red */
.dash-grid .dash-card:nth-child(1) { border-color: rgba($nyxus-accent-warn, 0.55); border-top-color: $nyxus-accent-warn;
  box-shadow: 0 0 18px rgba($nyxus-accent-warn, 0.20), 0 6px 22px rgba(0,0,0,0.55), inset 0 0 24px rgba(0,0,0,0.18); }
.dash-grid .dash-card:nth-child(1) .dash-card-title { color: $nyxus-accent-warn; text-shadow: 0 0 10px rgba($nyxus-accent-warn, 0.45); }
.dash-grid .dash-card:nth-child(2) { border-color: rgba($nyxus-accent-primary, 0.55); border-top-color: $nyxus-accent-primary; }
.dash-grid .dash-card:nth-child(2) .dash-card-title { color: $nyxus-accent-primary; text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.45); }
.dash-grid .dash-card:nth-child(3) { border-color: rgba($neon-orange, 0.55); border-top-color: $neon-orange;
  box-shadow: 0 0 18px rgba($neon-orange, 0.20), 0 6px 22px rgba(0,0,0,0.55), inset 0 0 24px rgba(0,0,0,0.18); }
.dash-grid .dash-card:nth-child(3) .dash-card-title { color: $neon-orange; text-shadow: 0 0 10px rgba($neon-orange, 0.45); }
.dash-grid .dash-card:nth-child(4) { border-color: rgba($nyxus-accent-ok, 0.55); border-top-color: $nyxus-accent-ok;
  box-shadow: 0 0 18px rgba($nyxus-accent-ok, 0.20), 0 6px 22px rgba(0,0,0,0.55), inset 0 0 24px rgba(0,0,0,0.18); }
.dash-grid .dash-card:nth-child(4) .dash-card-title { color: $nyxus-accent-ok; text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.45); }
.dash-grid .dash-card:nth-child(5) { border-color: rgba($neon-red, 0.55); border-top-color: $neon-red;
  box-shadow: 0 0 18px rgba($neon-red, 0.20), 0 6px 22px rgba(0,0,0,0.55), inset 0 0 24px rgba(0,0,0,0.18); }
.dash-grid .dash-card:nth-child(5) .dash-card-title { color: $neon-red; text-shadow: 0 0 10px rgba($neon-red, 0.45); }
.dash-card-title {
  color: $nyxus-accent-ok;
  letter-spacing: 0.30em;
  font-size: 10px;
  font-weight: 700;
  text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.40);
}
.dash-card-big {
  font-size: 36px;
  font-weight: 700;
  color: #ffffff;
}
/* fine mono micro-label in dim gray (HUD hud-mini-title voice) */
.dash-card-sub {
  color: $grey-mid;
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.18em;
}
.dash-toggle {
  padding: 12px 8px;
  border-radius: 12px;
  background: rgba(17, 21, 31, 0.65);
  border: 1px solid rgba($nyxus-accent-primary, 0.15);
  /* no letter-spacing here: it inherits into the label and ellipsizes
     text inside the homogeneous space-evenly toggle row */
  font-size: 11px;
  transition: all 180ms ease;
}
.dash-toggle:hover {
  background: rgba($nyxus-accent-primary, 0.20);
  border-color: rgba($nyxus-accent-primary, 0.55);
  box-shadow: 0 0 18px rgba($nyxus-accent-primary, 0.35);
}
.dash-close {
  margin-top: 16px;
  padding: 8px 18px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: $grey-mid;
  letter-spacing: 0.16em;
  font-size: 10px;
}
.dash-close:hover { color: #ffffff; border-color: rgba(255, 255, 255, 0.40); }

/* -- POWERMENU overlay . Obsidian Prism ----------------------------- */

.powermenu-root {
  background-color: rgba(6, 2, 15, 0.42);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.54), rgba(4, 2, 11, 0.22));
  background-size: cover;
  background-position: center;
  padding: 60px 80px;
  min-width: 720px;
  border: 1px solid rgba($nyxus-accent-secondary, 0.42);
  border-radius: 12px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 40px 120px rgba(0, 0, 0, 0.85),
    inset 0 0 60px rgba($nyxus-accent-ok, 0.04);
}
.power-title {
  color: $nyxus-accent-warn;
  font-size: 13px;
  letter-spacing: 0.40em;
  font-weight: 700;
  padding-bottom: 16px;
  text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.45);
}
.power-btn {
  min-width: 150px;
  min-height: 130px;
  border-radius: 10px;
  @include obsidian-vessel($nyxus-accent-ok, 0.85);
  transition: all 180ms ease;
}
.power-btn:hover {
  @include obsidian-vessel-hover($nyxus-accent-ok);
}
/* Destructive variants (Shutdown/Restart) - red border + glyph in
   resting state so they read as obviously different from soft actions
   (Suspend/Logout/Lock). Per DESIGN_CONTRACT.md S8. */
.power-btn-danger {
  border-color: rgba($neon-red, 0.45);
  background: rgba(40, 12, 22, 0.55);
}
.power-btn-danger .power-glyph { color: $neon-red-soft; }
.power-btn-danger:hover {
  border-color: rgba($neon-red, 0.85);
  box-shadow: 0 0 36px rgba($neon-red, 0.55);
}
.power-glyph {
  font-size: 40px;
  color: #ffffff;
}
.power-label {
  font-size: 11px;
  /* NO letter-spacing here: CSS letter-spacing widens the rendered text
     beyond the width GTK reserved for the label, so homogeneous grids
     ellipsize ("Shutdo..."). Weight carries the style instead. */
  font-weight: 700;
  color: $dim;
}
.power-cancel {
  margin-top: 16px;
  padding: 8px 18px;
  border-radius: 10px;
  border: 1px solid rgba($nyxus-accent-ok, 0.28);
  color: $grey-mid;
  letter-spacing: 0.16em;
  font-size: 10px;
}
.power-cancel:hover { color: $nyxus-accent-secondary; border-color: rgba($nyxus-accent-secondary, 0.45); }

/* -- DASHBOARD . sliders + calendar (additions) ---------------------- */

.dash-card-cal { min-width: 240px; }
.dash-cal-grid {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 12px;
  color: $dim;
  letter-spacing: 0.04em;
  /* line-height unsupported by GTK CSS */
}
.dash-sliders { padding: 12px 0; min-width: 480px; }
.dash-slider-row { padding: 0 8px; }
.dash-slider-label {
  color: $nyxus-accent-ok;
  letter-spacing: 0.20em;
  font-weight: 700;
  font-size: 10px;
  min-width: 36px;
  text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.40);
}
.dash-scale trough {
  min-height: 6px;
  border-radius: 6px;
  background: rgba(17, 21, 31, 0.85);
  border: 1px solid rgba($nyxus-accent-primary, 0.18);
}
.dash-scale highlight {
  border-radius: 6px;
  background: linear-gradient(90deg, $nyxus-accent-primary, $nyxus-accent-secondary);
  box-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.55);
}
.dash-scale slider {
  background: #ffffff;
  min-width: 14px;
  min-height: 14px;
  border-radius: 14px;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.55);
  margin: -6px;
}
.dash-toggle-glyph { font-size: 22px; }
.dash-toggle-label {
  font-size: 10px;
  /* letter-spacing removed: it ellipsizes labels in homogeneous grids */
  font-weight: 700;
  color: $dim;
}

/* -- CHEATSHEET ------------------------------------------------------ */

.cheatsheet-root {
  background-color: rgba(6, 2, 15, 0.42);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.54), rgba(4, 2, 11, 0.22));
  background-size: cover;
  background-position: center;
  padding: 60px 80px;
  border: 1px solid rgba($nyxus-accent-secondary, 0.42);
  border-radius: 12px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 40px 120px rgba(0, 0, 0, 0.85),
    inset 0 0 80px rgba($nyxus-accent-ok, 0.06);
}
.cheat-title {
  color: $nyxus-accent-warn;
  font-size: 14px;
  letter-spacing: 0.40em;
  font-weight: 700;
  padding-bottom: 12px;
  text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.45);
}
.cheat-section {
  color: $nyxus-accent-ok;
  letter-spacing: 0.30em;
  font-size: 10px;
  font-weight: 700;
  padding-bottom: 8px;
  text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.40);
}
.cheat-col {
  padding: 16px 24px;
  border-radius: 8px;
  min-width: 280px;
  @include flyout-glass($nyxus-accent-ok, 0.65);
}
.cheat-row { padding: 3px 0; }
.cheat-chord {
  font-family: "JetBrainsMono Nerd Font", monospace;
  color: $nyxus-accent-secondary;
  font-size: 11px;
  min-width: 130px;
  letter-spacing: 0.04em;
}
.cheat-action {
  color: $dim;
  font-size: 11px;
}
.cheat-close {
  margin-top: 16px;
  padding: 8px 18px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: $grey-mid;
  letter-spacing: 0.16em;
  font-size: 10px;
}
.cheat-close:hover { color: #ffffff; border-color: rgba(255, 255, 255, 0.40); }

/* -- OSD pop-ups ----------------------------------------------------- */

.osd-root {
  background: $void-card;
  border: 1px dashed rgba($nyxus-accent-secondary, 0.60);
  border-top: 2px solid $nyxus-accent-secondary;
  border-radius: 8px;
  padding: 14px 22px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 12px 40px rgba(0, 0, 0, 0.65),
    0 0 28px rgba($nyxus-accent-secondary, 0.22);
}
.osd-glyph {
  font-size: 24px;
  color: $nyxus-accent-warn;
  text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.55);
}
.osd-label {
  color: $dim;
  letter-spacing: 0.16em;
  font-size: 10px;
  font-weight: 700;
}
.osd-bar trough {
  min-height: 6px;
  border-radius: 6px;
  background: rgba(17, 21, 31, 0.85);
  border: 1px solid rgba($nyxus-accent-primary, 0.18);
}
.osd-bar highlight {
  border-radius: 6px;
  background: linear-gradient(90deg, $nyxus-accent-primary, $nyxus-accent-secondary);
  box-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.55);
}

/* -- SCREENSAVER ----------------------------------------------------- */

.saver-root {
  background: rgba(0, 0, 0, 0.96);
  padding: 100px;
}
.saver-clock {
  font-size: 140px;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 48px rgba($nyxus-accent-primary, 0.65);
  letter-spacing: 0.04em;
}
.saver-date {
  font-size: 18px;
  color: $dim;
  letter-spacing: 0.30em;
}
.saver-brand {
  font-size: 12px;
  color: $nyxus-accent-primary;
  letter-spacing: 0.50em;
  font-weight: 700;
  text-shadow: 0 0 16px rgba($nyxus-accent-primary, 0.45);
}
.saver-hint {
  color: $grey-ghost;
  font-size: 10px;
  letter-spacing: 0.30em;
  padding-top: 24px;
}

/* --- Enterprise additions: new bar pills, player, cores, polish ----- */

/* Mic mute / bluetooth / power-profile / updates / notifications color states */
.mic-mute   { color: $neon-red; border-color: rgba($neon-red, 0.45); }
.bt-off     { color: $grey-ghost; border-color: rgba(255, 255, 255, 0.06); }
.bt-conn    { color: $nyxus-accent-secondary; border-color: rgba($nyxus-accent-secondary, 0.45);
              box-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.30); }
.pp-perf    { color: $nyxus-accent-warn; border-color: rgba($nyxus-accent-warn, 0.55);
              text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.50); }
.pp-save    { color: $neon-green; border-color: rgba($neon-green, 0.45); }
.upd-many   { color: $nyxus-accent-warn; border-color: rgba($nyxus-accent-warn, 0.55); }
.notif-on   { color: $nyxus-accent-primary; border-color: rgba($nyxus-accent-primary, 0.55); }
.notif-dnd  { color: $grey-ghost; border-color: rgba(255, 255, 255, 0.06); }

/* Top-bar player - obsidian capsule riding the telemetry strip */
.ticker-player {
  @include obsidian-vessel($nyxus-accent-primary, 0.65);
  border-radius: 10px;
  padding: 2px 10px;
  margin-left: 4px;
  color: #ffffff;
}
.ticker-player:hover {
  @include obsidian-vessel-hover($nyxus-accent-primary);
}
.ticker-player-text {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  letter-spacing: 0.04em;
  color: $dim;
}

/* Workspace pill: occupied state - clearly distinct from empty (solid
   dim-neon outline + inner glow) but quieter than active */
.ws-pill-occupied {
  border: 1px solid rgba($nyxus-accent-primary, 0.50);
  color: $accent-primary-soft;
  background: rgba($nyxus-accent-primary, 0.10);
  box-shadow:
    inset 0 0 10px rgba($nyxus-accent-primary, 0.18),
    0 0 8px rgba($nyxus-accent-primary, 0.20);
  text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.45);
}
.ws-pill-occupied:hover { color: #ffffff; box-shadow: 0 0 14px rgba($nyxus-accent-primary, 0.40); }

/* Per-core CPU graph - HUD "SYSTEM CORE" card (pink) */
.dash-cores-card {
  padding: 16px 24px;
  border-radius: 8px;
  @include flyout-glass($nyxus-accent-primary, 0.65);
  min-width: 720px;
}
.dash-cores {
  min-height: 64px;
  padding: 6px 4px;
}
.core-bar {
  min-width: 14px;
  background: rgba(17, 21, 31, 0.85);
  border-radius: 4px;
  border: 1px solid rgba($nyxus-accent-primary, 0.10);
  padding: 2px;
}
.core-fill {
  background: linear-gradient(180deg, $nyxus-accent-secondary, $nyxus-accent-primary);
  border-radius: 3px;
  box-shadow: 0 0 6px rgba($nyxus-accent-primary, 0.40);
  min-width: 8px;
}
.core-warm { background: linear-gradient(180deg, $neon-orange-soft, $neon-orange); }
.core-hot  { background: linear-gradient(180deg, $neon-red, $accent-primary-deep);
             box-shadow: 0 0 10px rgba($neon-red, 0.55); }

/* Dashboard media player card - HUD "Music" card (red) */
.dash-player {
  padding: 20px 22px;
  border-radius: 8px;
  background: $void-card;
  border: 1px dashed rgba($neon-red, 0.55);
  border-top: 2px solid $neon-red;
  box-shadow:
    0 0 18px rgba($neon-red, 0.20),
    0 6px 22px rgba(0, 0, 0, 0.55),
    inset 0 0 24px rgba(0, 0, 0, 0.18);
  min-width: 240px;
}
.dash-player-title {
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.35);
}
.dash-player-artist {
  color: $grey-mid;
  font-size: 11px;
  letter-spacing: 0.04em;
}
.dash-player-controls { padding-top: 8px; }
.dash-player-btn {
  background: rgba($nyxus-accent-primary, 0.10);
  border: 1px solid rgba($nyxus-accent-primary, 0.28);
  border-radius: 999px;
  padding: 6px 14px;
  color: #ffffff;
  font-size: 14px;
}
.dash-player-btn:hover {
  background: rgba($nyxus-accent-primary, 0.22);
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow: 0 0 14px rgba($nyxus-accent-primary, 0.50);
}

/* =====================================================================
 * SPRINT 1 . QUICK SETTINGS / WIFI / BT / MIXER / CALENDAR / NOTIF
 * ===================================================================== */

/* -- shared flyout panel base - HOME-HUD card language ----------------- */
/* Mirrors ~/.nyxus/nyxus-home style.py _card_css(): near-black fill,
   1px dashed neon hairline, 2px solid neon top rule, radius 8, tight
   neon bloom. Each panel carries its own hue (set below). */
.qs-root, .wifi-root, .bt-root, .mix-root, .cal-root, .notif-root, .upd-root {
  /* Transparent frosted glass (rev 2026-07-14): a low-alpha tint over the
     Hyprland-blurred cosmic wallpaper. A faint top-to-bottom scrim keeps
     titles/rows legible while the nebula still reads through the frost. */
  background-color: rgba(8, 5, 16, 0.34);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.50), rgba(4, 2, 11, 0.14));
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  border: 1px solid rgba($nyxus-accent-primary, 0.38);
  border-top: 2px solid $nyxus-accent-primary;
  border-radius: $radius-lg;
  padding: 20px 24px;
  transition: box-shadow $t-med, border-color $t-fast;
  box-shadow:
    0 0 18px rgba($nyxus-accent-primary, 0.30),
    0 10px 34px rgba(0, 0, 0, 0.65),
    inset 0 0 24px rgba(0, 0, 0, 0.18);
}
/* Per-panel cosmic-art fills retired (rev 2026-07-14): every flyout now
   shares the transparent frosted background above so the live blurred
   wallpaper is the backdrop, giving one cohesive see-through language.
   Per-panel identity still comes from the neon border/title hue below. */

.qs-title, .wifi-title, .bt-title, .mix-title, .cal-title, .notif-title, .upd-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: $nyxus-accent-warn;
  text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45);
  padding-bottom: 4px;
}

/* per-panel neon hue - HUD assigns each card its own neon.
   wifi=signal green . bt=blue . mixer=purple/ok . calendar=gold .
   notifications=pink . quicksettings=pink . updates=gold */
.wifi-root  { border-color: rgba($nyxus-accent-secondary, 0.60); border-top-color: $nyxus-accent-secondary;
              box-shadow: 0 0 18px rgba($nyxus-accent-secondary, 0.30), 0 10px 34px rgba(0,0,0,0.65), inset 0 0 24px rgba(0,0,0,0.18); }
.bt-root    { border-color: rgba($neon-blue, 0.60); border-top-color: $neon-blue;
              box-shadow: 0 0 18px rgba($neon-blue, 0.30), 0 10px 34px rgba(0,0,0,0.65), inset 0 0 24px rgba(0,0,0,0.18); }
.mix-root   { border-color: rgba($nyxus-accent-ok, 0.60); border-top-color: $nyxus-accent-ok;
              box-shadow: 0 0 18px rgba($nyxus-accent-ok, 0.30), 0 10px 34px rgba(0,0,0,0.65), inset 0 0 24px rgba(0,0,0,0.18); }
.cal-root, .upd-root { border-color: rgba($nyxus-accent-warn, 0.60); border-top-color: $nyxus-accent-warn;
              box-shadow: 0 0 18px rgba($nyxus-accent-warn, 0.30), 0 10px 34px rgba(0,0,0,0.65), inset 0 0 24px rgba(0,0,0,0.18); }

.wifi-title { color: $nyxus-accent-secondary; text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.45); }
.bt-title   { color: $neon-blue;              text-shadow: 0 0 12px rgba($neon-blue, 0.45); }
.mix-title  { color: $nyxus-accent-ok;        text-shadow: 0 0 12px rgba($nyxus-accent-ok, 0.45); }
.notif-title{ color: $nyxus-accent-primary;   text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.45); }
.qs-title   { color: $nyxus-accent-primary;   text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.45); }

/* -- panel view tabs (wifi nearby/saved, mixer inputs) ------------------ */
.panel-tab {
  padding: 6px 12px;
  border-radius: $radius-sm;
  @include flyout-glass($nyxus-accent-secondary, 0.75);
  color: $grey-mid;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  transition: all $t-fast;
}
.panel-tab:hover { @include flyout-glass-hover($nyxus-accent-secondary); color: $text; }
.panel-tab-on {
  @include flyout-glass-hover($nyxus-accent-secondary);
  border-color: $nyxus-accent-secondary;
  color: $nyxus-accent-secondary;
  text-shadow: 0 0 6px rgba($nyxus-accent-secondary, 0.55);
}

/* -- wifi saved view ---------------------------------------------------- */
.wifi-auto {
  padding: 4px 8px; border-radius: $radius-sm;
  background: transparent;
  border: 1px solid rgba($nyxus-accent-secondary, 0.24);
  color: $grey-ghost;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px; font-weight: 700;
  transition: all $t-fast;
}
.wifi-auto:hover { background: rgba($nyxus-accent-secondary, 0.13); color: $text; }
.wifi-auto-on {
  border-color: rgba($nyxus-accent-secondary, 0.60);
  color: $nyxus-accent-secondary;
  text-shadow: 0 0 6px rgba($nyxus-accent-secondary, 0.55);
}
.wifi-act {
  padding: 5px 12px; border-radius: $radius-sm;
  background: rgba($nyxus-accent-secondary, 0.10);
  border: 1px solid rgba($nyxus-accent-secondary, 0.34);
  color: $accent-secondary-soft;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  transition: all $t-fast;
}
.wifi-act:hover { background: rgba($nyxus-accent-secondary, 0.22); color: #ffffff; }
.wifi-details {
  margin-top: 8px;
  padding: 10px 12px;
  border-radius: 8px;
  @include flyout-glass($nyxus-accent-secondary, 0.7);
}
.wifi-detail-line {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  color: $dim;
  letter-spacing: 0.08em;
}

/* -- update center ------------------------------------------------------ */
.upd-title { color: $nyxus-accent-warn; }
.upd-sub {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  color: $grey-mid;
  letter-spacing: 0.16em;
}
.upd-refresh {
  padding: 4px 12px; border-radius: 3px;
  background: rgba($nyxus-accent-warn, 0.10);
  border: 1px solid rgba($nyxus-accent-warn, 0.38);
  color: $nyxus-accent-warn;
  font-weight: 700;
}
.upd-refresh:hover { background: rgba($nyxus-accent-warn, 0.24); color: #ffffff;
                     box-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45); }
.upd-row {
  padding: 6px 10px;
  border-radius: 8px;
  @include flyout-glass($nyxus-accent-warn, 0.75);
}
.upd-row:hover { @include flyout-glass-hover($nyxus-accent-warn); }
.upd-name  { color: $text; font-family: "JetBrainsMono Nerd Font", monospace; font-size: 11px; }
.upd-old   { color: $grey-ghost; font-family: "JetBrainsMono Nerd Font", monospace; font-size: 9px; }
.upd-arrow { color: $nyxus-accent-warn; font-size: 9px; }
.upd-new   { color: $accent-warn-soft; font-family: "JetBrainsMono Nerd Font", monospace; font-size: 9px; }
.upd-sync {
  padding: 8px 14px; border-radius: 3px;
  background: rgba($nyxus-accent-secondary, 0.13);
  border: 1px solid $nyxus-accent-secondary;
  color: $nyxus-accent-secondary;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-weight: 700; letter-spacing: 0.14em; font-size: 10px;
  text-shadow: 0 0 6px rgba($nyxus-accent-secondary, 0.55);
}
.upd-sync:hover { background: rgba($nyxus-accent-secondary, 0.25);
                  box-shadow: 0 0 14px rgba($nyxus-accent-secondary, 0.55); }

/* bluetooth trusted state pill */
.bt-trusted {
  border-color: rgba($neon-blue, 0.60);
  color: $neon-blue-soft;
  text-shadow: 0 0 6px rgba($neon-blue, 0.45);
}

/* calendar keeps shared cosmic bg; only tune grid sizing here */
.cal-root {
  min-width: 320px;
  padding: 20px 22px;
}

.cal-title {
  color: $nyxus-accent-warn;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45);
}

.cal-today {
  color: $nyxus-accent-secondary;
  font-size: 12px;
  letter-spacing: 0.06em;
  padding: 0 4px 8px;
  text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.35);
}

.cal-dow-cell {
  font-size: 10px;
  letter-spacing: 0.16em;
  color: $nyxus-accent-ok;
  min-width: 36px;
  font-weight: 700;
}

.cal-grid { padding: 4px 0; }

.cal-day {
  min-width: 36px;
  padding: 7px 0;
  border-radius: 10px;
  font-size: 12px;
  color: $text;
  font-weight: 600;
  @include flyout-glass($nyxus-accent-warn, 0.45);
}
.cal-day-in:hover {
  @include flyout-glass-hover($nyxus-accent-primary);
}
.cal-day-out { color: $grey-ghost; background-color: transparent; border-color: transparent; box-shadow: none; }
.cal-day-today {
  @include obsidian-vessel($nyxus-accent-primary);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 0 18px rgba($nyxus-accent-primary, 0.55);
}

.cal-close {
  margin-top: 10px;
  padding: 10px 16px;
  border-radius: 10px;
  @include obsidian-vessel($nyxus-accent-warn);
  color: $text;
  font-weight: 700;
  letter-spacing: 0.12em;
}
.cal-close:hover {
  @include obsidian-vessel-hover($nyxus-accent-warn);
  color: #ffffff;
}

/* Bar-specific pill accents */
.qs-pill, .cal-pill {
  @include pill-hue($nyxus-accent-ok);
  color: $accent-ok-soft;
}
.qs-pill:hover, .cal-pill:hover {
  @include obsidian-vessel-hover($nyxus-accent-ok);
  color: #ffffff;
}
.qs-pill:active, .cal-pill:active { @include obsidian-press($nyxus-accent-ok); }

.search-btn {
  padding: 5px 16px;
  border-radius: 999px;
  background: rgba(17, 21, 31, 0.75);
  border: 1px dashed rgba($nyxus-accent-secondary, 0.35);
  color: $grey-mid;
  letter-spacing: 0.12em;
}
.search-btn:hover {
  border-color: rgba($nyxus-accent-secondary, 0.65);
  color: $nyxus-accent-secondary;
  box-shadow: 0 0 14px rgba($nyxus-accent-secondary, 0.30);
}

/* -- QUICK SETTINGS tiles ---------------------------------------------- */
.qs-grid { padding: 2px 0; }

.qs-tile {
  padding: 14px 10px;
  min-width: 78px;
  border-radius: $radius-md;
  @include obsidian-vessel($nyxus-accent-primary);
  transition: all $t-fast;
}
.qs-tile:hover {
  @include obsidian-vessel-hover($nyxus-accent-primary);
}
.qs-tile-on {
  background: linear-gradient(135deg,
    rgba($nyxus-accent-primary, 0.30),
    rgba($nyxus-accent-secondary, 0.18));
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow:
    inset 0 0 14px rgba($nyxus-accent-primary, 0.22),
    0 0 18px rgba($nyxus-accent-primary, 0.28);
}
.qs-tile-glyph { font-size: 18px; color: #ffffff; }
.qs-tile-label {
  font-size: 10px;
  /* letter-spacing removed: it ellipsizes labels in homogeneous grids */
  font-weight: 700;
  color: $dim;
  padding-top: 2px;
}

.qs-sliders {
  padding: 12px 14px;
  border-radius: 10px;
  @include flyout-glass($nyxus-accent-primary, 0.65);
}
.qs-slider-glyph { font-size: 14px; color: $grey-mid; min-width: 22px; }
.qs-scale trough {
  background: rgba(5, 2, 11, 0.82);
  border: 1px solid rgba($nyxus-accent-primary, 0.28);
  border-radius: 999px;
  min-height: 6px;
  box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.45);
}
.qs-scale highlight {
  background: linear-gradient(90deg, $nyxus-accent-primary, $nyxus-accent-secondary);
  border-radius: 999px;
}
.qs-scale slider {
  background: #ffffff;
  border-radius: 999px;
  min-width: 14px; min-height: 14px;
  box-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.55);
}

/* -- DESIGN_CONTRACT S9 - empty states --------------------------------- */
/* Shared style for the "no items yet" placeholder shown inside any
 * list-flyout's scroll area when its data array is empty. Apple/MS-grade
 * panels never show a blank box - there is always copy + (optional) hint.
 */
.empty-state {
  padding: 32px 20px;
  margin: 8px 0;
  border-radius: $radius-md;
  @include flyout-glass($nyxus-accent-primary, 0.55);
  border-style: solid;
  border-color: rgba($nyxus-accent-primary, 0.28);
}
.empty-glyph {
  font-size: 28px;
  color: $nyxus-accent-primary;
  text-shadow: 0 0 14px rgba($nyxus-accent-primary, 0.35);
  padding-bottom: 4px;
}
.empty-title {
  color: $text;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.empty-hint {
  color: $grey-ghost;
  font-size: 11px;
  letter-spacing: 0.02em;
}

.qs-close, .wifi-close, .bt-close, .mix-close, .cal-close, .notif-close, .upd-close {
  padding: 8px 16px;
  border-radius: $radius-md;
  background: rgba($neon-red, 0.12);
  border: 1px solid rgba($neon-red, 0.30);
  color: $neon-red-soft;
  letter-spacing: 0.06em;
  transition: all $t-fast;
}
.qs-close:hover, .wifi-close:hover, .bt-close:hover, .mix-close:hover,
.cal-close:hover, .notif-close:hover {
  background: rgba($neon-red, 0.28);
  color: #ffffff;
  box-shadow: 0 0 14px rgba($neon-red, 0.45);
}

/* -- WIFI ------------------------------------------------------------- */
.wifi-toggle, .wifi-rescan, .bt-toggle, .bt-scan, .notif-dnd, .notif-clear,
.wifi-advanced, .bt-advanced, .mix-advanced {
  padding: 6px 12px;
  border-radius: 8px;
  @include obsidian-vessel($nyxus-accent-secondary, 0.85);
  color: $accent-secondary-soft;
  /* NO letter-spacing: tracking ellipsizes these compact buttons */
}
.wifi-toggle:hover, .wifi-rescan:hover, .bt-toggle:hover, .bt-scan:hover,
.notif-dnd:hover, .notif-clear:hover, .wifi-advanced:hover, .bt-advanced:hover,
.mix-advanced:hover {
  @include obsidian-vessel-hover($nyxus-accent-secondary);
  color: #ffffff;
}

.wifi-current { color: $grey-mid; font-size: 11px; padding: 2px 4px; }

.wifi-row, .bt-row, .mix-row, .notif-row {
  padding: 10px 14px;
  border-radius: $radius-md;
  @include flyout-glass($nyxus-accent-secondary, 0.7);
  transition: all $t-fast;
}
.wifi-row:hover, .bt-row:hover, .mix-row:hover, .notif-row:hover {
  @include flyout-glass-hover($nyxus-accent-secondary);
}
.wifi-row-active, .bt-row-conn, .mix-row-default {
  @include flyout-glass-hover($nyxus-accent-secondary);
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow:
    0 0 16px rgba($nyxus-accent-secondary, 0.22),
    inset 0 0 12px rgba($nyxus-accent-primary, 0.10);
}

.wifi-bars { color: $nyxus-accent-secondary; font-family: "JetBrainsMono Nerd Font", monospace; min-width: 44px; }
.wifi-name { background: transparent; border: none; color: $text; font-size: 12px; }
.wifi-name:hover { color: #ffffff; text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.55); }
.wifi-sig { color: $grey-mid; font-size: 10px; min-width: 36px; }
.wifi-forget {
  padding: 2px 8px; border-radius: 6px;
  background: rgba($neon-red, 0.10);
  border: 1px solid rgba($neon-red, 0.25);
  color: $neon-red-soft;
}
.wifi-forget:hover { background: rgba($neon-red, 0.30); color: #ffffff; }

/* -- BLUETOOTH -------------------------------------------------------- */
.bt-icon { font-size: 16px; color: $nyxus-accent-secondary; min-width: 24px; }
.bt-name { color: #ffffff; font-size: 12px; font-weight: 600; }
.bt-mac  { color: $grey-ghost; font-size: 10px; letter-spacing: 0.04em; }
.bt-act, .bt-forget {
  padding: 5px 12px; border-radius: $radius-sm;
  background: rgba($nyxus-accent-primary, 0.10);
  border: 1px solid rgba($nyxus-accent-primary, 0.25);
  color: $accent-ok-soft;
  font-size: 10px;
  transition: all $t-fast;
  /* NO letter-spacing (ellipsizes) */
}
.bt-act:hover { background: rgba($nyxus-accent-secondary, 0.22); color: #ffffff; }
.bt-forget {
  background: rgba($neon-red, 0.10);
  border-color: rgba($neon-red, 0.25);
  color: $neon-red-soft;
}
.bt-forget:hover { background: rgba($neon-red, 0.30); color: #ffffff; }

/* -- AUDIO MIXER ------------------------------------------------------ */
.mix-section {
  font-size: 10px; letter-spacing: 0.20em;
  color: $grey-ghost;
  padding: 8px 4px 2px;
}
.mix-pick {
  padding: 0 8px;
  background: transparent;
  border: none;
  color: $nyxus-accent-secondary;
  font-size: 14px;
  min-width: 22px;
}
.mix-pick:hover { color: #ffffff; text-shadow: 0 0 10px rgba($nyxus-accent-secondary, 0.65); }
.mix-name { color: $text; font-size: 12px; }
.mix-pct { color: $grey-mid; font-size: 10px; min-width: 38px; }
.mix-mute {
  padding: 2px 8px; border-radius: 6px;
  background: rgba(17, 21, 31, 0.85);
  border: 1px solid rgba($nyxus-accent-primary, 0.20);
  color: $accent-ok-soft;
}
.mix-mute:hover { background: rgba($nyxus-accent-primary, 0.22); color: #ffffff; }
.mix-app-glyph { color: $nyxus-accent-primary; font-size: 14px; min-width: 22px; }
.mix-scale trough {
  background: rgba(5, 2, 11, 0.82);
  border: 1px solid rgba($nyxus-accent-ok, 0.28);
  border-radius: 999px;
  min-height: 5px;
  box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.45);
}
.mix-scale highlight {
  background: linear-gradient(90deg, $nyxus-accent-primary, $nyxus-accent-secondary);
  border-radius: 999px;
}
.mix-scale slider {
  background: #ffffff;
  border-radius: 999px;
  min-width: 12px; min-height: 12px;
}

/* -- NOTIFICATIONS ---------------------------------------------------- */
.notif-app {
  font-size: 10px;
  letter-spacing: 0.18em;
  color: $nyxus-accent-primary;
  min-width: 64px;
  padding: 4px 8px;
  border-radius: 6px;
  @include flyout-glass($nyxus-accent-primary, 0.6);
}
.notif-summary { color: #ffffff; font-size: 12px; font-weight: 600; }
.notif-body    { color: $grey-mid; font-size: 10px; }
.notif-dismiss {
  padding: 2px 8px; border-radius: 6px;
  background: rgba($neon-red, 0.08);
  border: 1px solid rgba($neon-red, 0.20);
  color: $neon-red-soft;
}
.notif-dismiss:hover { background: rgba($neon-red, 0.28); color: #ffffff; }

/* ----------------------------------------------------------------------
 * NYXUS . Dock styles
 * ---------------------------------------------------------------------- */

.dock-frame {
  background: linear-gradient(180deg,
    rgba(14, 16, 28, 0.94),
    rgba(5, 6, 10, 0.90));
  border: 1px solid rgba($nyxus-accent-primary, 0.38);
  border-radius: 22px;
  padding: 8px 14px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.10),
    0 0 28px rgba($nyxus-accent-primary, 0.22),
    0 12px 40px rgba(0, 0, 0, 0.65),
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    inset 0 0 24px rgba($nyxus-accent-ok, 0.08);
  margin: 0 0 6px 0;
}

.dock-row { padding: 0 4px; }

.dock-eventbox {
  background: transparent;
  border-radius: 14px;
  padding: 2px;
  transition: background-color 140ms ease;
}
.dock-eventbox:hover {
  background: rgba($nyxus-accent-primary, 0.14);
  box-shadow: 0 0 18px rgba($nyxus-accent-primary, 0.30);
}
.dock-eventbox.urgent {
  background: rgba($neon-red, 0.18);
}
.dock-eventbox.focused {
  background: rgba($nyxus-accent-secondary, 0.14);
  box-shadow: 0 0 16px rgba($nyxus-accent-secondary, 0.35);
}

.dock-tile {
  border-radius: 14px;
  padding: 2px;
}

.dock-icon-box {
  min-width: 44px;
  min-height: 44px;
  border-radius: 14px;
  background: linear-gradient(160deg,
    rgba(22, 26, 38, 0.85),
    rgba(10, 12, 20, 0.75));
  border: 1px solid rgba($nyxus-accent-ok, 0.22);
  box-shadow: inset 0 0 12px rgba($nyxus-accent-primary, 0.06);
}

.dock-icon-box image {
  -gtk-icon-effect: none;
}
.dock-eventbox:hover .dock-icon-box {
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow:
    0 0 16px rgba($nyxus-accent-primary, 0.35),
    inset 0 0 14px rgba($nyxus-accent-secondary, 0.12);
}
.dock-eventbox:hover .dock-icon-box image {
  -gtk-icon-effect: highlight;
}

.dock-live-overlay {
  color: $nyxus-accent-warn;
  font-weight: 700;
  font-size: 10px;
  text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.65);
  margin-top: -2px;
}

.dock-badge {
  background: linear-gradient(135deg, $nyxus-accent-primary, $neon-red);
  color: #ffffff;
  font-weight: 700;
  font-size: 8px;
  min-width: 12px;
  min-height: 12px;
  /* max-width: 22px; unsupported by GTK CSS */
  /* max-height: 22px; unsupported by GTK CSS */
  padding: 0 3px;
  border-radius: 999px;
  border: 1.5px solid rgba(5, 6, 10, 0.95);
  margin: -2px -2px 0 0;
  box-shadow: 0 2px 8px rgba($nyxus-accent-primary, 0.55);
}
.dock-badge.stack {
  background: linear-gradient(135deg, $nyxus-accent-primary 0%, $nyxus-accent-ok 100%);
  box-shadow: 0 2px 6px rgba($nyxus-accent-primary, 0.40);
}
.dock-badge.trash {
  background: linear-gradient(135deg, $neon-orange-soft 0%, $neon-orange 100%);
  box-shadow: 0 2px 6px rgba($neon-orange, 0.40);
}

/* Running indicator dot */
.dock-indicator {
  min-width: 5px;
  min-height: 5px;
  border-radius: 3px;
  background: rgba($nyxus-accent-primary, 0.72);
  margin-top: 2px;
  transition: background 140ms ease, min-width 140ms ease;
}
.dock-indicator.focused {
  background: $nyxus-accent-secondary;
  min-width: 14px;
  box-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.72);
}
.dock-indicator.other-ws {
  background: rgba($nyxus-accent-primary, 0.32);
}

/* Section divider */
.dock-divider {
  min-width: 1px;
  min-height: 36px;
  background: linear-gradient(to bottom,
              rgba($nyxus-accent-primary, 0) 0%,
              rgba($nyxus-accent-primary, 0.32) 50%,
              rgba($nyxus-accent-primary, 0) 100%);
  margin: 0 6px;
}

/* "Other workspace" subtle dim */
.dock-eventbox.other-ws .dock-icon-box image {
  opacity: 0.62;
}

/* Auto-hide reveal strip */
.dock-reveal-strip {
  background: transparent;
}

/* dock bounce - disabled on eww 0.5 (no @keyframes support) */
.dock-icon-bounce {
  /* animation: dock-bounce 600ms ease; */
}

/* ---------------------------------------------------------------------
 * NYXUS Hotkeys cheat-sheet + recorder
 * --------------------------------------------------------------------- */
.hk-root {
  background: $void-deep;
  border: 1px solid rgba($nyxus-accent-secondary, 0.42);
  border-radius: 12px;
  padding: 18px 20px;
  color: $text;
  font-family: "Inter", "JetBrains Mono", sans-serif;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 24px 80px rgba(0, 0, 0, 0.65),
    inset 0 0 48px rgba($nyxus-accent-ok, 0.06);
}
.hk-header { margin-bottom: 6px; }
.hk-title  { font-size: 18px; font-weight: 700; letter-spacing: 0.04em;
             font-family: "Inter Display", "Inter", sans-serif;
             color: $nyxus-accent-warn;
             text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.45); }
.hk-conflict-pip {
  font-size: 11px; color: $neon-red; padding: 2px 10px;
  border: 1px solid rgba($neon-red, 0.35); border-radius: 999px;
  background: rgba(40, 12, 22, 0.55);
}
.hk-search {
  background: rgba(10, 13, 20, 0.85);
  color: $text; padding: 8px 12px; border-radius: 8px;
  border: 1px solid rgba($nyxus-accent-ok, 0.35);
  font-size: 13px;
}
.hk-scroll { padding-top: 4px; }
.hk-cat-h  { color: $nyxus-accent-ok; font-weight: 700; font-size: 12px;
             letter-spacing: 1.5px; /* text-transform unsupported by GTK CSS */
             margin: 12px 0 4px 4px; }
.hk-line   { color: $dim; font-family: "JetBrains Mono", monospace;
             font-size: 12px; padding: 2px 4px; }
.hk-line:hover { background: rgba($nyxus-accent-secondary, 0.12); border-radius: 4px; }
.hk-row    { padding: 4px 6px; border-radius: 6px; }
.hk-combo  { color: $nyxus-accent-secondary; font-family: "JetBrains Mono", monospace;
             font-weight: 600; min-width: 180px; }
.hk-desc   { color: $text; }
.hk-cat    { color: $grey-mid; font-size: 11px; }
.hk-footer { margin-top: 10px; padding-top: 10px;
             border-top: 1px solid rgba($nyxus-accent-ok, 0.22); }
.hk-btn    { background: rgba(17, 21, 31, 0.72); color: $text;
             padding: 6px 14px; border-radius: 8px;
             border: 1px solid rgba($nyxus-accent-ok, 0.35);
             font-size: 12px; }
.hk-btn:hover {
  background: linear-gradient(135deg, rgba($nyxus-accent-secondary, 0.18), rgba($nyxus-accent-primary, 0.14));
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow: 0 0 16px rgba($nyxus-accent-secondary, 0.30);
}
.hk-btn-close { color: $neon-red; }

.hk-recorder { padding: 24px; background: $void-deep;
               border: 1px solid rgba($nyxus-accent-secondary, 0.42); border-radius: 12px; }
.hk-rec-title { font-size: 14px; color: $nyxus-accent-warn;
                /* text-transform unsupported by GTK CSS */ letter-spacing: 1.5px; }
.hk-rec-text  { font-size: 22px; color: $nyxus-accent-secondary;
                font-family: "JetBrains Mono", monospace;
                margin: 16px 0; }

/* -- NYXUS Snap (picker + toast) --------------------------------------- */
.snap-picker-root  { background-color: rgba(0,0,0,0.55); }
.snap-picker-card  { background-color: $void-deep;
                     border: 1px solid rgba($nyxus-accent-secondary, 0.42);
                     border-radius: 12px; padding: 22px 26px;
                     box-shadow:
                       0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
                       0 24px 64px rgba(0,0,0,0.75),
                       inset 0 0 40px rgba($nyxus-accent-ok, 0.06); }
.snap-picker-title { color: $nyxus-accent-warn; font-size: 14px;
                     font-weight: 700; margin-bottom: 6px;
                     letter-spacing: 0.28em; /* text-transform unsupported by GTK CSS */
                     text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45); }
.snap-zone-cell    { background: rgba(10, 13, 20, 0.85);
                     border: 1px solid rgba($nyxus-accent-ok, 0.35);
                     color: $text; font-weight: 600;
                     border-radius: 10px; min-width: 96px;
                     min-height: 64px; padding: 8px 12px;
                     transition: all 120ms ease; }
.snap-zone-cell:hover { background: linear-gradient(135deg,
                         rgba($nyxus-accent-secondary, 0.18), rgba($nyxus-accent-primary, 0.14));
                         border-color: rgba($nyxus-accent-secondary, 0.55);
                         color: #ffffff;
                         box-shadow: 0 0 20px rgba($nyxus-accent-secondary, 0.30); }
.snap-toast        { background: rgba(5, 6, 10, 0.94);
                     color: $text; padding: 10px 18px;
                     border-radius: 999px;
                     border: 1px solid rgba($nyxus-accent-secondary, 0.35);
                     font-size: 12px; letter-spacing: 0.06em;
                     box-shadow: 0 0 18px rgba($nyxus-accent-primary, 0.22); }

/* -- NYXUS Mission Control --------------------------------------------- */
/* mission uses the shared .overlay-backdrop tint (see DASHBOARD section)
   so the whole screen frosts behind Mission Control too. */
.mission-root      { background-color: transparent; }
.mission-card      { background-color: rgba(6, 2, 15, 0.42);
                     background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.54), rgba(4, 2, 11, 0.22));
                     background-size: cover;
                     background-position: center;
                     padding: 22px 26px; border-radius: 12px;
                     border: 1px solid rgba($nyxus-accent-secondary, 0.42);
                     border-top: 2px solid $nyxus-accent-secondary;
                     box-shadow:
                       0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
                       0 24px 64px rgba(0,0,0,0.78),
                       inset 0 0 48px rgba($nyxus-accent-ok, 0.06); }
.mission-title     { color: $nyxus-accent-warn; font-size: 18px; font-weight: 700;
                     letter-spacing: 0.22em;
                     text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.45); }
.mission-grid      { padding: 8px 0; }
.mission-ws-card   { background: rgba(6, 4, 12, 0.78);
                     border: 1px solid rgba($nyxus-accent-ok, 0.35);
                     border-top: 2px solid rgba($nyxus-accent-ok, 0.62);
                     border-radius: 14px; padding: 12px;
                     min-width: 296px;
                     transition: all 140ms ease; }
.mission-ws-card:hover { background: linear-gradient(135deg,
                          rgba($nyxus-accent-secondary, 0.14), rgba($nyxus-accent-primary, 0.10));
                          border-color: rgba($nyxus-accent-secondary, 0.50);
                          box-shadow: 0 0 20px rgba($nyxus-accent-secondary, 0.25); }
.mission-ws-active { border-color: rgba($nyxus-accent-secondary, 0.65);
                     background: linear-gradient(145deg,
                       rgba($nyxus-accent-primary, 0.20), rgba($nyxus-accent-secondary, 0.14));
                     box-shadow: 0 0 24px rgba($nyxus-accent-primary, 0.30); }
.mission-ws-title  { color: $nyxus-accent-secondary; font-size: 11px;
                     letter-spacing: 0.10em; /* text-transform unsupported by GTK CSS */ }
.mission-ws-thumb  { border-radius: 8px;
                     border: 1px solid rgba($nyxus-accent-ok, 0.28); }
.mission-window-chip { background: rgba(17, 21, 31, 0.72);
                        border: 1px solid rgba($nyxus-accent-ok, 0.28);
                        color: $text; font-size: 11px;
                        border-radius: 6px; padding: 3px 8px; }
.mission-window-chip:hover { background: rgba($nyxus-accent-ok, 0.22); border-color: rgba($nyxus-accent-secondary, 0.45); }

/* =====================================================================
 * PRISM . shared flyouts (brightness + daemon quick settings panel)
 * Replaces the old generic blue block that was overriding prism colors.
 * ===================================================================== */

.flyout, .brightness-flyout {
  background-color: rgba(8, 5, 16, 0.34);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.50), rgba(4, 2, 11, 0.14));
  background-size: cover;
  background-position: center;
  border: 1px solid rgba($nyxus-accent-warn, 0.42);
  border-top: 2px solid $nyxus-accent-warn;
  border-radius: $radius-lg;
  padding: 20px 24px;
  min-width: 340px;
  box-shadow:
    0 0 18px rgba($nyxus-accent-warn, 0.30),
    0 10px 34px rgba(0, 0, 0, 0.65),
    inset 0 0 24px rgba(0, 0, 0, 0.18);
}

.flyout-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.32em;
  color: $nyxus-accent-warn;
  text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45);
  padding-bottom: 6px;
}

.flyout-glyph {
  font-size: 22px;
  color: $nyxus-accent-warn;
  text-shadow: 0 0 16px rgba($nyxus-accent-warn, 0.55);
  min-width: 28px;
}

.flyout-sub {
  color: $grey-mid;
  font-size: 11px;
  letter-spacing: 0.08em;
}

.flyout-close {
  margin-top: 8px;
  padding: 10px 16px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba($nyxus-accent-primary, 0.18), rgba($nyxus-accent-secondary, 0.10));
  border: 1px solid rgba($nyxus-accent-primary, 0.35);
  color: $text;
  letter-spacing: 0.14em;
  font-weight: 700;
  transition: all 160ms ease;
}
.flyout-close:hover {
  background: linear-gradient(135deg, rgba($nyxus-accent-primary, 0.38), rgba($nyxus-accent-secondary, 0.22));
  border-color: rgba($nyxus-accent-secondary, 0.65);
  box-shadow: 0 0 22px rgba($nyxus-accent-primary, 0.45);
  color: #ffffff;
}

/* GTK scale - global prism sliders (dashboard, flyouts, mixer, QS) */
scale {
  min-height: 18px;
  padding: 4px 0;
}

scale trough {
  min-height: 8px;
  border-radius: 999px;
  background: rgba(8, 10, 18, 0.95);
  border: 1px solid rgba($nyxus-accent-ok, 0.28);
  box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.55);
}

scale highlight {
  min-height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, $nyxus-accent-primary 0%, $nyxus-accent-secondary 55%, $nyxus-accent-ok 100%);
  box-shadow:
    0 0 14px rgba($nyxus-accent-primary, 0.55),
    0 0 10px rgba($nyxus-accent-secondary, 0.35);
}

scale slider {
  min-width: 16px;
  min-height: 16px;
  border-radius: 999px;
  background: radial-gradient(circle at 35% 35%, #ffffff, $nyxus-accent-warn 45%, $nyxus-accent-primary 100%);
  border: 2px solid rgba(255, 255, 255, 0.85);
  box-shadow:
    0 0 12px rgba($nyxus-accent-primary, 0.65),
    0 0 8px rgba($nyxus-accent-secondary, 0.45);
  margin: -6px;
}

.dash-scale trough, .flyout-scale trough, .mix-scale trough, .qs-scale trough {
  min-height: 10px;
}

/* Daemon quick-settings card (quicksettings.yuck) */
.qs-card-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.32em;
  color: $nyxus-accent-warn;
  text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.45);
  padding: 2px 4px 6px 4px;
}

.qs-card {
  background-color: rgba(8, 5, 16, 0.34);
  background-image: linear-gradient(180deg, rgba(3, 1, 9, 0.50), rgba(4, 2, 11, 0.14));
  background-size: cover;
  background-position: center;
  border: 1px solid rgba($nyxus-accent-primary, 0.42);
  border-top: 2px solid $nyxus-accent-primary;
  border-radius: $radius-lg;
  padding: 18px 20px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.08),
    0 0 28px rgba($nyxus-accent-secondary, 0.14),
    0 24px 64px rgba(0, 0, 0, 0.75),
    inset 0 0 32px rgba($nyxus-accent-ok, 0.07);
}

.qs-card .qs-grid { padding: 4px 0 10px 0; }

.qs-card .qs-tile {
  background: rgba(10, 13, 20, 0.85);
  border: 1px solid rgba($nyxus-accent-ok, 0.35);
  border-radius: 14px;
  min-width: 68px;
  min-height: 68px;
  padding: 10px 8px;
  transition: all 160ms ease;
}
.qs-card .qs-tile:hover {
  background: linear-gradient(135deg, rgba($nyxus-accent-secondary, 0.16), rgba($nyxus-accent-primary, 0.12));
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow: 0 0 18px rgba($nyxus-accent-secondary, 0.28);
}
.qs-card .qs-tile-on {
  background: linear-gradient(145deg, rgba($nyxus-accent-primary, 0.32), rgba($nyxus-accent-secondary, 0.18));
  border-color: rgba($nyxus-accent-secondary, 0.62);
  box-shadow:
    inset 0 0 16px rgba($nyxus-accent-primary, 0.22),
    0 0 20px rgba($nyxus-accent-secondary, 0.28);
  color: #ffffff;
}
.qs-card .qs-tile-off {
  color: $grey-mid;
}
.qs-card .qs-tile-off .qs-icon {
  color: $nyxus-accent-ok;
  text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.45);
  opacity: 0.85;
}
.qs-card .qs-tile-on .qs-icon {
  color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.55);
}
.qs-card .qs-icon  { font-size: 20px; }
.qs-card .qs-label { font-size: 10px; font-weight: 700; color: $dim; }
.qs-card .qs-value { font-size: 11px; color: $nyxus-accent-secondary; font-weight: 700; /* margin auto unsupported by GTK CSS */ }
.qs-card .qs-slider { padding: 6px 4px 0 4px; }
.qs-card .qs-battery {
  padding-top: 8px;
  border-top: 1px solid rgba($nyxus-accent-ok, 0.28);
}

/* Dashboard eye-candy boost.
 * Bloom is kept TIGHT (18px, alpha .32) - wide low-alpha halos read as a
 * ghost figure around the card and fight the layer blur ignore_alpha
 * cutoff. Crisp rim + short bloom = deliberate neon, no phantom. */
.dashboard-root {
  background:
    radial-gradient(ellipse 80% 60% at 50% 0%, rgba($nyxus-accent-primary, 0.10), transparent 70%),
    radial-gradient(ellipse 70% 50% at 80% 100%, rgba($nyxus-accent-secondary, 0.07), transparent 65%),
    $void-deep;
  border: 1px solid rgba($nyxus-accent-primary, 0.42);
  border-radius: 12px;
  box-shadow:
    0 0 0 1px rgba($nyxus-accent-secondary, 0.10),
    0 0 18px rgba($nyxus-accent-primary, 0.32),
    0 24px 64px rgba(0, 0, 0, 0.80),
    inset 0 0 100px rgba($nyxus-accent-ok, 0.06);
}

.dash-clock {
  color: #ffffff;
  text-shadow:
    0 0 40px rgba($nyxus-accent-primary, 0.65),
    0 0 24px rgba($nyxus-accent-secondary, 0.35);
}

/* (.dash-card visual now lives in the HOME-HUD card block above -
   no blanket override here, per-hue borders must win. rev 2026-07-09) */

.dash-toggle {
  background: $void-card;
  border: 1px dashed rgba($nyxus-accent-ok, 0.40);
  /* Wide enough for the longest label ("Bluetooth") in the homogeneous
     space-evenly row - 88px forced every tile narrow and ellipsized. */
  min-width: 132px;
  min-height: 72px;
  padding: 12px 8px;
}
.dash-toggle:hover {
  background: linear-gradient(145deg, rgba($nyxus-accent-primary, 0.24), rgba($nyxus-accent-secondary, 0.14));
  border-color: rgba($nyxus-accent-secondary, 0.55);
  box-shadow: 0 0 24px rgba($nyxus-accent-primary, 0.35);
}
.dash-toggle-glyph {
  font-size: 24px;
  color: $nyxus-accent-secondary;
  text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.55);
}

.dash-player-btn {
  min-width: 40px;
  min-height: 40px;
  border-radius: 12px;
  @include obsidian-vessel($nyxus-accent-primary, 0.6);
  color: $text;
  font-size: 16px;
  transition: all 180ms ease;
}
.dash-player-btn:hover { @include obsidian-vessel-hover($nyxus-accent-primary); color: #ffffff; }
.dash-player-btn:active { @include obsidian-press($nyxus-accent-primary); }

/* Flyout panels - HOME-HUD per-hue card borders are defined in the
   shared flyout base above; no blanket override here (rev 2026-07-09). */

.wifi-toggle, .wifi-rescan, .bt-toggle, .bt-scan {
  background: linear-gradient(135deg, rgba($nyxus-accent-secondary, 0.12), rgba($nyxus-accent-ok, 0.10));
  border: 1px solid rgba($nyxus-accent-secondary, 0.42);
  color: $nyxus-accent-secondary;
  font-weight: 700;
}
.wifi-toggle:hover, .wifi-rescan:hover, .bt-toggle:hover, .bt-scan:hover {
  background: linear-gradient(135deg, rgba($nyxus-accent-secondary, 0.28), rgba($nyxus-accent-primary, 0.16));
  box-shadow: 0 0 18px rgba($nyxus-accent-secondary, 0.45);
  color: #ffffff;
}

.wifi-advanced, .bt-advanced, .mix-advanced {
  background: rgba($nyxus-accent-ok, 0.12);
  border: 1px solid rgba($nyxus-accent-ok, 0.38);
  color: $accent-ok-soft;
}
.wifi-advanced:hover, .bt-advanced:hover, .mix-advanced:hover {
  background: rgba($nyxus-accent-ok, 0.28);
  box-shadow: 0 0 16px rgba($nyxus-accent-ok, 0.45);
  color: #ffffff;
}

.wifi-close, .bt-close, .mix-close, .cal-close, .notif-close, .qs-close, .upd-close {
  background: linear-gradient(135deg, rgba($nyxus-accent-primary, 0.16), rgba($nyxus-accent-secondary, 0.08));
  border: 1px solid rgba($nyxus-accent-primary, 0.35);
  color: $accent-primary-soft;
  font-weight: 700;
}
.wifi-close:hover, .bt-close:hover, .mix-close:hover, .cal-close:hover,
.notif-close:hover, .qs-close:hover, .upd-close:hover {
  background: linear-gradient(135deg, rgba($nyxus-accent-primary, 0.35), rgba($nyxus-accent-secondary, 0.20));
  border-color: rgba($nyxus-accent-secondary, 0.55);
  color: #ffffff;
  box-shadow: 0 0 18px rgba($nyxus-accent-primary, 0.40);
}

/* =====================================================================
   HOME-HUD TYPE SYSTEM - rev 2026-07-09
   Mirrors ~/.nyxus/nyxus-home/style.py exactly:
     - "Inter Display" 700       -> card/panel header titles
     - "JetBrains Mono" 700      -> big numerals (dot-matrix voice),
                                    micro-labels, stamps, data readouts
     - "Caveat"                  -> graffiti-script dates/greetings
     - "Permanent Marker"        -> brand wordmarks only
   NOTE: hand fonts hate wide tracking - letter-spacing stays low
   wherever a marker/script face lands.
   =================================================================== */

/* -- brand voice: marker wordmarks only ------------------------------- */
.brand,
.ticker-label,
.saver-brand {
  font-family: "Permanent Marker", "Inter", sans-serif;
  font-weight: 400;            /* the marker face has one weight */
}

/* -- HUD header voice: Inter Display titles (style.py header-title) --- */
.power-title,
.cheat-title,
.dc-title,
.dash-card-title,
.cheat-section,
.dc-section,
.qs-title, .wifi-title, .bt-title, .mix-title, .cal-title, .notif-title,
.upd-title,
.qs-card-title,
.dash-toggle-label,
.power-label,
.flyout-title,
.empty-title {
  font-family: "Inter Display", "Inter", sans-serif;
  font-weight: 700;
  letter-spacing: 0.02em;      /* HUD titles track tight, not wide */
}
.power-title  { font-size: 20px; letter-spacing: 0.06em; }
.cheat-title  { font-size: 20px; letter-spacing: 0.06em; }
.dc-title     { font-size: 24px; letter-spacing: 0.06em; }
.dash-card-title { font-size: 14px; }
.cheat-section, .dc-section { letter-spacing: 0.08em; font-size: 12px; }
.qs-title, .wifi-title, .bt-title, .mix-title, .cal-title, .notif-title, .upd-title {
  font-size: 17px; letter-spacing: 0.03em;
}
.brand        { font-size: 13px; }
.ticker-label { font-size: 12px; }
.saver-brand  { font-size: 16px; letter-spacing: 0.20em; }
.dash-toggle-label { font-size: 12px; }
.power-label  { font-size: 13px; }
.empty-title  { font-size: 15px; }

/* -- handwritten voice: Caveat --------------------------------------- */
.dash-date,
.saver-date,
.saver-hint,
.dc-sub,
.cal-today,
.wifi-current,
.empty-hint,
.clock-date {
  font-family: "Caveat", "Inter", sans-serif;
}
.dash-date    { font-size: 26px; letter-spacing: 0.06em; color: $dim; }
.saver-date   { font-size: 30px; letter-spacing: 0.08em; }
.saver-hint   { font-size: 18px; letter-spacing: 0.10em; }
.dc-sub       { font-size: 16px; letter-spacing: 0.06em; }
.cal-today    { font-size: 18px; }
.wifi-current { font-size: 16px; }
.empty-hint   { font-size: 16px; }
.clock-date   { font-size: 14px; }

/* -- dot-matrix voice: JetBrains Mono heavy on hero numerals ---------- */
/* HUD clock-time = "JetBrains Mono" 700 + white bloom (style.py). The
   chunky mono digits ARE the dot-matrix look from the reference.       */
.dash-clock {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 800;
  font-size: 80px;
  letter-spacing: 0.05em;
}
.saver-clock {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 800;
  font-size: 120px;
  letter-spacing: 0.05em;
}
.clock-hms {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 700;
  font-size: 12px;
}
.dash-card-big {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-weight: 700;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.35);
}

/* =====================================================================
   HOME-HUD BAR MODULES - rev 2026-07-09
   Mini neon tile cards for the bars (top strip + syspulse cluster),
   per-app rail hover hues, and dramatic workspace pill states.
   All hues via the shared tokens at the top of this file.
   =================================================================== */

/* -- mini HUD tile: glyph + small-caps neon label + mono value -------- */
.hud-tile {
  padding: 2px 9px;
  border-radius: 6px;
  @include obsidian-vessel($nyxus-accent-primary, 0.55);
  transition: all 180ms ease;
}
.hud-tile:hover { @include obsidian-vessel-hover($nyxus-accent-primary); }
.hud-tile-glyph {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 11px;
}
.hud-tile-label {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  /* NO letter-spacing: tracking ellipsizes these tiny labels */
}
.hud-tile-value {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 700;
  color: $text;
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.30);
}

/* per-domain hue variants - border-rule, glyph and label take the neon;
   each keeps the premium obsidian shadow with its own colored halo. */
@mixin tile-hue($hue) {
  border-color: rgba($hue, 0.55);
  box-shadow:
    0 0 13px rgba($hue, 0.20),
    0 5px 16px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.05),
    inset 0 0 11px rgba(0, 0, 0, 0.45);
}
.hud-tile-pink   { @include tile-hue($nyxus-accent-primary); }
.hud-tile-pink   .hud-tile-glyph, .hud-tile-pink .hud-tile-label {
                   color: $nyxus-accent-primary; text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.55); }
.hud-tile-green  { @include tile-hue($nyxus-accent-secondary); }
.hud-tile-green  .hud-tile-glyph, .hud-tile-green .hud-tile-label {
                   color: $nyxus-accent-secondary; text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.55); }
.hud-tile-purple { @include tile-hue($nyxus-accent-ok); }
.hud-tile-purple .hud-tile-glyph, .hud-tile-purple .hud-tile-label {
                   color: $nyxus-accent-ok; text-shadow: 0 0 8px rgba($nyxus-accent-ok, 0.55); }
.hud-tile-gold   { @include tile-hue($nyxus-accent-warn); }
.hud-tile-gold   .hud-tile-glyph, .hud-tile-gold .hud-tile-label {
                   color: $nyxus-accent-warn; text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.55); }
.hud-tile-orange { @include tile-hue($neon-orange); }
.hud-tile-orange .hud-tile-glyph, .hud-tile-orange .hud-tile-label {
                   color: $neon-orange; text-shadow: 0 0 8px rgba($neon-orange, 0.55); }
.hud-tile-blue   { @include tile-hue($neon-blue); }
.hud-tile-blue   .hud-tile-glyph, .hud-tile-blue .hud-tile-label {
                   color: $neon-blue; text-shadow: 0 0 8px rgba($neon-blue, 0.55); }
.hud-tile-red    { @include tile-hue($neon-red); }
.hud-tile-red    .hud-tile-glyph, .hud-tile-red .hud-tile-label {
                   color: $neon-red; text-shadow: 0 0 8px rgba($neon-red, 0.55); }

.hud-tile-strip { padding: 0 6px; }

/* live charge-bar under each reactor tile (Home System-Pulse DNA) */
.hud-tile-bar {
  min-height: 2px;
  border-radius: 1px;
  margin-top: 1px;
  background-color: rgba(255, 255, 255, 0.06);
  background-repeat: no-repeat;
  background-position: left center;
}
.hud-tile-bar-hidden { min-height: 0; margin: 0; opacity: 0; }
.hud-tile-bar-pink   { background-image: linear-gradient(90deg, $nyxus-accent-primary, $nyxus-accent-primary); box-shadow: 0 0 5px rgba($nyxus-accent-primary, 0.45); }
.hud-tile-bar-purple { background-image: linear-gradient(90deg, $nyxus-accent-ok, $nyxus-accent-ok); box-shadow: 0 0 5px rgba($nyxus-accent-ok, 0.45); }
.hud-tile-bar-blue   { background-image: linear-gradient(90deg, $neon-blue, $neon-blue); box-shadow: 0 0 5px rgba($neon-blue, 0.45); }
.hud-tile-bar-orange { background-image: linear-gradient(90deg, $neon-orange, $neon-orange); box-shadow: 0 0 5px rgba($neon-orange, 0.45); }
.hud-tile-bar-green  { background-image: linear-gradient(90deg, $nyxus-accent-secondary, $nyxus-accent-secondary); box-shadow: 0 0 5px rgba($nyxus-accent-secondary, 0.45); }
.hud-tile-bar-gold   { background-image: linear-gradient(90deg, $nyxus-accent-warn, $nyxus-accent-warn); box-shadow: 0 0 5px rgba($nyxus-accent-warn, 0.45); }
.hud-tile-bar-red    { background-image: linear-gradient(90deg, $neon-red, $neon-red); box-shadow: 0 0 5px rgba($neon-red, 0.45); }

/* -- app rail: per-app neon hover identities -------------------------- */
.app-pill-pink   { @include obsidian-vessel($nyxus-accent-primary, 0.75); color: $accent-primary-soft;
  text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.45); }
.app-pill-green  { @include obsidian-vessel($nyxus-accent-secondary, 0.75); color: $accent-secondary-soft;
  text-shadow: 0 0 8px rgba($nyxus-accent-secondary, 0.45); }
.app-pill-purple { @include obsidian-vessel($nyxus-accent-ok, 0.75); color: $accent-ok-soft;
  text-shadow: 0 0 8px rgba($nyxus-accent-ok, 0.45); }
.app-pill-gold   { @include obsidian-vessel($nyxus-accent-warn, 0.75); color: $accent-warn-soft;
  text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.45); }
.app-pill-orange { @include obsidian-vessel($neon-orange, 0.75); color: $neon-orange-soft;
  text-shadow: 0 0 8px rgba($neon-orange, 0.45); }
.app-pill-blue   { @include obsidian-vessel($neon-blue, 0.75); color: $neon-blue-soft;
  text-shadow: 0 0 8px rgba($neon-blue, 0.45); }
.app-pill-pink:hover   { @include obsidian-vessel-hover($nyxus-accent-primary); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.85); }
.app-pill-green:hover  { @include obsidian-vessel-hover($nyxus-accent-secondary); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.85); }
.app-pill-purple:hover { @include obsidian-vessel-hover($nyxus-accent-ok); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-ok, 0.85); }
.app-pill-gold:hover   { @include obsidian-vessel-hover($nyxus-accent-warn); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-warn, 0.85); }
.app-pill-orange:hover { @include obsidian-vessel-hover($neon-orange); color: #ffffff;
  text-shadow: 0 0 12px rgba($neon-orange, 0.85); }
.app-pill-blue:hover   { @include obsidian-vessel-hover($neon-blue); color: #ffffff;
  text-shadow: 0 0 12px rgba($neon-blue, 0.85); }

/* -- workspace pills: crank the states (final word in the cascade) ---- */
/* Same machined obsidian-vessel ring language as the right app rail:
   every pill is a solid near-black keycap wrapped in a neon hairline. */
.ws-pill {
  border-radius: 11px;
  @include obsidian-vessel($nyxus-accent-primary, 0.5);
  color: rgba(232, 237, 245, 0.42);
}
.ws-pill-pink   { @include obsidian-vessel($nyxus-accent-primary, 0.65); color: $accent-primary-soft; }
.ws-pill-green  { @include obsidian-vessel($nyxus-accent-secondary, 0.65); color: $accent-secondary-soft; }
.ws-pill-purple { @include obsidian-vessel($nyxus-accent-ok, 0.65); color: $accent-ok-soft; }
.ws-pill-gold   { @include obsidian-vessel($nyxus-accent-warn, 0.65); color: $accent-warn-soft; }
.ws-pill-orange { @include obsidian-vessel($neon-orange, 0.65); color: $neon-orange-soft; }
.ws-pill-blue   { @include obsidian-vessel($neon-blue, 0.65); color: $neon-blue-soft; }
.ws-pill-cyan   { @include obsidian-vessel($neon-cyan, 0.65); color: rgba($neon-cyan, 0.88); }
.ws-pill-occupied {
  text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.55);
}
.ws-pill-pink:hover   { @include obsidian-vessel-hover($nyxus-accent-primary); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.85); }
.ws-pill-green:hover  { @include obsidian-vessel-hover($nyxus-accent-secondary); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.85); }
.ws-pill-purple:hover { @include obsidian-vessel-hover($nyxus-accent-ok); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-ok, 0.85); }
.ws-pill-gold:hover   { @include obsidian-vessel-hover($nyxus-accent-warn); color: #ffffff;
  text-shadow: 0 0 12px rgba($nyxus-accent-warn, 0.85); }
.ws-pill-orange:hover { @include obsidian-vessel-hover($neon-orange); color: #ffffff;
  text-shadow: 0 0 12px rgba($neon-orange, 0.85); }
.ws-pill-blue:hover   { @include obsidian-vessel-hover($neon-blue); color: #ffffff;
  text-shadow: 0 0 12px rgba($neon-blue, 0.85); }
.ws-pill-cyan:hover   { @include obsidian-vessel-hover($neon-cyan); color: #ffffff;
  text-shadow: 0 0 12px rgba($neon-cyan, 0.85); }
.ws-pill-active {
  background: linear-gradient(135deg, $nyxus-accent-primary, $nyxus-accent-secondary);
  color: #05060a;
  border: 1px solid rgba(255, 255, 255, 0.75);
  box-shadow:
    0 0 20px rgba($nyxus-accent-primary, 0.90),
    0 0 42px rgba($nyxus-accent-secondary, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

/* =====================================================================
   HOME-HUD DASHBOARD v2 - rev 2026-07-09
   Graffiti greeting, card headers with rule + stamp, ring gauges,
   colored card numerals, per-hue action toggles, micro footers.
   =================================================================== */

/* -- header strip ------------------------------------------------------ */
.dash-tag {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  font-weight: 700;
  color: $grey-mid;
  letter-spacing: 0.22em;
}
.dash-stamp {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 9px;
  color: $grey-ghost;
  letter-spacing: 0.14em;
}
.dash-greet {
  font-family: "Caveat", "Inter", sans-serif;
  font-size: 38px;
  color: $text;
  text-shadow: 0 0 14px rgba(255, 255, 255, 0.35);
}
.dash-greet-accent {
  font-family: "Caveat", "Inter", sans-serif;
  font-size: 38px;
  color: $nyxus-accent-primary;
  text-shadow:
    0 0 14px rgba($nyxus-accent-primary, 0.85),
    0 0 30px rgba($nyxus-accent-primary, 0.40);
}

/* -- card header: glyph + Inter Display title + rule + mono stamp ----- */
.dash-hdr-glyph  { font-size: 15px; }
.dash-hdr-title  {
  font-family: "Inter Display", "Inter", sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.dash-hdr-stamp  {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 7px;
  color: $grey-ghost;
  /* NO letter-spacing: tracking ellipsizes these micro stamps */
}
.dash-hdr-rule   { min-height: 1px; background: rgba(255, 255, 255, 0.10); }

/* per-card hue on header glyph/title/rule via the nth-child hue map */
.dash-grid .dash-card:nth-child(1) .dash-hdr-glyph,
.dash-grid .dash-card:nth-child(1) .dash-hdr-title { color: $nyxus-accent-warn; text-shadow: 0 0 10px rgba($nyxus-accent-warn, 0.55); }
.dash-grid .dash-card:nth-child(1) .dash-hdr-rule  { background: rgba($nyxus-accent-warn, 0.25); }
.dash-grid .dash-card:nth-child(2) .dash-hdr-glyph,
.dash-grid .dash-card:nth-child(2) .dash-hdr-title { color: $nyxus-accent-primary; text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.55); }
.dash-grid .dash-card:nth-child(2) .dash-hdr-rule  { background: rgba($nyxus-accent-primary, 0.25); }
.dash-grid .dash-card:nth-child(3) .dash-hdr-glyph,
.dash-grid .dash-card:nth-child(3) .dash-hdr-title { color: $neon-orange; text-shadow: 0 0 10px rgba($neon-orange, 0.55); }
.dash-grid .dash-card:nth-child(3) .dash-hdr-rule  { background: rgba($neon-orange, 0.25); }
.dash-grid .dash-card:nth-child(4) .dash-hdr-glyph,
.dash-grid .dash-card:nth-child(4) .dash-hdr-title { color: $nyxus-accent-ok; text-shadow: 0 0 10px rgba($nyxus-accent-ok, 0.55); }
.dash-grid .dash-card:nth-child(4) .dash-hdr-rule  { background: rgba($nyxus-accent-ok, 0.25); }
.dash-player .dash-hdr-glyph,
.dash-player .dash-hdr-title { color: $neon-red; text-shadow: 0 0 10px rgba($neon-red, 0.55); }
.dash-player .dash-hdr-rule  { background: rgba($neon-red, 0.25); }
.dash-cores-card .dash-hdr-glyph,
.dash-cores-card .dash-hdr-title { color: $nyxus-accent-primary; text-shadow: 0 0 10px rgba($nyxus-accent-primary, 0.55); }
.dash-cores-card .dash-hdr-rule  { background: rgba($nyxus-accent-primary, 0.25); }

/* -- colored big numerals (reference: values carry the card hue) ------ */
.dash-big-gold   { color: $nyxus-accent-warn;
                   text-shadow: 0 0 14px rgba($nyxus-accent-warn, 0.55), 0 0 28px rgba($nyxus-accent-warn, 0.25); }
.dash-big-pink   { color: $nyxus-accent-primary;
                   text-shadow: 0 0 14px rgba($nyxus-accent-primary, 0.55), 0 0 28px rgba($nyxus-accent-primary, 0.25); }
.dash-big-orange { color: $neon-orange;
                   text-shadow: 0 0 14px rgba($neon-orange, 0.55), 0 0 28px rgba($neon-orange, 0.25); }

/* script accent line inside cards (weather summary etc.) */
.dash-card-script {
  font-family: "Caveat", "Inter", sans-serif;
  font-size: 17px;
  color: $dim;
}

/* dashed micro footer (style.py card-footer voice) */
.dash-card-foot {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 8px;
  letter-spacing: 0.04em;
  padding-top: 5px;
  border-top: 1px dashed rgba(255, 255, 255, 0.10);
}
.dash-foot-gold   { color: rgba($nyxus-accent-warn, 0.60);   border-top-color: rgba($nyxus-accent-warn, 0.16); }
.dash-foot-pink   { color: rgba($nyxus-accent-primary, 0.60); border-top-color: rgba($nyxus-accent-primary, 0.16); }
.dash-foot-orange { color: rgba($neon-orange, 0.60);          border-top-color: rgba($neon-orange, 0.16); }
.dash-foot-purple { color: rgba($nyxus-accent-ok, 0.60);      border-top-color: rgba($nyxus-accent-ok, 0.16); }
.dash-foot-red    { color: rgba($neon-red, 0.60);             border-top-color: rgba($neon-red, 0.16); }

/* -- ring gauges (HUD SYSTEM CORE voice) ------------------------------- */
.dash-ring {
  min-width: 74px;
  min-height: 74px;
  background-color: rgba(255, 255, 255, 0.07);   /* track */
  border-radius: 999px;
}
.dash-ring-value {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 13px;
  font-weight: 700;
  color: $text;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.40);
}
.dash-ring-label {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.06em;
}
.dash-ring-pink        { color: $nyxus-accent-primary; }
.dash-ring-label-pink  { color: $nyxus-accent-primary; text-shadow: 0 0 8px rgba($nyxus-accent-primary, 0.55); }
.dash-ring-purple      { color: $nyxus-accent-ok; }
.dash-ring-label-purple{ color: $nyxus-accent-ok; text-shadow: 0 0 8px rgba($nyxus-accent-ok, 0.55); }
.dash-ring-orange      { color: $neon-orange; }
.dash-ring-label-orange{ color: $neon-orange; text-shadow: 0 0 8px rgba($neon-orange, 0.55); }
.dash-ring-gold        { color: $nyxus-accent-warn; }
.dash-ring-label-gold  { color: $nyxus-accent-warn; text-shadow: 0 0 8px rgba($nyxus-accent-warn, 0.55); }

/* -- multi-neon action toggles ----------------------------------------- */
.dash-toggle-green  { border-color: rgba($nyxus-accent-secondary, 0.45); }
.dash-toggle-green  .dash-toggle-glyph { color: $nyxus-accent-secondary; text-shadow: 0 0 12px rgba($nyxus-accent-secondary, 0.55); }
.dash-toggle-green:hover  { background: rgba($nyxus-accent-secondary, 0.13); border-color: $nyxus-accent-secondary;
                            box-shadow: 0 0 24px rgba($nyxus-accent-secondary, 0.40); }
.dash-toggle-blue   { border-color: rgba($neon-blue, 0.45); }
.dash-toggle-blue   .dash-toggle-glyph { color: $neon-blue; text-shadow: 0 0 12px rgba($neon-blue, 0.55); }
.dash-toggle-blue:hover   { background: rgba($neon-blue, 0.13); border-color: $neon-blue;
                            box-shadow: 0 0 24px rgba($neon-blue, 0.40); }
.dash-toggle-purple { border-color: rgba($nyxus-accent-ok, 0.45); }
.dash-toggle-purple .dash-toggle-glyph { color: $nyxus-accent-ok; text-shadow: 0 0 12px rgba($nyxus-accent-ok, 0.55); }
.dash-toggle-purple:hover { background: rgba($nyxus-accent-ok, 0.13); border-color: $nyxus-accent-ok;
                            box-shadow: 0 0 24px rgba($nyxus-accent-ok, 0.40); }
.dash-toggle-pink   { border-color: rgba($nyxus-accent-primary, 0.45); }
.dash-toggle-pink   .dash-toggle-glyph { color: $nyxus-accent-primary; text-shadow: 0 0 12px rgba($nyxus-accent-primary, 0.55); }
.dash-toggle-pink:hover   { background: rgba($nyxus-accent-primary, 0.13); border-color: $nyxus-accent-primary;
                            box-shadow: 0 0 24px rgba($nyxus-accent-primary, 0.40); }
.dash-toggle-gold   { border-color: rgba($nyxus-accent-warn, 0.45); }
.dash-toggle-gold   .dash-toggle-glyph { color: $nyxus-accent-warn; text-shadow: 0 0 12px rgba($nyxus-accent-warn, 0.55); }
.dash-toggle-gold:hover   { background: rgba($nyxus-accent-warn, 0.13); border-color: $nyxus-accent-warn;
                            box-shadow: 0 0 24px rgba($nyxus-accent-warn, 0.40); }
.dash-toggle-orange { border-color: rgba($neon-orange, 0.45); }
.dash-toggle-orange .dash-toggle-glyph { color: $neon-orange; text-shadow: 0 0 12px rgba($neon-orange, 0.55); }
.dash-toggle-orange:hover { background: rgba($neon-orange, 0.13); border-color: $neon-orange;
                            box-shadow: 0 0 24px rgba($neon-orange, 0.40); }
.dash-toggle-red    { border-color: rgba($neon-red, 0.45); }
.dash-toggle-red    .dash-toggle-glyph { color: $neon-red; text-shadow: 0 0 12px rgba($neon-red, 0.55); }
.dash-toggle-red:hover    { background: rgba($neon-red, 0.13); border-color: $neon-red;
                            box-shadow: 0 0 24px rgba($neon-red, 0.40); }

/* =====================================================================
   GRAFFITI VOICE - rev 2026-07-09 (ingredient 3: street-art energy)
   Marker wordmarks with spray-halo glow on the big overlay titles,
   heavier neon bloom on the brand pill. Tasteful - titles only.
   =================================================================== */
.power-title, .cheat-title, .dc-title {
  font-family: "Permanent Marker", "Inter Display", sans-serif;
  font-weight: 400;
  letter-spacing: 0.10em;
}
.power-title {
  color: $nyxus-accent-primary;
  text-shadow:
    0 0 12px rgba($nyxus-accent-primary, 0.90),
    0 0 30px rgba($nyxus-accent-primary, 0.45),
    0 0 60px rgba($nyxus-accent-secondary, 0.25);
}
.cheat-title {
  color: $nyxus-accent-secondary;
  text-shadow:
    0 0 12px rgba($nyxus-accent-secondary, 0.90),
    0 0 30px rgba($nyxus-accent-secondary, 0.45),
    0 0 60px rgba($nyxus-accent-primary, 0.25);
}
.dc-title {
  color: $nyxus-accent-warn;
  text-shadow:
    0 0 12px rgba($nyxus-accent-warn, 0.90),
    0 0 30px rgba($nyxus-accent-warn, 0.45),
    0 0 60px rgba($neon-orange, 0.25);
}
.brand-gem, .brand-word {
  text-shadow:
    0 0 12px rgba(255, 255, 255, 0.75),
    0 0 24px rgba($neon-red, 0.55),
    0 0 40px rgba($nyxus-accent-primary, 0.25);
}
/* spray-halo on the hero clock - pink/green double bloom like the wall */
.dash-clock {
  text-shadow:
    0 0 12px rgba(255, 255, 255, 0.60),
    0 0 34px rgba($nyxus-accent-primary, 0.55),
    0 0 70px rgba($nyxus-accent-secondary, 0.30);
}

/* =====================================================================
   AURORA BAR FILLS - rev 2026-07-09
   The inline :style strings paint 5-6 stacked background layers per
   bar (scanline texture / sliding pulse + focus halos / aurora drift /
   legibility glass / prism rim). Origin+clip lists below MUST match
   the layer counts in the yuck :style strings: every layer clips to
   the padding box except the final prism rim, which paints the
   transparent border ring (border-box).
   =================================================================== */
/* Aurora layer maps for nexus deck — prism rim on border-box. */
.nexus-deck {
  background-blend-mode: screen, screen, normal, normal;
  background-size: 100% 100%, 100% 100%, 100% 100%, 100% 100%;
  background-origin: padding-box, padding-box, padding-box, border-box;
  background-clip:   padding-box, padding-box, padding-box, border-box;
}
/* legacy bottom controls (removed) */
.bar-bottom-controls {
  background-blend-mode: normal, normal, screen, screen, screen, normal, normal;
  background-size: 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%;
  background-origin: padding-box, padding-box, padding-box, padding-box, padding-box, padding-box, border-box;
  background-clip:   padding-box, padding-box, padding-box, padding-box, padding-box, padding-box, border-box;
}
.ws-rail, .app-rail {
  background: transparent;
  background-image: none;
}

/* STARFALL ember alert - stressed metrics burn gold (keep LAST). */
.hud-tile-alert {
  border-color: rgba(255, 176, 80, 0.75);
  border-top-color: rgba(255, 200, 120, 0.95);
  box-shadow:
    0 0 14px rgba(255, 140, 40, 0.45),
    0 0 28px rgba(255, 90, 20, 0.22),
    inset 0 1px 0 rgba(255, 244, 214, 0.30),
    inset 0 -7px 14px rgba(255, 132, 32, 0.30);
}
.hud-tile-alert .hud-tile-value,
.hud-tile-alert .hud-tile-glyph,
.hud-tile-alert .hud-tile-label {
  color: #ffd9a0;
  text-shadow: 0 0 9px rgba(255, 160, 60, 0.80);
}
.hud-tile-strip .hud-tile {
  padding: 1px 7px;
}
.hud-tile-strip .hud-tile-value {
  font-size: 9px;
}
.hud-tile-strip .hud-tile-label {
  font-size: 7px;
}

/* =====================================================================
   APPLE-GRADE POLISH - rev 2026-07-13
   Global interactive feedback, unified motion, and spacing rhythm.
   Keep LAST so it wins the cascade without fighting HUD modules.
   =================================================================== */

button, .pill, .ws-pill, .app-pill, .panel-tab, .qs-tile,
.dash-toggle, .dash-close, .power-btn, .flyout-close,
.wifi-toggle, .wifi-rescan, .bt-toggle, .bt-scan,
.wifi-act, .bt-act, .wifi-forget, .bt-forget,
.bar-flip-collapse, .search-btn, .upd-sync, .upd-refresh {
  transition: all $t-fast;
}

button:active, .pill:active, .ws-pill:active, .app-pill:active,
.qs-tile:active, .dash-toggle:active, .bar-flip-collapse:active {
  /* eww 0.5 rejects transform — press feedback via obsidian-press mixin only */
}

.bar-flip-collapse:active {
  @include obsidian-press($nyxus-accent-primary);
}

.dash-close, .cheat-close, .dc-close {
  transition: all $t-fast;
}
.dash-close:hover, .cheat-close:hover, .dc-close:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.28);
}

.ws-pill, .app-pill {
  transition: all $t-med;
}

.dashboard-root, .powermenu-root, .cheat-root, .deepcore-root, .hub-panel {
  border-radius: $radius-xl;
}

.dash-card {
  border-radius: $radius-md;
}

.notif-row, .upd-row {
  margin-bottom: 4px;
}

.flyout-title {
  font-family: "Inter Display", "Inter", sans-serif;
  font-size: 12px;
  letter-spacing: 0.24em;
}
