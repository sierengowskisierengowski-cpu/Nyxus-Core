#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-ghost-helper on|off   ·   rev 2026-07-17   ·   ROOT ONLY
#
# Privileged backend for nyxus-ghost (invisibility / anonymity mode).
# Invoked via pkexec/sudo. Does the four privileged operations and their
# exact reversal. Everything is idempotent and guarded so a partial state
# can always be cleaned up by `nyxus-ghost-helper off`.
#
#   ON : write Tor transparent-proxy torrc drop-in, start tor, install the
#        nftables `nyxus_ghost` egress kill-switch, randomise NIC MACs,
#        stop avahi-daemon.
#   OFF: flush the nftables table, stop tor, restore permanent MACs,
#        restart avahi-daemon.
#
# The kill-switch is the standard Tor "transparent proxy + leak block"
# ruleset: allow loopback + the tor daemon's own uid + the redirected
# TransPort/DNSPort, redirect all other TCP → 9040 and DNS → 5353, and
# DROP everything else outbound so nothing can escape around Tor.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u

if [[ "$(id -u)" -ne 0 ]]; then
  echo "nyxus-ghost-helper: must run as root (invoke via nyxus-ghost)" >&2
  exit 1
fi

TOR_UID="$(id -u tor 2>/dev/null || echo '')"
TORRC_DROPIN="/etc/tor/torrc.d/10-nyxus-ghost.conf"
TRANS_PORT=9040
DNS_PORT=5353
VIRT_NET="10.192.0.0/10"
MAC_SAVE="/run/nyxus-ghost-macs"
NFT_TABLE="nyxus_ghost"

log() { echo "[nyxus-ghost-helper] $*"; }

nics() {
  # Physical wired/wireless interfaces only (skip lo, virtual, docker, etc.)
  for d in /sys/class/net/*; do
    n="$(basename "$d")"
    case "$n" in
      lo|docker*|br-*|veth*|virbr*|tun*|tap*|wg*|nyx*) continue ;;
    esac
    [[ -e "$d/device" ]] || continue
    echo "$n"
  done
}

ghost_on() {
  # ── 1. Tor transparent-proxy config ────────────────────────────────
  if [[ -z "${TOR_UID}" ]]; then
    log "tor user not found — is the 'tor' package installed? aborting."
    return 1
  fi
  mkdir -p /etc/tor/torrc.d
  cat > "${TORRC_DROPIN}" <<EOF
# Generated by nyxus-ghost — transparent proxy + DNS. Removed on ghost off.
VirtualAddrNetworkIPv4 ${VIRT_NET}
AutomapHostsOnResolve 1
TransPort 127.0.0.1:${TRANS_PORT} IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort
DNSPort 127.0.0.1:${DNS_PORT}
EOF
  # Ensure the main torrc actually pulls in the drop-in dir.
  if ! grep -q '^%include /etc/tor/torrc.d/' /etc/tor/torrc 2>/dev/null; then
    echo '%include /etc/tor/torrc.d/*.conf' >> /etc/tor/torrc
  fi
  systemctl restart tor 2>/dev/null || systemctl start tor 2>/dev/null || {
    log "failed to start tor"; return 1; }

  # ── 2. nftables egress kill-switch (Tor transparent redirect) ──────
  nft list table inet "${NFT_TABLE}" >/dev/null 2>&1 && nft delete table inet "${NFT_TABLE}"
  nft -f - <<EOF
table inet ${NFT_TABLE} {
  chain output {
    type filter hook output priority 0; policy drop;
    oifname "lo" accept
    meta skuid ${TOR_UID} accept
    ct state established,related accept
    # allow the local redirect targets (handled by nat below)
    ip daddr 127.0.0.1 tcp dport { ${TRANS_PORT}, ${DNS_PORT} } accept
    udp dport ${DNS_PORT} ip daddr 127.0.0.1 accept
    # everything else outbound is dropped → no clearnet / DNS leak
  }
  chain nat_output {
    type nat hook output priority -100; policy accept;
    meta skuid ${TOR_UID} return
    oifname "lo" return
    # redirect DNS → Tor DNSPort
    udp dport 53 redirect to :${DNS_PORT}
    tcp dport 53 redirect to :${DNS_PORT}
    # redirect all other TCP → Tor TransPort
    ip daddr != 127.0.0.0/8 tcp flags & (fin|syn|rst|ack) == syn redirect to :${TRANS_PORT}
  }
}
EOF
  if [[ $? -ne 0 ]]; then
    log "nftables ruleset failed to load — aborting, no kill-switch installed."
    systemctl stop tor 2>/dev/null || true
    rm -f "${TORRC_DROPIN}"
    return 1
  fi

  # ── 3. MAC randomisation (save current perms first) ────────────────
  : > "${MAC_SAVE}"
  for n in $(nics); do
    perm="$(macchanger -s "$n" 2>/dev/null | awk '/Permanent MAC/{print $3}')"
    [[ -n "${perm}" ]] && echo "${n} ${perm}" >> "${MAC_SAVE}"
    ip link set dev "$n" down 2>/dev/null || true
    macchanger -r "$n" >/dev/null 2>&1 || true
    ip link set dev "$n" up 2>/dev/null || true
  done

  # ── 4. Hide presence — stop mDNS/avahi ─────────────────────────────
  systemctl stop avahi-daemon.service avahi-daemon.socket 2>/dev/null || true

  log "ghost ON — Tor transparent proxy + egress kill-switch + MAC random + mDNS muted."
}

ghost_off() {
  # ── reverse 2. nftables ────────────────────────────────────────────
  nft list table inet "${NFT_TABLE}" >/dev/null 2>&1 && nft delete table inet "${NFT_TABLE}"

  # ── reverse 1. Tor ─────────────────────────────────────────────────
  systemctl stop tor 2>/dev/null || true
  rm -f "${TORRC_DROPIN}"

  # ── reverse 3. MAC — restore permanent addresses ───────────────────
  if [[ -f "${MAC_SAVE}" ]]; then
    while read -r n mac; do
      [[ -z "${n}" ]] && continue
      ip link set dev "$n" down 2>/dev/null || true
      macchanger --mac="${mac}" "$n" >/dev/null 2>&1 || macchanger -p "$n" >/dev/null 2>&1 || true
      ip link set dev "$n" up 2>/dev/null || true
    done < "${MAC_SAVE}"
    rm -f "${MAC_SAVE}"
  else
    for n in $(nics); do
      ip link set dev "$n" down 2>/dev/null || true
      macchanger -p "$n" >/dev/null 2>&1 || true
      ip link set dev "$n" up 2>/dev/null || true
    done
  fi

  # ── reverse 4. avahi ───────────────────────────────────────────────
  systemctl start avahi-daemon.service 2>/dev/null || true

  log "ghost OFF — clearnet restored, Tor stopped, MAC + mDNS restored."
}

case "${1:-}" in
  on)  ghost_on ;;
  off) ghost_off ;;
  *)   echo "usage: nyxus-ghost-helper on|off" >&2; exit 2 ;;
esac
