#!/usr/bin/env bash
# NYXUS — SDDM/display-manager → Hyprland session entrypoint
# © 2026 JOSEPH SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
#
# Called by ~/.local/share/wayland-sessions/nyxus-hyprland.desktop
# (or /usr/share/wayland-sessions/nyxus-hyprland.desktop on the ISO).
# Sets the env vars SDDM does not hand to Wayland compositors, then execs
# Hyprland so the session owns PID 1 of the user tree.
set -euo pipefail

# PATH FIX (2026-07-14): display managers (greetd/regreet) launch this with a
# minimal PATH that does NOT include ~/.local/bin, where the nyxus autostart
# launchers (nyxus-wait-bootstrap, nyxus-persist-login, nyxus-boot-check, …)
# live. Without this, Hyprland's exec-once lines fail "command not found" and
# the bars/widgets never come back after login. Put ~/.local/bin first so the
# whole session (Hyprland + every exec-once child + user services) can find
# them, regardless of how the session was started.
export PATH="${HOME}/.local/bin:${PATH}"

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# systemd --user needs a bus; SDDM sometimes omits this on first launch.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
    DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT \
    >/dev/null 2>&1 || true
fi

# Prefer the distro wrapper if present (Hyprland 0.55+), else bare binary.
if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland
elif command -v Hyprland >/dev/null 2>&1; then
  exec Hyprland
else
  echo "nyxus-session-start: Hyprland binary not found on PATH" >&2
  exit 1
fi
