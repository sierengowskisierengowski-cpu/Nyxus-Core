#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────
#  nyxus-pull-all  ·  ONE-SHOT NYXUS BUILD INSTALLER (user scope)
#
#  Lays the entire designed NYXUS build onto this laptop in a single
#  command, by reading /api/download/nyxus/manifest.json and downloading
#  every userInstallable file directly to its final on-disk target
#  (~/.config/, ~/.local/bin/, ~/.local/share/, etc).
#
#  Usage (from the TTY, after `nyxus-bootstrap` has put you in Hyprland
#  OR from any working shell):
#
#    NYXUS_API=https://nyxus-core.replit.app  # or your dev URL
#    curl -fsSL "$NYXUS_API/api/download/nyxus/nyxus-pull-all" -o /tmp/p
#    bash /tmp/p
#
#  What it does, in order:
#    1. Fetch manifest.json
#    2. For each userInstallable entry: download to a tmp file, verify
#       SHA-256 against the manifest, atomically mv into place with the
#       correct mode bits.
#    3. Reload systemd --user, restart EWW, hyprctl reload Hyprland.
#    4. Print a summary: installed / unchanged / skipped (root) / failed.
#
#  Safe to re-run. Files whose SHA already matches on disk are skipped.
#  Nothing here needs sudo — root-only files (polkit, calamares, etc.)
#  are listed in the manifest with userInstallable=false and skipped
#  with a printed reason.
# ──────────────────────────────────────────────────────────────────────

set -u
set -o pipefail

NYXUS_API="${NYXUS_API:-https://nyxus-core.replit.app}"
MANIFEST_URL="${NYXUS_API%/}/api/download/nyxus/manifest.json"

# ── colors (cream / copper / triple-black brand palette) ─────────────
if [[ -t 1 ]]; then
  C_CREAM=$'\e[38;2;244;234;213m'
  C_COPPER=$'\e[38;2;184;134;90m'
  C_DIM=$'\e[2m'
  C_BOLD=$'\e[1m'
  C_ERR=$'\e[38;2;220;120;90m'
  C_OFF=$'\e[0m'
else
  C_CREAM= C_COPPER= C_DIM= C_BOLD= C_ERR= C_OFF=
fi

say()  { printf '%s\n' "${C_CREAM}${*}${C_OFF}"; }
note() { printf '%s\n' "${C_DIM}${*}${C_OFF}"; }
ok()   { printf '  %s✓%s %s\n' "$C_COPPER" "$C_OFF" "$*"; }
skip() { printf '  %s·%s %s\n' "$C_DIM"    "$C_OFF" "$*"; }
err()  { printf '  %s✗%s %s\n' "$C_ERR"    "$C_OFF" "$*" >&2; }
hdr()  { printf '\n%s%s── %s ──%s\n' "$C_BOLD" "$C_CREAM" "$*" "$C_OFF"; }

# ── prerequisites ────────────────────────────────────────────────────
need() { command -v "$1" >/dev/null 2>&1 || { err "missing: $1"; exit 1; }; }
need curl
need sha256sum
need install
need awk
need sed

# Python is the only sane way to parse JSON without bringing in jq.
PY=python3
command -v "$PY" >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || { err "missing: python3"; exit 1; }

# ── stage manifest ───────────────────────────────────────────────────
hdr "NYXUS one-shot installer"
say "API:      $NYXUS_API"
say "Manifest: $MANIFEST_URL"

TMP_ROOT="$(mktemp -d -t nyxus-pull-all-XXXXXX)"
trap 'rm -rf "$TMP_ROOT"' EXIT

MAN="$TMP_ROOT/manifest.json"
if ! curl -fsSL --retry 3 --connect-timeout 10 "$MANIFEST_URL" -o "$MAN"; then
  err "could not fetch manifest from $MANIFEST_URL"
  exit 2
fi

# Flatten manifest → tab-separated rows the shell can read line-by-line.
# Columns:  src \t dst \t mode \t sha256 \t userInstallable(1/0) \t reason
ROWS="$TMP_ROOT/rows.tsv"
"$PY" - "$MAN" >"$ROWS" <<'PYEOF'
import json, os, sys
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    m = json.load(f)
home = os.path.expanduser("~")
xdg_cfg  = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
xdg_data = os.environ.get("XDG_DATA_HOME")   or os.path.join(home, ".local", "share")
xdg_cache= os.environ.get("XDG_CACHE_HOME")  or os.path.join(home, ".cache")
def subst(s):
    return (s.replace("$HOME", home)
             .replace("$XDG_CONFIG_HOME", xdg_cfg)
             .replace("$XDG_DATA_HOME",   xdg_data)
             .replace("$XDG_CACHE_HOME",  xdg_cache))
# Server schema (v2):
#   { version, generated_at, file_count,
#     files: { "<src>": { sha256, size_bytes, dst, mode,
#                         userInstallable, reason? } } }
files = m.get("files", {})
if isinstance(files, list):
    # Defensive: handle a future array-shaped manifest too.
    iterable = [(e.get("src",""), e) for e in files]
else:
    iterable = list(files.items())
for src, e in iterable:
    if not src:
        continue
    sys.stdout.write("\t".join([
        src,
        subst(e.get("dst","")),
        e.get("mode","0644"),
        e.get("sha256",""),
        "1" if e.get("userInstallable") else "0",
        e.get("reason",""),
    ]) + "\n")
PYEOF

TOTAL=$(wc -l <"$ROWS" | tr -d ' ')
say "Files in manifest: $TOTAL"

# ── install loop ─────────────────────────────────────────────────────
INSTALLED=0; UNCHANGED=0; SKIPPED=0; FAILED=0; BYTES=0
FAIL_LOG="$TMP_ROOT/failures.log"
: >"$FAIL_LOG"

hdr "Laying down files"
while IFS=$'\t' read -r SRC DST MODE SHA USER REASON; do
  [[ -z $SRC ]] && continue

  if [[ $USER != "1" ]]; then
    SKIPPED=$((SKIPPED+1))
    skip "${SRC}  ${C_DIM}(${REASON:-needs root})${C_OFF}"
    continue
  fi

  # Already in place and bytes match? Don't re-download.
  if [[ -f $DST ]] && [[ -n $SHA ]]; then
    CUR=$(sha256sum "$DST" 2>/dev/null | awk '{print $1}')
    if [[ $CUR == "$SHA" ]]; then
      UNCHANGED=$((UNCHANGED+1))
      continue
    fi
  fi

  URL="${NYXUS_API%/}/api/download/nyxus/${SRC}"
  TMP="$TMP_ROOT/blob.$$"
  if ! curl -fsSL --retry 3 --connect-timeout 10 "$URL" -o "$TMP"; then
    FAILED=$((FAILED+1))
    err "$SRC  (download failed)"
    printf '%s\tdownload-failed\n' "$SRC" >>"$FAIL_LOG"
    continue
  fi

  if [[ -n $SHA ]]; then
    GOT=$(sha256sum "$TMP" | awk '{print $1}')
    if [[ $GOT != "$SHA" ]]; then
      FAILED=$((FAILED+1))
      err "$SRC  (sha256 mismatch: got $GOT, want $SHA)"
      printf '%s\tsha-mismatch\n' "$SRC" >>"$FAIL_LOG"
      rm -f "$TMP"
      continue
    fi
  fi

  mkdir -p "$(dirname "$DST")" || true
  if ! install -m "$MODE" "$TMP" "$DST" 2>/dev/null; then
    # `install` may fail on filesystems that don't honour chmod;
    # fall back to mv + chmod and ignore chmod errors.
    if mv -f "$TMP" "$DST"; then
      chmod "$MODE" "$DST" 2>/dev/null || true
    else
      FAILED=$((FAILED+1))
      err "$SRC  (could not write $DST)"
      printf '%s\twrite-failed\n' "$SRC" >>"$FAIL_LOG"
      rm -f "$TMP"
      continue
    fi
  fi
  rm -f "$TMP"

  SZ=$(stat -c%s "$DST" 2>/dev/null || echo 0)
  BYTES=$((BYTES+SZ))
  INSTALLED=$((INSTALLED+1))
  ok "$SRC  ${C_DIM}→ $DST${C_OFF}"
done <"$ROWS"

# ── post-install: reload services so changes take effect now ─────────
hdr "Reloading services"

if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user daemon-reload 2>/dev/null; then
    ok "systemctl --user daemon-reload"
  else
    skip "systemctl --user not available in this session"
  fi
fi

if command -v hyprctl >/dev/null 2>&1 && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null 2>&1 && ok "hyprctl reload"
else
  skip "Hyprland not running in this session — reload on next login"
fi

if command -v eww >/dev/null 2>&1; then
  eww --config "$HOME/.config/eww" kill        >/dev/null 2>&1 || true
  if command -v nyxus-eww-launch >/dev/null 2>&1; then
    nohup nyxus-eww-launch >/dev/null 2>&1 &
    ok "EWW restarted via nyxus-eww-launch"
  else
    skip "nyxus-eww-launch not on PATH yet — log out/in"
  fi
fi

# ── summary ──────────────────────────────────────────────────────────
hdr "Summary"
human_bytes() {
  local b=$1
  if   (( b > 1024*1024 )); then awk -v b=$b 'BEGIN{printf "%.1f MB", b/1024/1024}'
  elif (( b > 1024 ));      then awk -v b=$b 'BEGIN{printf "%.1f KB", b/1024}'
  else printf '%s B' "$b"
  fi
}

printf '  installed:  %s%d%s files (%s)\n'  "$C_COPPER" "$INSTALLED" "$C_OFF" "$(human_bytes $BYTES)"
printf '  unchanged:  %s%d%s files (sha match)\n' "$C_DIM" "$UNCHANGED" "$C_OFF"
printf '  skipped:    %s%d%s files (root-only — run a root installer for these)\n' "$C_DIM" "$SKIPPED" "$C_OFF"
if (( FAILED > 0 )); then
  printf '  failed:     %s%d%s files — see %s\n' "$C_ERR" "$FAILED" "$C_OFF" "$FAIL_LOG"
  cp "$FAIL_LOG" "$HOME/.cache/nyxus-pull-all.failures" 2>/dev/null || true
  exit 3
fi

say ""
say "${C_BOLD}NYXUS is on this laptop.${C_OFF}"
note "Log out / back in (or run \`hyprctl reload\`) to see every change applied."
exit 0
