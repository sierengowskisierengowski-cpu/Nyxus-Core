#!/usr/bin/env bash
# NYXUS - duplicate-proof eww launcher wrapper.
set -u

pkill -9 -x eww 2>/dev/null
pkill -9 -f '/eww (daemon|open|open-many|reload|close)' 2>/dev/null
sleep 0.5
rm -f "${XDG_RUNTIME_DIR:-/tmp}"/eww-server_* 2>/dev/null

if ! eww ping >/dev/null 2>&1; then
  eww daemon &
  dpid=$!
  for _ in $(seq 1 60); do
    eww ping >/dev/null 2>&1 && break
    sleep 0.25
  done
  if ! eww ping >/dev/null 2>&1; then
    echo "nyxus-eww-launch-safe: eww daemon failed to start" >&2
    exit 1
  fi
fi

exec "$(command -v nyxus-eww-launch || echo /usr/local/bin/nyxus-eww-launch)"
