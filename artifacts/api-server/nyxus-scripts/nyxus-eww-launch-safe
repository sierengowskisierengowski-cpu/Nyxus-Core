#!/usr/bin/env bash
# NYXUS - duplicate-proof eww launcher wrapper.
# Stray second daemons (or zombie "eww open ..." clients parented to init)
# each draw all four bars a few px apart - the "two bars" ghost. Kill
# every eww process, wipe stale sockets, then let nyxus-eww-launch start
# exactly ONE daemon and open the bars.
set -u

pkill -9 -x eww 2>/dev/null
pkill -9 -f '/eww (daemon|open|open-many|reload|close)' 2>/dev/null
sleep 0.5
rm -f "${XDG_RUNTIME_DIR:-/tmp}"/eww-server_* 2>/dev/null

exec "$(command -v nyxus-eww-launch || echo /usr/local/bin/nyxus-eww-launch)"
