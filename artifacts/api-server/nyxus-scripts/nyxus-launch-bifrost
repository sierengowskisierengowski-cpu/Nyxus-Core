#!/usr/bin/env bash
set -u

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@" || true; }

if ! command -v bifrost >/dev/null 2>&1; then
  msg="Bifrost is not installed on this system yet. GHOST needs the staged Bifrost app on PATH before live detections can open."
  printf '%s\n' "$msg" >&2
  notify -u critical "NYXUS Bifrost" "$msg"
  exit 1
fi

if pgrep -x bifrost >/dev/null 2>&1; then
  exit 0
fi

setsid bifrost >/dev/null 2>&1 &
