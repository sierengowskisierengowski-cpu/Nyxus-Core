#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-hacker-mode [on|off|toggle|status]   ·   rev 2026-07-17 r2
#
# Flips the WHOLE desktop into a parallel "HACKER MODE" environment — a
# second station matrix, not just a wallpaper swap. Toggling ON:
#
#   • swaps the ACTIVE station matrix (~/.config/nyxus/stations.json) for
#     the hacker matrix (stations-hacker.json): every workstation gets a
#     dark grim-alien wallpaper, a darker hue, a security tagline, and its
#     launch rebound to the security stack (Arsenal, jeTT+Bifrost, Meli+
#     honeypot, CIPHER, RedForge/Trainer, Tor/recon, …).
#   • regenerates workspaces.json (per-workspace wallpaper daemon) and the
#     Hyprland station shard (defaultName + on-created-empty), then reloads.
#   • drops window opacity + repaints the focus ring matrix-green.
#   • surfaces the security stack (Arsenal hub + Bifrost).
#
# Toggling OFF restores the exact captured normal state (matrix, shard,
# opacity, border, wallpaper) — fully reversible + flicker-free (live
# hyprctl keyword pushes; EWW left rail re-reads stations.json on its 1s
# poll automatically). NEVER auto-activates at boot.
#
# State + backups live in ~/.config/nyxus/. Bound to Super+Ctrl+X + an
# EWW bar button.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"

STATE_DIR="${HOME}/.config/nyxus"
STATE="${STATE_DIR}/hacker-mode.state"
CFG_DIR="${STATE_DIR}"
CONFD="${HOME}/.config/hypr/conf.d"
STATIONS="${CFG_DIR}/stations.json"
STATIONS_HACKER="${CFG_DIR}/stations-hacker.json"
STATIONS_NORMAL_BAK="${CFG_DIR}/stations-normal.bak.json"
STATIONS_CONF="${CONFD}/nyxus-stations.conf"
STATIONS_CONF_BAK="${CFG_DIR}/nyxus-stations.conf.normal.bak"
WORKSPACES="${CFG_DIR}/workspaces.json"
mkdir -p "${STATE_DIR}" "${CONFD}"

# Fallbacks to the shipped /etc/skel copies (fresh account / first run).
[[ -r "${STATIONS_HACKER}" ]] || STATIONS_HACKER="/etc/skel/.config/nyxus/stations-hacker.json"

HACKER_ACTIVE_OPACITY="0.82"
HACKER_INACTIVE_OPACITY="0.68"
# Monochrome (2026-07-28, owner brief): near-black with thin white lines, one
# red reserved for real danger. The old value was matrix green, which is the
# palette this mode moved away from. Border stays a gradient so beatd's angle
# animation still reads as motion - it is the sweep that pulses to the music,
# and that survives a greyscale palette unchanged.
HACKER_BORDER="rgba(ffffffe6) rgba(ffffff80) rgba(ffffff1a) 90deg"
HACKER_INACTIVE_BORDER="rgba(ffffff26) rgba(ffffff0d) 90deg"
# Drop shadow: white and dimmer than normal mode's, so the focused window is
# lifted off the black without becoming a light source.
HACKER_SHADOW="rgba(ffffff2e)"
HACKER_SHADOW_INACTIVE="rgba(00000059)"

notify()  { command -v notify-send >/dev/null 2>&1 && notify-send "$@" || true; }
warn()    { printf '[nyxus-hacker-mode] %s\n' "$*" >&2; }
_hypr()   { command -v hyprctl >/dev/null 2>&1 && hyprctl "$@" >/dev/null 2>&1 || true; }
_getopt() { hyprctl getoption "$1" -j 2>/dev/null | jq -r "$2" 2>/dev/null; }
is_on()   { [[ -f "${STATE}" ]] && grep -q '^mode=on$' "${STATE}"; }

REFLEX_RESTORE="${STATE_DIR}/hacker-reflex.restore"

# Pause the daemons that otherwise STOMP hacker mode's transformation:
#   - nyxus-rotate-walls daemon re-applies an alien wall every 20 min
#   - nyxus-tintd / nyxus-pulsed re-tint the border ring every focus/pulse
# so the hacker wallpaper + matrix-green border never stick. Records what it
# paused so disengage restores exactly. (SIGSTOP freezes tintd/pulsed live —
# they hold their last write and resume cleanly on SIGCONT.)
pause_reflex() {
  : > "${REFLEX_RESTORE}"
  if pgrep -f 'nyxus-rotate-walls daemon' >/dev/null 2>&1; then
    pkill -f 'nyxus-rotate-walls daemon' 2>/dev/null || true
    echo "rotation" >> "${REFLEX_RESTORE}"
  fi
  for d in nyxus-tintd nyxus-pulsed; do
    if pgrep -f "${d}" >/dev/null 2>&1; then
      pkill -STOP -f "${d}" 2>/dev/null && echo "cont:${d}" >> "${REFLEX_RESTORE}" || true
    fi
  done
}

resume_reflex() {
  [[ -r "${REFLEX_RESTORE}" ]] || return 0
  while IFS= read -r line; do
    case "${line}" in
      rotation) setsid nyxus-rotate-walls daemon >/dev/null 2>&1 & ;;
      cont:*)   pkill -CONT -f "${line#cont:}" 2>/dev/null || true ;;
    esac
  done < "${REFLEX_RESTORE}"
  rm -f "${REFLEX_RESTORE}"
}

expand_home() {
  local home="${HOME:-}"
  if [[ -z "${home}" ]]; then
    warn "HOME is empty; cannot expand wallpaper paths."
    return 1
  fi
  # Caller is the trusted NYXUS config/runtime state in this repo. These paths
  # only use the current user's home (`~` / `~/...`), not `~otheruser/...`.
  case "${1:-}" in
    "~")    printf '%s\n' "${home}" ;;
    "~/"*)  printf '%s\n' "${home}/${1#~/}" ;;
    *)      printf '%s\n' "${1:-}" ;;
  esac
}

json_string() {
  local file="$1" query="$2"
  [[ -r "$file" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -r "$query // empty" "$file" 2>/dev/null | head -1
}

resolve_wallpaper_path() {
  local filename="$1" file dir
  if [[ -z "$filename" ]]; then
    warn "wallpaper filename is empty; cannot resolve path."
    return 1
  fi
  [[ "$filename" = /* && -r "$filename" ]] && { printf '%s\n' "$filename"; return 0; }
  if [[ "$filename" == */* ]]; then
    warn "rejecting non-basename wallpaper path: ${filename}"
    return 1
  fi
  for dir in "${@:2}"; do
    [[ -n "$dir" ]] || continue
    dir="$(expand_home "$dir")"
    file="${dir%/}/${filename}"
    [[ -r "$file" ]] && { printf '%s\n' "$file"; return 0; }
  done
  [[ "$filename" != /* && -r "$filename" ]] && { printf '%s\n' "$filename"; return 0; }
  warn "could not resolve wallpaper path for ${filename}."
  return 1
}

matrix_wallpaper() {
  local matrix="$1" file wall_dir
  file="$(json_string "$matrix" '.unified_wallpaper')"
  [[ -n "$file" ]] || file="$(json_string "$matrix" '.home.wallpaper')"
  wall_dir="$(json_string "$matrix" '.wall_dir')"
  # walls/rotation MUST be searched (2026-07-28). Every nyxus-rot-*.png lives
  # in the rotation/ subdir, but both matrices set wall_dir to the walls/ root,
  # so 8 of the 10 station wallpapers - including the hacker matrix's own
  # unified_wallpaper - failed to resolve. resolve_wallpaper_path only warns
  # and returns 1, and mode_wallpaper swallows that with `|| true`, so the
  # background silently never changed on a mode flip. That is the whole reason
  # hacker mode "didn't do the background".
  resolve_wallpaper_path "$file" "$wall_dir" \
    "$HOME/.config/hypr/walls" "$HOME/.config/hypr/walls/rotation" \
    "/usr/share/backgrounds/nyxus" "/usr/share/backgrounds/nyxus/rotation"
}

mode_wallpaper() {
  local matrix="$1" fallback_name="$2" wall
  wall="$(matrix_wallpaper "${matrix}" 2>/dev/null || true)"
  [[ -n "${wall}" ]] || wall="$(resolve_wallpaper_path "${fallback_name}" "$HOME/.config/hypr/walls" "/usr/share/backgrounds/nyxus" 2>/dev/null || true)"
  printf '%s\n' "${wall}"
}

# ── regenerate workspaces.json from the active stations.json ───────────
sync_workspaces() {
  if command -v nyxus-sync-stations >/dev/null 2>&1; then
    nyxus-sync-stations >/dev/null 2>&1 && return 0
  fi
  command -v jq >/dev/null 2>&1 || return 0
  # ABSOLUTE paths only — wall_dir is "~/.config/hypr/walls" and the wallpaper
  # daemon feeds this value to nyxus-set-wallpaper as a variable, where bash
  # does NOT expand a leading tilde. Emitting the raw "~/..." made every lookup
  # miss, so the daemon kept the previous image and the background never
  # flipped. Same fix as nyxus-sync-stations, which this mirrors.
  local _wd
  _wd="$(json_string "${STATIONS}" '.wall_dir')"
  case "${_wd}" in
    '~')   _wd="${HOME}" ;;
    '~/'*) _wd="${HOME}/${_wd#\~/}" ;;
    '')    _wd="${HOME}/.config/hypr/walls" ;;
  esac
  jq -n --slurpfile s "${STATIONS}" --arg wall_dir "${_wd%/}" '
    { "_comment": "Auto-generated by nyxus-hacker-mode. Do not hand-edit.",
      "workspaces": [ $s[0].stations[] | {id: .id, name: .name,
        wallpaper: ($wall_dir + "/" + .wallpaper)} ] }' \
    > "${WORKSPACES}" 2>/dev/null || true
}

# ── (re)generate the Hyprland station shard from the active matrix ─────
# Emits defaultName + on-created-empty (from .launch) per station. Launch
# strings deliberately carry NO commas (Hyprland splits workspace rules on
# commas), so each becomes exactly one on-created-empty rule.
gen_stations_conf() {
  command -v jq >/dev/null 2>&1 || return 1
  {
    echo "# ============================================================"
    echo "#  NYXUS — Station Matrix (AUTO-GENERATED by nyxus-hacker-mode)"
    echo "#  Regenerated on every hacker-mode flip from the active"
    echo "#  ~/.config/nyxus/stations.json. Do not hand-edit — edit the"
    echo "#  matrix JSON (stations.json / stations-hacker.json) instead."
    echo "# ============================================================"
    echo
    jq -r '.stations[] |
      "workspace = \(.id), persistent:true, defaultName:\(.name)" +
      ( if (.launch // "") != "" then ", on-created-empty:\(.launch)" else "" end)' \
      "${STATIONS}"
  } > "${STATIONS_CONF}" 2>/dev/null
}

# ── apply per-workspace wallpapers (restart daemon, else set base) ─────
apply_wallpapers() {
  local base="$1" resolved=""
  if [[ -r "${base}" ]]; then
    resolved="${base}"
  elif [[ -r "${HOME}/.config/hypr/walls/${base}" ]]; then
    resolved="${HOME}/.config/hypr/walls/${base}"
  elif [[ -r "/usr/share/backgrounds/nyxus/${base}" ]]; then
    resolved="/usr/share/backgrounds/nyxus/${base}"
  fi
  if systemctl --user is-active --quiet nyxus-ws-wallpaperd.service 2>/dev/null; then
    systemctl --user restart nyxus-ws-wallpaperd.service 2>/dev/null || true
  fi
  # Immediate feedback on the current workspace (flicker-free fade).
  if [[ -r "${resolved}" ]]; then
    if command -v swww >/dev/null 2>&1; then
      swww img "${resolved}" --transition-type fade --transition-duration 1 2>/dev/null || true
    elif command -v nyxus-set-wallpaper >/dev/null 2>&1; then
      nyxus-set-wallpaper "${resolved}" 2>/dev/null || true
    fi
  fi
}

apply_workspace_names() {
  command -v jq >/dev/null 2>&1 || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  jq -r '.stations[] | "\(.id)\t\(.name)"' "${STATIONS}" 2>/dev/null | \
  while IFS=$'\t' read -r id name; do
    [[ -n "${id:-}" && -n "${name:-}" ]] || continue
    hyprctl dispatch renameworkspace "${id}" "${name}" >/dev/null 2>&1 || true
  done
}

# ── actively spawn each station's tool into its workspace ─────────────
# on-created-empty rules only fire on first visit to a freshly-created
# empty workspace, so a toggle never fills the stations by itself. Here we
# push each station's launch straight onto its workspace ([workspace N
# silent] keeps focus put), skipping any workspace that already holds a
# window so we never double up on stations the user is already using.
spawn_stations() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local occupied id launch
  occupied=" $(hyprctl clients -j 2>/dev/null | jq -r '.[].workspace.id' 2>/dev/null | sort -un | tr '\n' ' ')"
  while IFS=$'\t' read -r id launch; do
    [[ -n "${launch}" ]] || continue
    case "${occupied}" in *" ${id} "*) continue ;; esac
    hyprctl dispatch exec "[workspace ${id} silent] ${launch}" >/dev/null 2>&1
    sleep 0.2
  done < <(jq -r '.stations[] | select((.launch // "") != "") | "\(.id)\t\(.launch)"' "${STATIONS}")
}

hacker_on() {
  if is_on; then notify -u low "NYXUS Hacker Mode" "Already engaged."; return 0; fi
  if [[ ! -r "${STATIONS_HACKER}" ]]; then
    notify -u critical "NYXUS Hacker Mode" "stations-hacker.json not found — cannot engage."
    return 1
  fi

  # Capture normal state so OFF is exact.
  local n_active n_inactive
  n_active="$(_getopt decoration:active_opacity '.float // .int // 0.9')"
  n_inactive="$(_getopt decoration:inactive_opacity '.float // .int // 0.8')"
  [[ -f "${STATIONS}" ]]        && cp -f "${STATIONS}" "${STATIONS_NORMAL_BAK}"
  [[ -f "${STATIONS_CONF}" ]]   && cp -f "${STATIONS_CONF}" "${STATIONS_CONF_BAK}"
  {
    echo "mode=on"
    echo "prev_active_opacity=${n_active:-0.90}"
    echo "prev_inactive_opacity=${n_inactive:-0.80}"
  } > "${STATE}"

  # 1. Swap the active matrix → regenerate all consumers → reload.
  cp -f "${STATIONS_HACKER}" "${STATIONS}"
  sync_workspaces
  gen_stations_conf
  _hypr reload
  apply_workspace_names

  # 1b. Freeze the rotation + border reflex daemons so the wallpaper flip
  #     and monochrome border below actually STICK instead of being
  #     overwritten a second later.
  pause_reflex

  # 2. Darker chrome (live, reversible).
  _hypr keyword decoration:active_opacity   "${HACKER_ACTIVE_OPACITY}"
  _hypr keyword decoration:inactive_opacity "${HACKER_INACTIVE_OPACITY}"
  _hypr keyword general:col.active_border   ${HACKER_BORDER}
  _hypr keyword general:col.inactive_border ${HACKER_INACTIVE_BORDER}
  # The window DROP SHADOW is a separate option and was the last coloured
  # thing left on screen: normal mode paints it #39ff14 at range 42, which
  # reads as a big green halo around the focused window and had nothing to do
  # with col.active_border (that was already monochrome and getoption proved
  # it). Restored by the `_hypr reload` in hacker_off, same as the borders.
  _hypr keyword decoration:shadow:color          "${HACKER_SHADOW}"
  _hypr keyword decoration:shadow:color_inactive "${HACKER_SHADOW_INACTIVE}"

  # 3. Flip wallpapers across workspaces.
  local hacker_wall
  hacker_wall="$(mode_wallpaper "${STATIONS_HACKER}" "nyxus-hacker-mode-a.png")"
  [[ -n "${hacker_wall}" ]] && apply_wallpapers "${hacker_wall}"

  # 4. Actively fill every station with its security tool. spawn_stations
  #    skips already-occupied workspaces. (We deliberately do NOT auto-open
  #    the full-screen Deep Core panel here — it blocks clicks and traps the
  #    desktop; open it on demand with Super+G instead.)
  spawn_stations

  # 5. Flip btop to the hacker theme (mono + #ff2d55 red landmarks).
  #    btop is a TUI so CSS cannot reach it — swap its color_theme key in
  #    btop.conf. Self-installs the theme file if it is missing so the toggle
  #    is self-contained and does not require a prior bake+boot to work.
  local btop_conf="${HOME}/.config/btop/btop.conf"
  local btop_theme_dir="${HOME}/.config/btop/themes"
  local btop_hacker_theme="${btop_theme_dir}/nyxus-hacker.theme"
  mkdir -p "${btop_theme_dir}"
  if [[ ! -f "${btop_hacker_theme}" ]]; then
    # Search common locations: post-bake skel, builder-box repo, NS offline cache
    local _src=""
    for _candidate in \
      "/etc/skel/.config/btop/themes/nyxus-hacker.theme" \
      "${HOME}/Nyxus-Core/iso-builder/nyx-profile/airootfs/etc/skel/.config/btop/themes/nyxus-hacker.theme" \
      "/opt/nyxus-cache/btop/themes/nyxus-hacker.theme"; do
      [[ -r "${_candidate}" ]] && { _src="${_candidate}"; break; }
    done
    if [[ -n "${_src}" ]]; then
      cp -f "${_src}" "${btop_hacker_theme}" 2>/dev/null || true
    else
      # Last resort: write it inline so the theme is ALWAYS available.
      cat > "${btop_hacker_theme}" << 'BTOP_HACKER_THEME'
# NYXUS · btop · HACKER MODE — black / white / red
# Auto-written by nyxus-hacker-mode on first use.
theme[main_bg]=""
theme[main_fg]="#e8ecf4"
theme[title]="#ffffff"
theme[hi_fg]="#ff2d55"
theme[selected_bg]="#ff2d55"
theme[selected_fg]="#000000"
theme[inactive_fg]="#2a2a2e"
theme[graph_text]="#b4b8c8"
theme[meter_bg]="#05060a"
theme[proc_misc]="#ff2d55"
theme[cpu_box]="#ffffff"
theme[mem_box]="#ffffff"
theme[net_box]="#ffffff"
theme[proc_box]="#ff2d55"
theme[div_line]="#282830"
theme[temp_start]="#505060"
theme[temp_mid]="#a0a0b0"
theme[temp_end]="#ff2d55"
theme[cpu_start]="#404050"
theme[cpu_mid]="#c0c0d0"
theme[cpu_end]="#ff2d55"
theme[free_start]="#505060"
theme[free_mid]="#9090a0"
theme[free_end]="#c8c8d8"
theme[cached_start]="#404050"
theme[cached_mid]="#707080"
theme[cached_end]="#a0a0b0"
theme[available_start]="#606070"
theme[available_mid]="#b0b0c0"
theme[available_end]="#e0e0f0"
theme[used_start]="#383840"
theme[used_mid]="#a04050"
theme[used_end]="#ff2d55"
theme[download_start]="#404050"
theme[download_mid]="#909090"
theme[download_end]="#e0e0f0"
theme[upload_start]="#404050"
theme[upload_mid]="#a04050"
theme[upload_end]="#ff2d55"
theme[process_start]="#505060"
theme[process_mid]="#a04060"
theme[process_end]="#ff2d55"
BTOP_HACKER_THEME
    fi
  fi
  if [[ -r "${btop_conf}" ]]; then
    local cur_theme
    cur_theme="$(grep -oP '^color_theme\s*=\s*"\K[^"]+' "${btop_conf}" 2>/dev/null \
               || grep -oP "^color_theme\s*=\s*\K\S+" "${btop_conf}" 2>/dev/null \
               || echo "nyxus-prism")"
    echo "btop_prev_theme=${cur_theme}" >> "${STATE}"
    sed -i 's|^color_theme\s*=.*|color_theme = "nyxus-hacker"|' "${btop_conf}" 2>/dev/null || true
  fi

  notify -u critical "NYXUS Hacker Mode" "ENGAGED — black/white/red. Toggle off: Super+Ctrl+X"
}

hacker_off() {
  if ! is_on; then notify -u low "NYXUS Hacker Mode" "Not engaged."; return 0; fi
  local p_active p_inactive
  p_active="$(grep -oP '^prev_active_opacity=\K.*' "${STATE}" 2>/dev/null | head -1)"
  p_inactive="$(grep -oP '^prev_inactive_opacity=\K.*' "${STATE}" 2>/dev/null | head -1)"

  # 1. Restore the normal matrix + shard (exact captured copies).
  if [[ -f "${STATIONS_NORMAL_BAK}" ]]; then
    cp -f "${STATIONS_NORMAL_BAK}" "${STATIONS}"
  elif [[ -f "/etc/skel/.config/nyxus/stations.json" ]]; then
    cp -f "/etc/skel/.config/nyxus/stations.json" "${STATIONS}"
  fi
  if [[ -f "${STATIONS_CONF_BAK}" ]]; then
    cp -f "${STATIONS_CONF_BAK}" "${STATIONS_CONF}"
  fi
  sync_workspaces
  _hypr reload
  apply_workspace_names

  # 2. Restore chrome.
  _hypr keyword decoration:active_opacity   "${p_active:-0.90}"
  _hypr keyword decoration:inactive_opacity "${p_inactive:-0.80}"

  # 3. Restore normal wallpapers.
  local norm_wall
  norm_wall="$(grep -oP '^WALLPAPER_PATH="?\K[^"]+' "${STATE_DIR}/wallpaper.conf" 2>/dev/null | head -1)"
  if [[ -n "${norm_wall}" ]]; then
    norm_wall="$(expand_home "${norm_wall}")"
  else
    norm_wall="$(mode_wallpaper "${STATIONS}" "nyxus-desktop-hero.png")"
  fi
  [[ -n "${norm_wall}" ]] && apply_wallpapers "${norm_wall}"

  # 4. Un-freeze the rotation + border reflex daemons (resumes exactly what
  #    was paused on engage).
  resume_reflex

  # 5. Restore btop theme.
  local btop_conf="${HOME}/.config/btop/btop.conf"
  if [[ -r "${btop_conf}" ]]; then
    local prev_theme
    prev_theme="$(grep -oP '^btop_prev_theme=\K.*' "${STATE}" 2>/dev/null | head -1)"
    [[ -z "${prev_theme}" ]] && prev_theme="nyxus-prism"
    sed -i "s|^color_theme\s*=.*|color_theme = \"${prev_theme}\"|" "${btop_conf}" 2>/dev/null || true
  fi
  # Restore normal border animation speed (240s = slow dreamlike sweep)
  hyprctl keyword animation "borderangle,1,240,linear,loop" >/dev/null 2>&1 || true

  rm -f "${STATE}"
  notify -u normal "NYXUS Hacker Mode" "Disengaged — normal station matrix restored."
}

case "${1:-toggle}" in
  on)       hacker_on ;;
  off)      hacker_off ;;
  status)   is_on && echo on || echo off ;;
  # Run once at login: a fresh session always comes up in NORMAL visuals
  # (hacker mode never auto-activates), so clear any stale on-state left in
  # the persisted file and un-freeze any daemons a crash left paused, so the
  # very first Super+Ctrl+X toggle does the right thing.
  reconcile-boot)
            resume_reflex 2>/dev/null || true
            rm -f "${STATE}" "${REFLEX_RESTORE}" 2>/dev/null || true ;;
  toggle|*) is_on && hacker_off || hacker_on ;;
esac
